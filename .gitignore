# Python bytecode
__pycache__/
*.py[cod]

# macOS Finder metadata
.DS_Store

# Generated audit and repair artifacts must never be committed into the corpus
**/benchmark_audit/
**/benchmark_audit_history/
**/.benchmark_audit_tmp/
**/benchmark_repair/
**/benchmark_repair_history/
**/.benchmark_repair_tmp/

# Local single-run review/repair records are reproducible operational evidence.
.review_records/

# Local publication artifacts — never upload to GitHub.
/_publish/
/review_outputs/

# External assignment dispatcher runtime guard and temporary files

# Read-only source corpus — not committed. Keep a tracked placeholder so the
# directory exists after clone.
materials_science_questions/*
!materials_science_questions/.gitkeep
