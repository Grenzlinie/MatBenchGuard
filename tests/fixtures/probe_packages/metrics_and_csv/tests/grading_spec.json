{
  "pass_threshold": 0.6,
  "output_contract": {
    "outputs": [
      {
        "file": "predictions.csv",
        "format": "csv",
        "purpose": "scored",
        "schema": {
          "type": "table",
          "required_columns": [
            "true_oxidation_state",
            "predicted_mean",
            "predicted_std"
          ]
        }
      },
      {
        "file": "metrics.json",
        "format": "json",
        "purpose": "scored",
        "schema": {
          "type": "object",
          "required": {
            "R2": "float",
            "RMSE": "float"
          }
        }
      }
    ]
  },
  "steps": [
    {
      "id": "eval_predictions",
      "output_file": "predictions.csv",
      "weight": 0.2,
      "kind": "structural_audit"
    },
    {
      "id": "eval_metrics",
      "output_file": "metrics.json",
      "weight": 0.8,
      "kind": "reference_match",
      "target": {
        "R2": 0.85,
        "RMSE": 0.24
      }
    }
  ]
}