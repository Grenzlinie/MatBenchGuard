{
  "pass_threshold": 0.6,
  "output_contract": {
    "outputs": [{
      "file": "result.json",
      "format": "json",
      "purpose": "scored",
      "schema": {
        "type": "object",
        "required": {
          "model": {"metrics": {"rmse": "float", "mae": "float"}},
          "validation": {"score": "float"}
        }
      }
    }]
  },
  "steps": [
    {
      "id": "model_errors",
      "output_file": "result.json",
      "weight": 0.7,
      "target": {"model": {"metrics": {"rmse": 0.1, "mae": 0.05}}}
    },
    {
      "id": "validation_score",
      "output_file": "result.json",
      "weight": 0.3,
      "target": {"validation": {"score": 0.95}}
    }
  ]
}
