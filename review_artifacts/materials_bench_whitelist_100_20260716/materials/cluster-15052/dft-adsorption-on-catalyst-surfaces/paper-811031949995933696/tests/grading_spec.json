{
  "scoring_tier": "result-level compare",
  "scoring_justification": "Full recompute of DFT energies from raw calculation outputs is infeasible in verifier sandbox; comparing agent’s reported values to the paper’s published gold with tolerances is the strongest feasible tier.",
  "pass_threshold": 0.6,
  "target_policies": {
    "dft_results.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold binding energies, activation barriers, and Bader charge from the paper",
      "source_provenance": "Fig. 6, Table 3, and the Bader charge text of the paper",
      "generation_method": "extracted from the paper’s reported DFT results",
      "why_not_fabricated": "These are the paper’s published computational predictions; comparing against them reproduces the paper’s core findings."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "dft_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "pristine_physisorbed_BE": "number (kcal/mol)",
            "pristine_chemisorbed_BE": "number (kcal/mol)",
            "pristine_dissociated_BE": "number (kcal/mol)",
            "pristine_barrier": "number (kcal/mol)",
            "K_physisorbed_BE": "number (kcal/mol)",
            "K_chemisorbed_BE": "number (kcal/mol)",
            "K_dissociated_BE": "number (kcal/mol)",
            "K_barrier": "number (kcal/mol)",
            "K_Bader_charge": "number (e)"
          }
        },
        "description": "DFT-computed binding energies, activation barriers, and Bader charge for CO2 on pristine and K-promoted β-Mo2C(001) surfaces, compared to hidden paper reference values with tolerances."
      }
    ],
    "notes": ""
  },
  "steps": [
    {
      "id": "check_pristine_physisorbed_BE",
      "output_file": "dft_results.json",
      "weight": 0.1,
      "kind": "numeric_tolerance",
      "field": "pristine_physisorbed_BE",
      "target": -0.5,
      "tolerance": 2.0
    },
    {
      "id": "check_pristine_chemisorbed_BE",
      "output_file": "dft_results.json",
      "weight": 0.1,
      "kind": "numeric_tolerance",
      "field": "pristine_chemisorbed_BE",
      "target": -31.4,
      "tolerance": 2.0
    },
    {
      "id": "check_pristine_dissociated_BE",
      "output_file": "dft_results.json",
      "weight": 0.1,
      "kind": "numeric_tolerance",
      "field": "pristine_dissociated_BE",
      "target": -74.8,
      "tolerance": 2.0
    },
    {
      "id": "check_pristine_barrier",
      "output_file": "dft_results.json",
      "weight": 0.1,
      "kind": "numeric_tolerance",
      "field": "pristine_barrier",
      "target": 16.8,
      "tolerance": 2.0
    },
    {
      "id": "check_K_physisorbed_BE",
      "output_file": "dft_results.json",
      "weight": 0.1,
      "kind": "numeric_tolerance",
      "field": "K_physisorbed_BE",
      "target": -6.5,
      "tolerance": 2.0
    },
    {
      "id": "check_K_chemisorbed_BE",
      "output_file": "dft_results.json",
      "weight": 0.1,
      "kind": "numeric_tolerance",
      "field": "K_chemisorbed_BE",
      "target": -46.4,
      "tolerance": 2.0
    },
    {
      "id": "check_K_dissociated_BE",
      "output_file": "dft_results.json",
      "weight": 0.1,
      "kind": "numeric_tolerance",
      "field": "K_dissociated_BE",
      "target": -80.9,
      "tolerance": 2.0
    },
    {
      "id": "check_K_barrier",
      "output_file": "dft_results.json",
      "weight": 0.1,
      "kind": "numeric_tolerance",
      "field": "K_barrier",
