      "straight": 0.1,
      "zigzag": 0.1,
      "intersection": 0.8
    },
    "pentane": {
      "straight": 0.33,
      "zigzag": 0.33,
      "intersection": 0.34
    }
  },
  "gold_hopping": {
    "str_1_to_2": 140000.0,
    "str_2_to_3": 43000000000.0,
    "str_3_to_1": 26000000000.0,
    "zz_1_to_2": 50000.0,
    "zz_2_to_3": 130000000000.0,
    "zz_3_to_4": 100000000000.0,
    "zz_4_to_1": 1400000000.0
  },
  "gold_diff": {
    "Dxx": 1.7e-10,
    "Dyy": 4.7e-10,
    "Dzz": 2.1e-10,
    "D": 8.5e-10
  },
  "steps": [
    {
      "id": "heats",
      "output_file": "heats_of_adsorption.csv",
      "kind": "numeric",
      "weight": 0.3,
      "target_policy": "reference_match",
      "tolerance": 3.0
    },
    {
      "id": "siting",
      "output_file": "siting_distribution.json",
      "kind": "numeric",
      "weight": 0.3,
      "target_policy": "reference_match",
      "tolerance": 0.05
    },
    {
      "id": "hopping_rates",
      "output_file": "diffusion_results.json",
      "kind": "numeric",
      "weight": 0.2,
      "target_policy": "reference_match",
      "tolerance": 3,
      "note": "Within factor 3"
    },
    {
      "id": "diffusion_coefficients",
      "output_file": "diffusion_results.json",
      "kind": "numeric",
      "weight": 0.2,
      "target_policy": "reference_match",
      "tolerance": 3,
      "note": "Within factor 3"
    }
  ]
}