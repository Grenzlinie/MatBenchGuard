{
  "scoring_tier": "result_compare",
  "scoring_justification": "Recomputing a full GCMC trajectory in the verifier sandbox is infeasible; agent reports computed properties (selectivity, heats, constants). T0 comparison to paper-reported values with tolerances is the most practical tier.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold_structural",
      "source_provenance": "Paper Figures 3-5 and Supporting Information; exact values from reference solve.sh representing the paper's computed geometric properties",
      "generation_method": "Extracted from reference solve.sh (which reproduces the paper's Zeo++ results)",
      "why_not_fabricated": "Values are the paper's actual computed PLD, LCD, SA, volume, void fraction for the six MFM MOFs"
    },
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold_selectivity",
      "source_provenance": "Paper Table 1 (highest/lowest) and Table 3; full set from Supporting Information; reference solve.sh reproduces the paper's GCMC selectivity",
      "generation_method": "Extracted from reference solve.sh (which reproduces the paper's binary mixture selectivity for all conditions)",
      "why_not_fabricated": "Values are the paper's computed Xe/Kr selectivity at eight specified conditions for each MOF"
    },
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold_thermo",
      "source_provenance": "Paper Table 2 (Qst) and Table 3 (Henry constants, Henry selectivity); reference solve.sh reproduces the paper's Widom insertion results",
      "generation_method": "Extracted from reference solve.sh (which reproduces the paper's infinite dilution results)",
      "why_not_fabricated": "Values are the paper's Qst and Henry constants for all six MOFs"
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "structural_properties.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "mof",
              "pld",
              "lcd",
              "lcd_pl",
              "total_sa",
              "volume",
              "void_fraction"
            ],
            "properties": {
              "mof": {
                "type": "string"
              },
              "pld": {
                "type": "number",
                "unit": "Angstrom"
              },
              "lcd": {
                "type": "number",
                "unit": "Angstrom"
              },
              "lcd_pl": {
                "type": "number"
              },
              "total_sa": {
                "type": "number",
                "unit": "m^2/g"
              },
              "volume": {
                "type": "number",
                "unit": "cm^3/g"
              },
              "void_fraction": {
                "type": "number"
              }
            }
          }
        },
        "description": "Geometric pore properties (PLD, LCD, surface area, volume, void fraction) for the six MFM MOFs, compared against paper-reported values with tolerances."
      },
      {
