{
  "scoring_tier": "structural",
  "scoring_justification": "Scoring is structural because the paper's results are stochastic cluster size distributions and magnetization curves from Monte Carlo simulations, which vary across runs. Exact numerical recompute is infeasible; instead we verify physically expected relative trends (ordering, monotonicity) that are robust across implementations.",
  "pass_threshold": 0.6,
  "target_policies": {
    "cluster_distributions.json": "structural_audit",
    "magnetization_curves.json": "structural_audit"
  },
  "hidden_assets": [],
