{
  "scoring_tier": "result-level_compare",
  "scoring_justification": "Full MC simulation is too expensive to recompute in the verifier; we compare reported Hc values to paper-derived gold with tolerance and verify physical trends (monotonicity) across parameter sweeps.",
  "pass_threshold": 0.5,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold coercivity values (Hc) for all 53 simulation conditions and trend group specifications",
      "source_provenance": "Paper Figures 7-9 digitized values and the reference oracle implementation that reproduces the paper's reported trends.",
      "generation_method": "Values were hand-digitized from the paper plots and matched to the reference solve.sh constants. Trend directions are taken directly from the paper's descriptions of dependencies (e.g., Hc increases with K_AF, increases with |J_AF|, increases with AFM thickness, decreases with temperature).",
      "why_not_fabricated": "Values correspond to the published quantitative ranges and reproduce the required monotonic trends; the reference solver is designed to output exactly these numbers, guaranteeing oracle full reward."
    }
  ],
