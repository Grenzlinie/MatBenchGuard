          "required_columns": [
            "cluster_name",
            "freq_cm1",
            "energy_au",
            "dipole_moment_debye",
            "bond_length_ang",
            "homo_lumo_gap_eV",
            "absorption_nm",
            "wbi"
          ],
          "units": {
