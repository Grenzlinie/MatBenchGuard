  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold values for all 12 clusters from paper Table 1",
      "source_provenance": "Paper: Table 1 in 'Theoretical Characters of MgX (X=Te, Se, S and O) clusters', J. Nonlinear Optic. Phys. Mat. 19, 695 (2010)",
      "generation_method": "extracted directly from the published table",
      "why_not_fabricated": "These are the actual published values that the paper claims as results; they serve as the reference for reproduction."
    }
  ],
