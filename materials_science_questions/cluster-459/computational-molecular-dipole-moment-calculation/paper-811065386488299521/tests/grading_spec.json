        "description": "Optimized ground-state geometry of CO3 at SD MBPT(4)/DZP level: four rows for bond lengths and angle."
      },
      {
        "file": "step_02_formation_energy.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
