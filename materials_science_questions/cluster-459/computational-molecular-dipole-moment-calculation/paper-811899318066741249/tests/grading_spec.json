{
  "scoring_tier": "recompute",
  "scoring_justification": "Dipole moments recomputed from submitted per-isotherm function arrays; coefficients and thermodynamic properties compared to hidden gold values from paper.",
  "pass_threshold": 0.6,
  "target_policies": {
    "dielectric_eqn_coefficients.json": "reference_match",
    "kirkwood_results.json": "metric_recompute",
    "kf_results.json": "metric_recompute",
    "thermodynamic_properties.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "hidden gold values for coefficients, dipole moments, and thermodynamic reference parameters",
      "source_provenance": "paper Table 3 (coefficients), Eq.7/Eq.9 derived mu values, and thermodynamic points derived from Eq.10/11 using fitted coefficients",
      "generation_method": "extracted from paper and verified against solve.sh reference",
      "why_not_fabricated": "All values are taken directly from the published paper or derived from its explicit equations and parameters, ensuring traceability."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "dielectric_eqn_coefficients.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required_keys": [
            "a1",
            "a1_err",
            "a2",
            "a2_err",
            "a3",
