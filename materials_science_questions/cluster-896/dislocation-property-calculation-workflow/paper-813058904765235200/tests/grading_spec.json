{
  "scoring_tier": "recompute",
  "scoring_justification": "Recompute E_int and V_XX from raw total energies; compare to paper-reported values with tolerance for DFT code differences.",
  "pass_threshold": 0.6,
  "target_policies": {
    "total_energies.json": "metric_recompute",
    "reconstruction_outcomes.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold E_int and V_XX targets and tolerances",
      "source_provenance": "Paper Table 3 (E_int 2b), Fig. 3 approximation (E_int 1b), Fig. 4 and text (V_XX).",
      "generation_method": "Extracted from paper reported numeric values; 1b E_int approximated from bar chart; V_XX values as stated in text (B~0, C+0.32, N+0.22, O+0.24). Tolerances set to accommodate open-source DFT spread.",
      "why_not_fabricated": "Based on the paper's published results."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "total_energies.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "object",
          "required": {
            "E_bulk": "float",
            "E_X_B": "float",
            "E_X_C": "float",
            "E_X_N": "float",
            "E_X_O": "float",
            "E_easy_1b": "float",
            "E_easy_2b": "float",
            "E_hard_1b": "float",
            "E_disloc_B_1b": "float",
            "E_disloc_B_2b": "float",
            "E_disloc_C_1b": "float",
            "E_disloc_C_2b": "float",
            "E_disloc_N_1b": "float",
            "E_disloc_N_2b": "float",
            "E_disloc_O_1b": "float",
            "E_disloc_O_2b": "float"
          },
          "units": "eV"
        },
        "description": "Raw DFT total energies from which the checker recomputes solute-dislocation interaction energies E_int and solute-solute interaction energies V_XX, comparing to hidden paper-reported values within tolerance."
