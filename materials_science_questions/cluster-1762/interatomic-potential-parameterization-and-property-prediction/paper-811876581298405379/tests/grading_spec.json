{
  "scoring_tier": "result-level compare",
  "scoring_justification": "Recomputing planar energies would require re-running the full empirical interatomic potential with geometry relaxation, which the verifier sandbox cannot do. Therefore, we compare the agent's reported CSV energies to the paper's published values with an absolute tolerance and compute the energy differences.",
  "pass_threshold": 0.6,
  "target_policies": {
    "planar_energies.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold planar energies for each phase and layer index, plus target energy differences",
      "source_provenance": "Paper's Tables I and II",
      "generation_method": "Extracted from the paper text; values match those in the reference solve.sh",
      "why_not_fabricated": "These are the paper's actual computed energies, faithfully copied."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "planar_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "phase",
            "layer_index",
            "layer_label",
            "energy"
          ],
          "units": {
            "energy": "eV/atom"
          }
        },
        "description": "Layer‑resolved planar cohesive energies for Al(001), Al(001)L, Al(110), Al(110)R, Al(001)/In, and Al(110)/In on AlAs(001) under coherent growth. The hidden checker compares each energy to the paper‑reported values with an absolute tolerance and computes the interface energy differences (Al(001)−Al(110) without In and with In) to verify the headline stability claim."
      }
    ],
    "notes": ""
  },
  "steps": [
    {
      "id": "planar_energies_values",
      "output_file": "planar_energies.csv",
      "kind": "reference_match",
      "weight": 0.6,
      "tolerance": 0.001,
      "description": "Compare each energy value in planar_energies.csv to the corresponding gold value from the paper, scoring fraction of rows within absolute tolerance."
    },
    {
      "id": "energy_diff_noIn",
      "output_file": "planar_energies.csv",
      "kind": "exact_match",
      "weight": 0.2,
      "tolerance": 0.005,
      "target": 0.026,
      "target_policy": "exact_match",
      "description": "Compute energy difference at interface layer between Al(001) and Al(110) (no In) and compare to paper's value 0.026 eV/atom."
    },
    {
      "id": "energy_diff_In",
      "output_file": "planar_energies.csv",
      "kind": "exact_match",
      "weight": 0.2,
      "tolerance": 0.005,
      "target": 0.242,
      "target_policy": "exact_match",
      "description": "Compute energy difference at interface layer between Al(001)/In and Al(110)/In and compare to paper's value 0.242 eV/atom."
    }
  ],
