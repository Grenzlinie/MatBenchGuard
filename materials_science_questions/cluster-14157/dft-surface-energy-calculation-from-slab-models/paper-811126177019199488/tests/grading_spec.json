{
  "scoring_tier": "structural",
  "scoring_justification": "Recomputing surface energies/work functions from the underlying DFT variational procedure would require re-running the entire numerical minimization pipeline, which is infeasible in the checker sandbox. Instead, we compare agent's reported values against the paper's published numbers with physically reasonable tolerances and verify monotonic face-ordering trends for the subset of metals where the paper claims a trend.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold values for surface energies (LDA and corrected) and work functions (DPΔSCF) from the paper's Tables I and II.",
      "source_provenance": "Paper Table I (surface energies, LDA and wave-vector corrected columns) and Table II (Φ^DPΔSCF column). Values are extracted from the reference solve.sh which is directly derived from the paper.",
      "generation_method": "Manually transcribed from the paper's published tables and verified against the solve.sh reference artifact.",
      "why_not_fabricated": "These numbers are the exact computed results reported in the paper; they serve as the authoritative hidden comparison target."
    }
  ],
