{
  "scoring_tier": "T0",
  "scoring_justification": "Result-level compare against paper-reported values; tolerances accommodate DFT code spread.",
  "pass_threshold": 0.6,
  "output_contract": {
    "outputs": [
      {
        "file": "repairing_process_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "state",
            "E_ad",
            "barrier",
            "Hirshfeld_charge_NO",
            "Hirshfeld_charge_N1",
            "Hirshfeld_charge_O1"
          ],
          "units": {
            "E_ad": "eV",
            "barrier": "eV",
            "Hirshfeld_charge_NO": "e",
            "Hirshfeld_charge_N1": "e",
            "Hirshfeld_charge_O1": "e"
          }
        },
        "description": "Adsorption energies, energy barrier, and Hirshfeld charges for the three stationary points of the repairing process."
      },
      {
        "file": "removing_process_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "state",
            "E_ad",
            "barrier",
            "Hirshfeld_charge_NO2_total",
            "Hirshfeld_charge_N1",
            "Hirshfeld_charge_O1",
            "Hirshfeld_charge_N2",
            "Hirshfeld_charge_O2"
          ],
          "units": {
            "E_ad": "eV",
            "barrier": "eV",
            "Hirshfeld_charge_NO2_total": "e",
            "Hirshfeld_charge_N1": "e",
            "Hirshfeld_charge_O1": "e",
            "Hirshfeld_charge_N2": "e",
            "Hirshfeld_charge_O2": "e"
          }
        },
        "description": "Adsorption energies, energy barrier, and Hirshfeld charges for the three stationary points of the removing process."
      }
    ],
    "notes": "The hidden checker compares each reported value to the paper's gold within appropriate tolerances and verifies relative trends (e.g., strong exothermicity of FS1, barrier(TS1) > barrier(TS2), small desorption energy for FS2)."
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference gold values for repairing and removing process energies, barriers, and charges",
      "source_provenance": "Paper DOI 10.1007/s00339-020-03470-0, results section text",
      "generation_method": "Hardcoded from paper's reported numbers",
      "why_not_fabricated": "Values are directly quoted from the paper; the reference solution is built to match them exactly"
    }
  ],
  "steps": [
    {
      "id": "repairing_numeric",
      "output_file": "repairing_process_results.csv",
      "kind": "numeric_reference_compare",
      "weight": 0.4,
      "parameters": {
        "reference": {
          "IS1": {
            "E_ad": -0.06,
            "Hirshfeld_charge_NO": -0.17,
            "Hirshfeld_charge_N1": -0.08,
            "Hirshfeld_charge_O1": -0.09
          },
          "TS1": {
            "E_ad": null,
            "barrier": 0.51,
            "Hirshfeld_charge_NO": -0.34,
            "Hirshfeld_charge_N1": -0.18,
            "Hirshfeld_charge_O1": -0.16
          },
          "FS1": {
            "E_ad": -7.01,
            "Hirshfeld_charge_NO": -0.2,
            "Hirshfeld_charge_N1": -0.05,
            "Hirshfeld_charge_O1": -0.15
          }
        },
        "tolerances": {
          "E_ad": 0.05,
          "barrier": 0.05,
          "charge": 0.05
        }
      }
    },
    {
      "id": "removing_numeric",
      "output_file": "removing_process_results.csv",
      "kind": "numeric_reference_compare",
      "weight": 0.4,
      "parameters": {
        "reference": {
          "IS2": {
            "E_ad": -0.15,
            "Hirshfeld_charge_NO2_total": 0.01,
            "Hirshfeld_charge_N1": -0.05,
            "Hirshfeld_charge_O1": -0.15,
            "Hirshfeld_charge_N2": 0.02,
            "Hirshfeld_charge_O2": -0.01
          },
          "TS2": {
            "barrier": 0.22,
            "Hirshfeld_charge_NO2_total": 0.08,
            "Hirshfeld_charge_N1": -0.12,
            "Hirshfeld_charge_O1": -0.22,
            "Hirshfeld_charge_N2": 0.12,
            "Hirshfeld_charge_O2": -0.04
          },
          "FS2": {
            "E_ad": -0.28,
            "Hirshfeld_charge_NO2_total": -0.06,
            "Hirshfeld_charge_N1": -0.2,
            "Hirshfeld_charge_O1": -0.1,
            "Hirshfeld_charge_N2": 0.14,
            "Hirshfeld_charge_O2": -0.1
          }
        },
        "tolerances": {
          "E_ad": 0.05,
          "barrier": 0.05,
          "charge": 0.05
        }
      }
    },
    {
      "id": "structural_trends",
      "output_file": "repairing_process_results.csv",
      "kind": "structural_audit",
      "weight": 0.2,
      "parameters": {
        "trends": [
          {
            "description": "FS1 E_ad is strongly exothermic (< -6.5 eV)",
            "field": "E_ad",
            "state": "FS1",
            "condition": "lt",
            "threshold": -6.5
          },
          {
            "description": "TS1 barrier > TS2 barrier",
            "condition": "barrier_ts1_gt_ts2"
          },
          {
            "description": "FS2 E_ad > -0.50 eV (small desorption energy)",
            "field": "E_ad",
            "state": "FS2",
            "condition": "gt",
            "threshold": -0.5
          }
        ]
      }
    }
  ]
}