{
  "scoring_tier": "reference_match",
  "scoring_justification": "Recompute from raw DFT outputs (charge densities, wavefunctions) is impossible in the verifier environment; compare submitted numeric values to the paper‑reported references with declared tolerances.",
  "pass_threshold": 0.6,
  "target_policies": {
    "adsorption_results.json": "reference_match",
    "Redox_slab_with_CO.xyz": "structural_audit",
    "Bulk_slab_with_CO.xyz": "structural_audit"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper‑reported gold values for adsorption energies, C‑O bond lengths, Bader charges, and gas‑phase CO bond length.",
      "source_provenance": "Paper Fig. 4(c) (adsorption energies and bond lengths for Redox and Bulk slabs) and main text, Section 2 (Bader charges: Co before 8.77 e, after 8.42 e for Redox; 7.94 e, 7.88 e for Bulk; gas‑phase CO 1.128 Å).",
      "generation_method": "Extracted directly from the paper’s reported numbers.",
      "why_not_fabricated": "These are the exact quantities the paper claims as its computational results; they are the legitimate reproduction target."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "adsorption_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "Redox_HE_LMO",
            "Bulk_HE_LMO",
            "gas_phase_CO_bond_length_Ang"
          ],
          "properties": {
            "Redox_HE_LMO": {
              "type": "object",
              "required": [
                "adsorption_energy_eV",
                "C_O_bond_length_Ang",
                "Bader_charge_Co_before_e",
                "Bader_charge_Co_after_e"
              ]
            },
            "Bulk_HE_LMO": {
              "type": "object",
              "required": [
                "adsorption_energy_eV",
                "C_O_bond_length_Ang",
                "Bader_charge_Co_before_e",
                "Bader_charge_Co_after_e"
              ]
            },
            "gas_phase_CO_bond_length_Ang": {
              "type": "number"
            }
          }
        },
        "description": "Main scored artifact containing adsorption energies (eV), C-O bond lengths (Å), and Bader charges (e) for the Redox and Bulk HE-LMO surfaces, plus the gas-phase CO bond length."
      },
      {
        "file": "Redox_slab_with_CO.xyz",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "text",
          "format": "XYZ",
          "fields": [
            "atom_count",
            "comment_line",
            "atom_symbol",
            "x",
            "y",
            "z"
          ]
        },
        "description": "XYZ file of the optimized Redox-HE-LMO slab with adsorbed CO; checked for correct atom counts and elements and internal consistency with adsorption_results.json."
      },
      {
        "file": "Bulk_slab_with_CO.xyz",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "text",
          "format": "XYZ",
          "fields": [
            "atom_count",
            "comment_line",
            "atom_symbol",
            "x",
            "y",
            "z"
          ]
        },
        "description": "XYZ file of the optimized Bulk-HE-LMO slab with adsorbed CO; checked for correct atom counts and elements and internal consistency with adsorption_results.json."
      }
    ],
    "notes": "The checker will compare numerical values in adsorption_results.json to the paper's reference values with appropriate tolerances (adsorption energy ±0.1 eV, bond length ±0.01 Å, Bader charge ±0.05 e). The two XYZ files are audited for existence, reasonable atom counts, and consistency with the JSON. Missing or clearly invalid XYZ files apply a penalty."
  },
  "steps": [
    {
      "id": "check_redox_eads",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.15,
      "field_path": "Redox_HE_LMO.adsorption_energy_eV",
      "target": -2.47,
      "tolerance_abs": 0.1
    },
    {
      "id": "check_redox_co_bond",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.15,
      "field_path": "Redox_HE_LMO.C_O_bond_length_Ang",
      "target": 1.207,
      "tolerance_abs": 0.01
    },
    {
      "id": "check_redox_bader_before",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.05,
      "field_path": "Redox_HE_LMO.Bader_charge_Co_before_e",
      "target": 8.77,
      "tolerance_abs": 0.05
    },
    {
      "id": "check_redox_bader_after",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.05,
      "field_path": "Redox_HE_LMO.Bader_charge_Co_after_e",
      "target": 8.42,
      "tolerance_abs": 0.05
    },
    {
      "id": "check_bulk_eads",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.15,
      "field_path": "Bulk_HE_LMO.adsorption_energy_eV",
      "target": -0.33,
      "tolerance_abs": 0.1
    },
    {
      "id": "check_bulk_co_bond",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.15,
      "field_path": "Bulk_HE_LMO.C_O_bond_length_Ang",
      "target": 1.158,
      "tolerance_abs": 0.01
    },
    {
      "id": "check_bulk_bader_before",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.05,
      "field_path": "Bulk_HE_LMO.Bader_charge_Co_before_e",
      "target": 7.94,
      "tolerance_abs": 0.05
    },
    {
      "id": "check_bulk_bader_after",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.05,
      "field_path": "Bulk_HE_LMO.Bader_charge_Co_after_e",
      "target": 7.88,
      "tolerance_abs": 0.05
    },
    {
      "id": "check_gas_co_bond",
      "output_file": "adsorption_results.json",
      "kind": "numeric_closeness",
      "weight": 0.1,
      "field_path": "gas_phase_CO_bond_length_Ang",
      "target": 1.128,
      "tolerance_abs": 0.01
    },
    {
      "id": "check_xyz_redox",
      "output_file": "Redox_slab_with_CO.xyz",
      "kind": "xyz_structure",
      "weight": 0.05,
      "json_path": "Redox_HE_LMO.C_O_bond_length_Ang",
      "tolerance_abs": 0.01,
      "min_atoms": 20
    },
    {
      "id": "check_xyz_bulk",
      "output_file": "Bulk_slab_with_CO.xyz",
      "kind": "xyz_structure",
      "weight": 0.05,
      "json_path": "Bulk_HE_LMO.C_O_bond_length_Ang",
      "tolerance_abs": 0.01,
      "min_atoms": 20
    }
  ]
}