{
  "scoring_tier": "T0_result_level_compare",
  "scoring_justification": "DFT recompute is infeasible in the verifier; compare agent's reported numbers against paper gold with threshold_or_better policy and tolerances that absorb toolchain spread.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
