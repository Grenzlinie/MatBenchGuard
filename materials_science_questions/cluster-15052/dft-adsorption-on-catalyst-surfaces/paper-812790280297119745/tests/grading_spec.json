            "bond_length_si_x_A": 1.8
          },
          {
            "configuration": "CO(C-site)",
            "adsorption_energy_kcal_mol": -15.57,
            "hirshfeld_charge_transfer_e": 0.14,
            "bond_length_si_x_A": 1.91
          },
          {
            "configuration": "CO(O-site)",
            "adsorption_energy_kcal_mol": -0.7,
