                  }
                }
              }
            }
          }
        },
        "description": "Relative energies (kcal/mol) of all stationary points for the H2 addition reaction, computed with B3LYP and PBE functionals. The hidden checker compares these values to reference data from the paper."
      }
    ],
    "notes": "Checker compares the reported relative energies and the implied singlet-triplet gaps and barrier trends to hidden reference values from Table 1 of the paper, using tolerances that accommodate method/implementation differences. The output contract requires fields for both uncorrected and ZPE-corrected energies."
  },
  "target_policies": {
    "energies.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold reference relative energies (kcal/mol) from Table 1",
      "source_provenance": "Paper Table 1 (Inorganic Chemistry 2007, 46, 2709-2715)",
      "generation_method": "Extracted exactly from Table 1 values for each entry",
      "why_not_fabricated": "Values are the paper's reported numbers; they are used as comparison targets for recomputed energies."
    }
  ],
  "steps": [
    {
      "id": "file_structure",
      "output_file": "energies.json",
      "kind": "file_structure",
      "weight": 0.05,
      "description": "Validate that energies.json exists and has required keys with non-empty arrays"
    },
    {
      "id": "b3lyp_relative_energies_recompute",
      "output_file": "energies.json",
      "kind": "recompute_metric",
      "metric": "relative_energy_kcal_mol",
      "weight": 0.5,
      "description": "For every B3LYP entry, recompute uncorrected relative energy from absolute energies and compare to paper gold; also compare ZPE-corrected where provided"
    },
    {
      "id": "pbe_reactants_relative_energies",
      "output_file": "energies.json",
      "kind": "recompute_metric",
      "metric": "relative_energy_kcal_mol",
      "weight": 0.1,
      "description": "For PBE n=0 reactants, recompute uncorrected relative energy from absolute energies and compare to paper gold"
    },
    {
      "id": "st_gap_trends",
      "output_file": "energies.json",
      "kind": "trend",
      "weight": 0.15,
      "description": "Verify Ti triplet ground state (S-T gap > 15 kcal/mol) and Zr/Hf singlet ground state (small gap)"
    },
    {
      "id": "barrier_trends",
      "output_file": "energies.json",
      "kind": "trend",
      "weight": 0.15,
      "description": "Verify that singlet activation barriers follow Ti > Zr ≈ Hf for each ligand set"
    },
    {
      "id": "pbe_st_gap_ti",
      "output_file": "energies.json",
      "kind": "trend",
      "weight": 0.05,
      "description": "Verify PBE singlet-triplet gap for Ti n=0 is positive and <= 10 kcal/mol"
    }
  ],
