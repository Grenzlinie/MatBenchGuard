  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "All hidden gold values for cluster properties, adsorption energies, and barriers, plus ordering relations.",
      "source_provenance": "Paper Table 1 (binding energies/magnetic moments), text (bond length 2.43 Å, Rh4 Eb 2.99 eV), Figure 3 (physical adsorption energies approximate), Figure 6 (chemical adsorption energies approximate), Figure 7 (barriers 1.69, 0.27, 0.10 eV). Reference solve.sh uses exactly these numbers.",
      "generation_method": "Extracted from paper tables, text, and figures; adsorption energies are approximated from the bar charts and qualitative trends in the paper. All values are consistent with the paper's stated ordering and the behavior described.",
      "why_not_fabricated": "Each value is traceable to a specific location in the paper's reported data or derived from its described trends; none are invented arbitrarily."
    }
