{
  "scoring_tier": "reference_match",
  "scoring_justification": "T0 result-level compare; the checker reads the agent's reported kappa and structure values against hidden paper gold with tolerances and ordering checks. Full recompute from raw DFT/BTE artifacts is infeasible in the verifier sandbox.",
  "pass_threshold": 0.6,
  "target_policies": {
    "thermal_conductivity_results.json": "reference_match",
    "optimized_structures.json": "reference_match"
