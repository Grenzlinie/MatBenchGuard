{
  "scoring_tier": "consistency",
  "scoring_justification": "Cannot recompute thermal conductivity from raw MD artifacts; agent reports final normalized_K values. Checker compares to paper-reported gold with tolerances and verifies monotonic trends.",
  "pass_threshold": 0.6,
  "target_policies": {
    "thermal_conductivity_results.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold_normalized_conductivities",
      "source_provenance": "Paper Table I for grain series, values extracted from paper figures for strain and temperature series, consistent with reference solve.sh.",
      "generation_method": "Hardcoded from solve.sh values derived from paper text and figures.",
      "why_not_fabricated": "Values are the paper's reported results; the reference oracle writes the same values."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "thermal_conductivity_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "grain_size_nm",
            "strain",
            "temperature_K",
            "absolute_K_W_mK",
            "normalized_K"
          ],
          "units": {
            "grain_size_nm": "nm, -1 for single-crystalline",
            "strain": "dimensionless",
            "temperature_K": "K",
            "absolute_K_W_mK": "W/(m·K)",
            "normalized_K": "dimensionless ratio"
          }
        },
        "description": "CSV file containing computed normalized thermal conductivity (K/K0) and absolute thermal conductivity for all simulation conditions: grain size series (5 rows for grain sizes 2.5,5,7.5,10,12.5 nm at strain=0, temp=300 K), strain series (15 rows for SC, 2.5 nm, 7.5 nm at strains 0,0.03,0.06,0.09,0.12, temp=300 K), and temperature series (9 rows for SC, 2.5 nm, 10 nm at temps 300,400,500 K, strain=0)."
      }
    ],
    "notes": "The normalized values use the agent's own computed K0 for single-crystalline graphene at 300 K zero strain. Only the normalized_K values are scored against the paper's reported data."
  },
  "steps": [
    {
      "id": "grain_series",
      "output_file": "thermal_conductivity_results.csv",
      "weight": 0.5,
      "kind": "numeric_compare",
      "settings": {
        "conditions": {
          "strain": 0.0,
          "temperature_K": 300
        },
        "grain_sizes": [
          -1,
          2.5,
          5.0,
          7.5,
          10.0,
          12.5
        ],
        "gold": {
          "-1": 1.0,
          "2.5": 0.19,
          "5.0": 0.32,
          "7.5": 0.39,
          "10.0": 0.47,
          "12.5": 0.57
        },
        "abs_tolerance": 0.1,
        "monotonicity_required": true
      }
    },
    {
      "id": "strain_series",
      "output_file": "thermal_conductivity_results.csv",
      "weight": 0.25,
      "kind": "numeric_compare",
      "settings": {
        "conditions": {
          "temperature_K": 300
        },
        "groups": {
          "SC": {
            "grain_size_nm": -1
          },
          "grain_7.5": {
            "grain_size_nm": 7.5
          },
          "grain_2.5": {
            "grain_size_nm": 2.5
          }
        },
        "strain_values": [
          0.0,
          0.03,
          0.06,
          0.09,
          0.12
        ],
        "gold": {
          "SC": [
            1.0,
            0.88,
            0.73,
            0.58,
            0.43
          ],
          "grain_7.5": [
            0.39,
            0.35,
            0.3101,
            0.2701,
            0.2301
          ],
          "grain_2.5": [
            0.19,
            0.1748,
            0.1596,
            0.1444,
            0.1292
          ]
        },
        "rel_tolerance": 0.2,
        "monotonicity_required": true
      }
    },
    {
      "id": "temp_series",
      "output_file": "thermal_conductivity_results.csv",
      "weight": 0.25,
      "kind": "numeric_compare",
      "settings": {
        "conditions": {
          "strain": 0.0
        },
        "groups": {
          "SC": {
            "grain_size_nm": -1
          },
          "grain_10": {
            "grain_size_nm": 10.0
          },
          "grain_2.5": {
            "grain_size_nm": 2.5
          }
        },
        "temp_values": [
          300,
          400,
          500
        ],
        "gold": {
          "SC": [
            1.0,
            0.8,
            0.65
          ],
          "grain_10": [
            0.47,
            0.44,
            0.41
          ],
          "grain_2.5": [
            0.19,
            0.19,
            0.19
          ]
        },
        "rel_tolerance": 0.2,
        "monotonicity_required": true,
        "constant_allowed_for_2.5": true
      }
    }
  ]
}