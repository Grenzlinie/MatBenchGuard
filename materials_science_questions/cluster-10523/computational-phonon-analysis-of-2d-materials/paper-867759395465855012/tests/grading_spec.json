{
  "scoring_tier": "recompute",
  "scoring_justification": "Checker recomputes gap closure events and phase transitions from agent's raw CSV data, and compares equilibrium gap to paper-reported value.",
  "pass_threshold": 0.6,
  "target_policies": {
    "equilibrium_gap.txt": "exact_match",
    "band_gap_vs_Q.csv": "reference_match",
    "phase_diagram_2D.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "equilibrium_gap_target",
      "source_provenance": "Paper reports SOC gap ~12 meV.",
      "generation_method": "Paper value from text: 'small gap size of 12 meV'.",
      "why_not_fabricated": "Value taken directly from paper."
    },
    {
      "path": "grading_spec_json.inline",
      "purpose": "gap_vs_Q_criteria",
      "source_provenance": "Paper claims: five Ag modes close gap and flip Z2, Ag-22 does not; Ag-27 critical Q ~ -0.25.",
      "generation_method": "Criteria derived from paper's main claim and Fig. 2.",
      "why_not_fabricated": "Directly reflects paper's reported behavior."
    },
    {
      "path": "grading_spec_json.inline",
      "purpose": "phase_diagram_2D_line",
      "source_provenance": "Paper reports linear equation 10y+2.5x+0.75=0 separating STI/WTI.",
      "generation_method": "Equation from Fig. 4 caption.",
      "why_not_fabricated": "Verbatim from paper."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "equilibrium_gap.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "text",
          "required": {
            "value": "float in eV"
          }
        },
        "description": "Equilibrium SOC band gap at the Γ point of ZrTe5."
      },
      {
        "file": "band_gap_vs_Q.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "mode_name",
            "Q",
            "gap_meV",
            "topological_phase"
          ],
          "units": {
            "gap_meV": "meV"
          }
        },
        "description": "Evolution of the Γ-point band gap and topological phase as a function of the normal coordinate Q for each of the six Ag phonon modes."
      },
      {
        "file": "phase_diagram_2D.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "Q27",
            "Q31",
            "gap_meV",
            "topological_phase"
          ],
          "units": {
            "gap_meV": "meV"
          }
        },
        "description": "Two-dimensional phase diagram (gap and topological phase) on a grid of (A_g-27, A_g-31) normal coordinate values."
      }
    ],
    "notes": "All outputs are computed from first-principles DFT with spin-orbit coupling. The checker compares the submitted results to hidden gold references derived from the paper's reported quantities, with tolerances appropriate for DFT code-to-code variation."
  },
  "steps": [
    {
      "id": "equilibrium_gap_check",
      "output_file": "equilibrium_gap.txt",
      "kind": "numeric",
      "weight": 0.15,
      "target": 0.012,
      "tolerance": 0.003,
      "unit": "eV"
    },
    {
      "id": "gap_vs_Q_check",
      "output_file": "band_gap_vs_Q.csv",
      "kind": "structural_audit",
      "weight": 0.7,
      "criteria": {
        "expected_modes": [
          "Ag6",
          "Ag22",
          "Ag25",
          "Ag27",
          "Ag29",
          "Ag36"
        ],
        "closing_modes": [
          "Ag6",
          "Ag25",
          "Ag27",
          "Ag29",
          "Ag36"
        ],
        "non_closing_mode": "Ag22",
        "closing_threshold_meV": 2.0,
        "non_closing_min_gap_meV": 5.0,
        "critical_Q_Ag27": -0.25,
        "critical_Q_tolerance": 0.1,
        "Q_range_min": -0.6,
        "Q_range_max": 0.3,
        "max_step": 0.1,
        "phase_labels": [
          "STI",
          "WTI"
        ]
      },
      "sub_weights": {
        "mode_identification": 0.1,
        "data_completeness": 0.15,
        "closing_detection": 0.3,
        "non_closing_detection": 0.15,
        "phase_flip_present": 0.2,
        "Ag27_critical_Q": 0.1
      }
    },
    {
      "id": "phase_diagram_2D_check",
      "output_file": "phase_diagram_2D.csv",
      "kind": "structural_audit",
      "weight": 0.15,
      "criteria": {
        "grid_points": 49,
        "Q_range_min": -0.6,
        "Q_range_max": 0.3,
        "reference_line": {
          "coefficients": [
            10.0,
            2.5,
            0.75
          ],
          "tolerance": {
            "a": 2.0,
            "b": 1.0,
            "c": 0.2
          }
        }
      },
      "sub_weights": {
        "grid_completeness": 0.2,
        "phase_labels_valid": 0.1,
        "line_fitting": 0.7
      }
    }
  ]
}