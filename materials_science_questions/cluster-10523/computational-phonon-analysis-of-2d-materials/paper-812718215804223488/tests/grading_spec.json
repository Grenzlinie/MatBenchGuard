        "K8Ge44□2": {
          "kappa_l_300": 1.1,
          "theta_TA": 51,
          "theta_LA": 57,
          "theta_D": 264,
          "v_TA": 2.3,
          "v_LA": 3.7,
          "v_s": 2.5,
          "gamma_300": 1.2,
          "gamma_TA": 0.6,
          "gamma_LA": 1.6
        }
      },
      "tolerances": {
        "kappa": 0.2,
        "theta": 0.1,
        "v": 0.1,
        "gamma_abs": 0.2
      }
    },
    {
      "id": "spectral_width_reduction",
      "output_file": "phonon_dispersions.json",
      "weight": 0.3,
      "kind": "metric_recompute",
      "target_reduction_Si": 0.3,
      "tolerance_Si": 0.05,
      "target_reduction_Ge": 0.1,
      "tolerance_Ge": 0.03
    },
    {
      "id": "ordering_and_flatbands",
      "output_file": "phonon_dispersions.json",
      "weight": 0.2,
      "kind": "structural_audit",
      "flatband_regions": {
        "Si46": [
          [
            140,
            180
          ],
          [
            450,
            480
          ]
        ]
      },
      "ordering_check": true
