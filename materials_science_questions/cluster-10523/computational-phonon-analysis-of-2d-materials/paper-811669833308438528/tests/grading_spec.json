{
  "scoring_tier": "result_level_compare",
  "scoring_justification": "T0 result-level compare; full DFT recompute not possible in verifier sandbox; agent reports final quantities against paper-extracted gold with tolerances.",
  "pass_threshold": 0.6,
  "target_policies": {
    "magnetic_moments.csv": "reference_match",
    "dos_fermi.csv": "reference_match",
    "lambda.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold values for Fe magnetic moments (Table 1), DOS at EF (Fig. 5a), and λ (Fig. 5b) for doping x=0.00–0.30 step 0.05.",
      "source_provenance": "Table 1 of paper; Figs 5a/b digitised from the paper.",
      "generation_method": "Magnetic moments taken directly from paper Table 1; DOS and λ extracted via plot digitiser from Figs 5a and 5b.",
      "why_not_fabricated": "Values are the paper’s own reported/reconstructed numbers; solve.sh writes them to verify positive control and full oracle reward."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "magnetic_moments.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required": {},
          "items": {},
          "required_columns": [
            "x",
            "magnetic_moment"
          ],
          "units": {
            "magnetic_moment": "μB"
          }
        },
        "description": "Fe magnetic moment per atom (in μB) as a function of electron doping x."
      },
      {
        "file": "dos_fermi.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required": {},
          "items": {},
          "required_columns": [
            "x",
            "dos_fermi"
          ],
          "units": {
            "dos_fermi": "states/eV/f.u."
          }
        },
        "description": "Total electronic density of states at the Fermi level (states/eV per formula unit) vs. doping x."
      },
      {
        "file": "lambda.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required": {},
          "items": {},
          "required_columns": [
            "x",
            "lambda"
          ],
          "units": {
            "lambda": "dimensionless"
          }
        },
        "description": "Electron-phonon coupling parameter λ (dimensionless) vs. doping x."
      }
    ],
    "notes": "The checker compares the submitted CSV values to hidden reference values extracted from the paper (Table 1 and digitized Figure 5a,b) with appropriate tolerances. The λ parameter is computed from the standard expression λ = (1/(2M_As ω^2)) Σ_n N_n(EF) (dEn/du)^2 using ω = 25 meV."
  },
  "steps": [
    {
      "id": "magnetic_moments_check",
      "output_file": "magnetic_moments.csv",
      "kind": "reference_match",
      "weight": 0.4,
      "description": "Fe magnetic moment per atom vs doping x. Compare to gold from Table 1 with absolute tolerance 0.10 μB.",
