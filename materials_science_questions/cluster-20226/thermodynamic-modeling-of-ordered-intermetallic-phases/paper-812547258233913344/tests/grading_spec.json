  "pass_threshold": 0.6,
  "target_policies": {
    "step_02_v_sublattice_occupation.csv": "structural_audit",
    "step_03_sro_parameters.csv": "structural_audit",
    "step_04_specific_heat.csv": "structural_audit",
    "step_06_relaxation_and_msad.csv": "structural_audit"
  },
  "hidden_assets": [],
