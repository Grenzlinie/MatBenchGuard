{
  "scoring_tier": "reference_match",
  "scoring_justification": "Recomputing the angular width and sticking probability from raw trajectory files is infeasible inside the verifier sandbox; therefore we compare the agent’s reported CSV values to paper-derived gold with tolerances and trend checks, which is an acceptable result-level compare (D4 T0).",
  "pass_threshold": 0.6,
  "target_policies": {
    "angular_width_static.csv": "reference_match",
    "angular_width_600K.csv": "reference_match",
    "sticking_probability_600K.csv": "reference_match"
  },
  "output_contract": {
    "outputs": [
      {
        "file": "angular_width_static.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "required_columns": [
            "incidence_energy_eV",
            "angular_width_deg"
          ],
          "units": {
            "incidence_energy_eV": "eV",
            "angular_width_deg": "degree"
          }
        },
        "description": "Angular width 2Δθ_f (in degrees) for in-plane scattering from a static Ag(111) surface at each incidence energy."
      },
      {
        "file": "angular_width_600K.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "required_columns": [
            "incidence_energy_eV",
            "angular_width_deg"
          ],
          "units": {
            "incidence_energy_eV": "eV",
            "angular_width_deg": "degree"
          }
        },
        "description": "Angular width 2Δθ_f (in degrees) for in-plane scattering from a Ag(111) surface at 600 K at each incidence energy."
      },
      {
        "file": "sticking_probability_600K.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "required_columns": [
            "incidence_energy_eV",
            "sticking_probability"
          ],
          "units": {
            "incidence_energy_eV": "eV",
            "sticking_probability": "dimensionless (fraction)"
          }
        },
        "description": "Sticking probability (fraction of atoms that do not escape the surface) for a 600 K surface at each incidence energy."
      }
    ],
    "notes": "The hidden checker compares the agent’s reported angular widths and sticking probabilities to paper-derived reference values with tolerances that absorb implementation spread and resist guessing. Trends (e.g., minimum near 1 eV, sticking decrease below 1 eV then rise above 10 eV) are also checked."
  },
  "steps": [
    {
      "id": "angular_width_static_check",
      "output_file": "angular_width_static.csv",
      "kind": "numeric",
      "weight": 0.4,
      "gold_values": {
        "0.03": 25.0,
        "0.1": 22.0,
        "0.5": 12.0,
        "1.0": 10.0,
        "10.0": 18.0,
        "100.0": 55.0
      },
      "tolerances": {
        "pointwise": "abs",
        "spec": [
          {
            "energy": 0.03,
            "tol_abs": 2.0
          },
          {
            "energy": 0.1,
            "tol_abs": 2.0
          },
          {
            "energy": 0.5,
            "tol_abs": 2.0
          },
          {
            "energy": 1.0,
            "tol_abs": 2.0
          },
          {
            "energy": 10.0,
            "tol_abs": 5.0
          },
          {
            "energy": 100.0,
            "tol_abs": 5.0
          }
        ]
      },
      "trend_check": {
        "description": "minimum near 1 eV: value at 1.0 eV <= value at 0.5 eV and <= value at 10.0 eV",
        "weight_in_check": 0.1
      }
    },
    {
      "id": "angular_width_600K_check",
      "output_file": "angular_width_600K.csv",
      "kind": "numeric",
      "weight": 0.4,
      "gold_values": {
        "0.03": 45.0,
        "0.1": 40.0,
        "0.5": 35.0,
        "1.0": 18.0,
        "10.0": 25.0,
        "100.0": 60.0
      },
      "tolerances": {
        "pointwise": "abs",
        "spec": [
          {
            "energy": 0.03,
            "tol_abs": 2.0
          },
          {
            "energy": 0.1,
            "tol_abs": 2.0
          },
          {
            "energy": 0.5,
            "tol_abs": 2.0
          },
          {
            "energy": 1.0,
            "tol_abs": 2.0
          },
          {
            "energy": 10.0,
            "tol_abs": 5.0
          },
          {
            "energy": 100.0,
            "tol_abs": 5.0
          }
        ]
      },
      "trend_check": {
        "description": "minimum near 1 eV: value at 1.0 eV <= value at 0.5 eV and <= value at 10.0 eV",
        "weight_in_check": 0.1
      }
    },
    {
      "id": "sticking_probability_600K_check",
      "output_file": "sticking_probability_600K.csv",
      "kind": "numeric",
      "weight": 0.2,
      "gold_values": {
        "0.03": 0.55,
        "0.1": 0.35,
        "0.5": 0.02,
        "1.0": 0.0,
        "10.0": 0.0,
        "100.0": 0.25
      },
      "tolerances": {
        "pointwise": "relative_with_cap",
        "rel": 0.15,
        "abs_cap": 0.1
      },
      "trend_check": {
        "description": "sticking decreases with energy for Ei < 1 eV (non-increasing) and rises again above 10 eV (non-decreasing from 10 to 100 eV)",
        "weight_in_check": 0.1
      }
    }
  ],
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold angular width and sticking values per incidence energy",
      "source_provenance": "extracted from paper Fig. 7 (angular width) and Fig. 8 (sticking probability); consistent with reference solve.sh",
      "generation_method": "digitized from the paper figures and verified against the reference solve.sh output",
      "why_not_fabricated": "values are the paper’s own reported results, not invented labels"
    }
  ]
}