{
  "version": 1,
  "resources": [
    {
      "id": "res_qe",
      "name": "Quantum ESPRESSO",
      "type": "tool",
      "access": {
        "method": "url",
        "url": "https://www.quantum-espresso.org/",
        "notes": "Open-source DFT code, installable via conda or apt"
      }
    },
    {
      "id": "res_phonopy",
      "name": "phonopy",
      "type": "package",
      "access": {
        "method": "package",
        "package": "phonopy",
        "notes": "pip install phonopy"
      }
    },
    {
      "id": "res_pycalphad",
      "name": "pycalphad",
      "type": "package",
      "access": {
        "method": "package",
        "package": "pycalphad",
        "notes": "pip install pycalphad"
      }
    },
    {
      "id": "res_rey_exp",
      "name": "Re-Y experimental phase boundary data",
      "type": "dataset",
      "access": {
        "method": "bundled",
        "notes": "Bundled as Re_Y_exp_data.csv, extracted from Lundin and Klodt (1961)"
      }
    },
    {
      "id": "res_nire_exp",
      "name": "Ni-Re experimental phase boundary data",
      "type": "dataset",
      "access": {
        "method": "bundled",
        "notes": "Bundled as Ni_Re_exp_data.csv, extracted from Savitskii et al. (1970)"
      }
    },
    {
      "id": "res_sgte",
      "name": "SGTE unary database v4 (pure elements)",
      "type": "file",
      "access": {
        "method": "bundled",
        "notes": "Bundled as pure_elements.tdb; publicly available SGTE data for Re, Y, Ni"
      }
    },
    {
      "id": "res_niy",
      "name": "Ni-Y thermodynamic database",
      "type": "file",
      "access": {
        "method": "bundled",
        "notes": "Bundled as Ni_Y.tdb; from Du and Lu, Intermetallics 2005 (supplementary material)"
      }
    }
  ]
}