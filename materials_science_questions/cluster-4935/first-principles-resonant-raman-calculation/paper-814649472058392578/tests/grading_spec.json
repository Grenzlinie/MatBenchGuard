{
  "scoring_tier": "recompute",
  "scoring_justification": "The Raman spectra are recomputable from the submitted φ and energy grid via Eq. (13) with absorption/Φ derived from φ, enabling a consistency audit.",
  "pass_threshold": 0.6,
  "hidden_assets": [],
  "output_contract": {
    "outputs": [
      {
        "file": "rrs_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "object",
          "required": [
            "Raman_spectra",
            "response_function",
            "energy_grid"
          ],
          "properties": {
            "Raman_spectra": {
              "type": "object",
              "required": [
                "E0_plus_30",
                "E0_plus_50",
                "E0_minus_30",
                "E0_minus_50"
              ],
              "properties": {
                "E0_plus_30": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "E0_plus_50": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "E0_minus_30": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "E0_minus_50": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "response_function": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "energy_grid": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "description": "Contains the first-order Raman spectra for four excitation frequencies, the total response function φ(E), and the common energy grid. The checker will verify internal consistency between the Raman spectra and the submitted φ and Φ, check shape correlation between red-side spectra and φ, and validate peak positions for blue-side spectra."
      }
    ],
    "notes": "The agent must implement the formulas using the stated parameters and a reasonable approximation for the cut-off function. All required inputs are parametric; no external data download is needed. The hidden checker will perform structural audits on the submitted artifact."
  },
  "steps": [
    {
      "id": "consistency_audit",
      "output_file": "rrs_results.json",
      "weight": 0.5,
      "kind": "recompute_spectra",
      "description": "Recompute first-order Raman spectra from φ and check normalized RMSE against submitted spectra.",
      "target_policy": "metric_recompute",
      "tolerance": 0.001,
      "excitation_frequencies": {
        "E0_plus_30": 30,
        "E0_plus_50": 50,
        "E0_minus_30": -30,
        "E0_minus_50": -50
      }
    },
    {
      "id": "shape_correlation",
      "output_file": "rrs_results.json",
      "weight": 0.25,
      "kind": "correlation_check",
      "description": "Pearson correlation between each red-side spectrum and φ must exceed 0.95.",
      "target_policy": "reference_match",
      "min_correlation": 0.95,
      "spectra_keys": [
        "E0_minus_30",
        "E0_minus_50"
      ]
    },
    {
      "id": "peak_position",
      "output_file": "rrs_results.json",
      "weight": 0.2,
      "kind": "peak_check",
      "description": "Blue-side spectra must have main peak within 2 cm⁻¹ of expected Raman shift.",
      "target_policy": "exact_match",
      "expected_shifts": {
        "E0_plus_30": 30,
        "E0_plus_50": 50
      },
      "tolerance_cm": 2.0
    },
    {
      "id": "intensity_ratio",
      "output_file": "rrs_results.json",
      "weight": 0.05,
      "kind": "ratio_check",
      "description": "Ratio of peak intensities between the two blue-side spectra must be less than 500.",
      "target_policy": "reference_match",
      "max_ratio": 500
    }
  ]
}