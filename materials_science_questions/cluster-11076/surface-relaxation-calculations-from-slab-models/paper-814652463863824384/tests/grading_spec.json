{
  "scoring_tier": "recompute",
  "scoring_justification": "Full T1 recompute is infeasible because the verifier lacks the agent’s raw total energies, ZPE corrections, and reference energies needed to recompute the headline Helmholtz enthalpies and adsorption energies. Therefore we use T0 result‑level comparison (against paper gold) supplemented by T3 structural/trend checks.",
  "pass_threshold": 0.6,
  "target_policies": {
    "bulk_results.json": "reference_match",
    "surface_results.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper gold values for bulk decomposition enthalpies, surface relaxations, adsorption energies, desorption energies, and residence times",
      "source_provenance": "Paper Tables 2, 5, 6, 7 (https://doi.org/10.1016/j.ijhydene.2015.01.112)",
      "generation_method": "Extracted verbatim from the published tables",
      "why_not_fabricated": "These are the paper's own reported numbers; any correct reproduction using the same methodology should produce results close to them. The hidden checker compares the agent's computed values against these numbers within generous tolerances that account for different DFT implementations."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "bulk_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system": {
                "type": "string"
              },
              "y": {
                "type": "integer"
              },
              "total_energy": {
                "type": "number",
                "description": "eV"
              },
              "a": {
                "type": "number",
                "description": "Å"
              },
              "b": {
                "type": "number",
                "description": "Å"
              },
              "c": {
                "type": "number",
                "description": "Å"
              },
              "reaction_energy": {
                "type": "number",
                "description": "eV"
              },
              "zpe_correction": {
                "type": "number",
                "description": "eV"
              },
              "helmholtz_enthalpy": {
                "type": "number",
                "description": "eV"
              }
            },
            "required": [
              "system",
              "y",
              "total_energy",
              "a",
              "b",
              "c",
              "reaction_energy",
              "zpe_correction",
              "helmholtz_enthalpy"
            ]
          }
        },
        "description": "Calculated bulk decomposition energies and enthalpies for clean, Co- and Ni-doped MgH2 systems."
      },
      {
        "file": "surface_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "system": {
                "type": "string"
              },
              "layer": {
                "type": "string"
              },
              "rumpling": {
                "type": "number",
                "description": "Å"
              },
              "relaxation": {
                "type": "number",
                "description": "%"
              },
              "adsorption_energy": {
                "type": "number",
                "description": "eV"
              },
              "desorption_energy": {
                "type": "number",
                "description": "eV"
              },
              "desorption_frequency": {
                "type": "number",
                "description": "cm-1"
              },
              "relative_residence_time_percent": {
                "type": "number"
              }
            },
            "required": [
              "system",
              "layer",
              "rumpling",
              "relaxation",
              "adsorption_energy",
              "desorption_energy",
              "desorption_frequency",
              "relative_residence_time_percent"
            ]
          }
        },
        "description": "Surface relaxation, adsorption, desorption and residence time results for MgH2(001) clean and doped surfaces."
      }
    ],
    "notes": "The agent is expected to use open-source DFT and phonon codes; all results are compared to the paper's reported reference values with tolerances suitable for methodological differences."
  },
  "steps": [
    {
      "id": "bulk_shape",
      "output_file": "bulk_results.json",
      "kind": "structural_audit",
      "weight": 0.05,
      "description": "Verify existence, correct type, required keys, and six expected systems.",
      "expected_systems": [
        "Mg-Mg7H16",
        "Mg-Mg7H15",
        "Co-Mg7H16",
        "Co-Mg7H15",
        "Ni-Mg7H16",
        "Ni-Mg7H15"
      ]
    },
    {
      "id": "bulk_trends",
      "output_file": "bulk_results.json",
      "kind": "structural_audit",
      "weight": 0.15,
      "description": "Check that for each y (15,16): doped enthalpies < pure, Co‑doped < Ni‑doped, and all enthalpies > 0."
    },
    {
      "id": "bulk_values",
      "output_file": "bulk_results.json",
      "kind": "numeric",
      "weight": 0.3,
      "description": "Compare helmholtz_enthalpy to paper gold (Table 2) with tolerance ±0.1 eV.",
      "gold_helmholtz": {
        "Mg-Mg7H16": 0.539,
        "Mg-Mg7H15": 0.353,
        "Co-Mg7H16": 0.28,
        "Co-Mg7H15": 0.21,
        "Ni-Mg7H16": 0.289,
        "Ni-Mg7H15": 0.287
      },
      "tolerance": 0.1
    },
    {
      "id": "surface_shape",
      "output_file": "surface_results.json",
      "kind": "structural_audit",
      "weight": 0.05,
      "description": "Verify array of objects with required keys, expected systems and layer IDs exist."
    },
    {
      "id": "surface_trends",
      "output_file": "surface_results.json",
      "kind": "structural_audit",
      "weight": 0.2,
      "description": "Check ordering/trends: L0 relaxation more negative for doped systems, adsorption energy signs (Mg negative, Co positive, Ni negative), desorption energy Mg > Ni > Co, relative residence time Ni < Co < Mg."
    },
    {
      "id": "surface_values",
      "output_file": "surface_results.json",
      "kind": "numeric",
      "weight": 0.25,
      "description": "Compare key values (relaxation, adsorption energy, desorption energy, residence time) to paper gold (Tables 5–7) with generous tolerances.",
      "gold_surface": {
