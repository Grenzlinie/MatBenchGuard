{
  "scoring_tier": "result-level_compare",
  "scoring_justification": "Full recompute of Monte Carlo free energy method is computationally infeasible in the verifier; compare agent-reported aggregated stage free energy differences and final macroscopic properties against paper-reported gold values with appropriate tolerances.",
  "pass_threshold": 0.6,
  "target_policies": {
    "results.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper-reported gold free energy differences, surface tension, and excess internal energy for the 216-particle LJ 6:12 fluid at T*=0.7, ρ*=0.85.",
      "source_provenance": "Paper: J. Miyazaki et al., J. Chem. Phys. 64, 3364 (1976). Values from Table I (intermediate C values summed to Fc-Fb=55.73ε), text (Fb-Fa=96.72ε, Fd-Fc=-69.69ε, Fe-Fd=-9.97ε, Ff-Fe=-7.86ε, total ΔF=64.93ε), and Table II (γ=18.3±0.3 dyn/cm, U_s=38.9±0.8 erg/cm²).",
      "generation_method": "Extracted directly from the published paper; not fabricated.",
      "why_not_fabricated": "These are the actual paper-reported results; they serve as the authoritative reproduction target."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "total_free_energy": "number (units of ε)",
            "surface_tension": "number (dyn/cm)",
            "excess_internal_energy": "number (erg/cm²)",
            "stages": {
              "type": "object",
              "required": {
                "Fb_minus_Fa": "number (units of ε)",
                "Fc_minus_Fb": "number (units of ε)",
                "Fd_minus_Fc": "number (units of ε)",
                "Fe_minus_Fd": "number (units of ε)",
                "Ff_minus_Fe": "number (units of ε)"
              }
            }
          }
        },
        "description": "Final aggregated results: total free energy of surface creation, surface tension, excess internal energy, and the five stage free energy differences. The checker compares these to the paper's reported values with appropriate tolerances."
      },
      {
        "file": "evidence_bulk_tail.txt",
        "format": "txt",
        "purpose": "intermediate",
        "schema": {},
        "description": "Evidence for bulk tail correction computation."
      },
      {
        "file": "evidence_slab_separation.json",
        "format": "json",
        "purpose": "intermediate",
        "schema": {},
        "description": "Evidence for slab separation Bennett steps."
      },
      {
        "file": "evidence_cutoff_increase.txt",
        "format": "txt",
        "purpose": "intermediate",
        "schema": {},
        "description": "Evidence for cut-off increase free energy."
      },
      {
        "file": "evidence_relaxation.json",
        "format": "json",
        "purpose": "intermediate",
        "schema": {},
        "description": "Evidence for surface relaxation integration."
      },
      {
        "file": "evidence_surface_tail.txt",
        "format": "txt",
        "purpose": "intermediate",
        "schema": {},
        "description": "Evidence for free surface tail correction."
      }
    ],
    "notes": "The perturbation theory correction (BFW+ATM) is not required for this core reproduction."
  },
  "steps": [
    {
      "id": "check_Fb_minus_Fa",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.05,
      "json_path": "stages.Fb_minus_Fa",
      "target": 96.72,
      "tolerance_rel": 0.02,
      "description": "Bulk tail correction Fb-Fa"
    },
    {
      "id": "check_Fc_minus_Fb",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.1,
      "json_path": "stages.Fc_minus_Fb",
      "target": 55.73,
      "tolerance_rel": 0.05,
      "description": "Slab separation free energy Fc-Fb"
    },
    {
      "id": "check_Fd_minus_Fc",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.05,
      "json_path": "stages.Fd_minus_Fc",
      "target": -69.69,
      "tolerance_rel": 0.05,
      "description": "Cut-off increase free energy Fd-Fc"
    },
    {
      "id": "check_Fe_minus_Fd",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.1,
      "json_path": "stages.Fe_minus_Fd",
      "target": -9.97,
      "tolerance_rel": 0.1,
      "description": "Surface relaxation free energy Fe-Fd"
    },
    {
      "id": "check_Ff_minus_Fe",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.05,
      "json_path": "stages.Ff_minus_Fe",
      "target": -7.86,
      "tolerance_rel": 0.02,
      "description": "Free surface tail correction Ff-Fe"
    },
    {
      "id": "check_total_free_energy",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.1,
      "description": "Total free energy (total_free_energy field) compared to paper gold 64.93ε",
      "json_path": "total_free_energy",
      "target": 64.93,
      "tolerance_rel": 0.05,
      "recompute": false
    },
    {
      "id": "check_surface_tension",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.3,
      "json_path": "surface_tension",
      "target": 18.3,
      "tolerance_abs": 1.0,
      "tolerance_rel": 0.05,
      "description": "Surface tension γ (dyn/cm)"
    },
    {
      "id": "check_excess_internal_energy",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.25,
      "json_path": "excess_internal_energy",
      "target": 38.9,
      "tolerance_abs": 2.0,
      "tolerance_rel": 0.05,
      "description": "Excess internal energy Us (erg/cm²)"
    }
  ]
}