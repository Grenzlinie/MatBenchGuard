{
  "scoring_tier": "recompute",
  "scoring_justification": "T1 recompute for QSAR models; T0 reference_match for interaction energies (no exact tabulated data; gold derived from paper's QSAR equations).",
  "pass_threshold": 0.6,
  "target_policies": {
    "interaction_energies.csv": "reference_match",
    "qsar_models.json": "metric_recompute"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold interaction energies for 17 CNPs derived from paper's QSAR equations (Eqs 2-3) using published descriptors (Table 1).",
      "source_provenance": "Paper Eqs 2-3 and Table 1.",
      "generation_method": "Evaluated equations with descriptor values; these are the fitted predictions of the paper's own interaction energies.",
      "why_not_fabricated": "These numbers are directly computable from the paper's own reported models and descriptors; they represent the paper's best estimate of the interaction energies. The use of ±15% relative tolerance accounts for simulation re-run differences."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "interaction_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "CNP_name",
            "E_int_total"
          ],
          "optional_columns": [
            "E_int_vdw",
            "E_int_elec"
          ],
          "units": {
            "E_int_total": "kcal/mol",
            "E_int_vdw": "kcal/mol",
            "E_int_elec": "kcal/mol"
          }
        },
        "description": "Table of interaction energies per CNP, calculated from the annealing simulations. The checker compares E_int_total against paper‑reported reference values (hidden) and verifies the among‑family ordering (fullerenes < graphenes < CNTs)."
      },
      {
        "file": "qsar_models.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "object",
          "required": [
            "fullerenes",
            "cnt_graphenes",
            "all"
          ],
          "properties": {
            "fullerenes": {
              "type": "object",
              "required": [
                "equation",
                "R2",
                "RMSE",
                "Q2_CUM",
                "coefficients"
              ]
            },
            "cnt_graphenes": {
              "type": "object",
              "required": [
                "equation",
                "R2",
                "RMSE",
                "Q2_CUM",
                "coefficients"
              ]
            },
            "all": {
              "type": "object",
              "required": [
                "equation",
                "R2",
                "RMSE",
                "Q2_CUM",
                "coefficients"
              ]
            }
          }
        },
        "description": "QSAR model coefficients and statistics. The checker re‑fits the same OPLS regressions from the agent's own interaction_energies.csv and descriptors.csv and confirms that the agent's reported R² and Q²_CUM are within 0.1 of the re‑fit values."
      }
    ],
    "notes": "The agent must run the full simulated annealing pipeline to produce the component energies. The QSAR step is load‑bearing: its verification uses a recompute from the agent's own numerical outputs, so faking interaction energies without real simulation yields inconsistent QSAR statistics and fails the check."
  },
