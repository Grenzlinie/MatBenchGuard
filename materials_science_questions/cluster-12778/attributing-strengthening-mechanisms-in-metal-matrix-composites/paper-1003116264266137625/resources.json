{
  "version": 1,
  "resources": [
    {
      "id": "res_prisms",
      "name": "PRISMS-Plasticity",
      "type": "tool",
      "required": true,
      "access": {
        "method": "url",
        "url": "https://github.com/prisms-center/PRISMS-Plasticity"
      },
      "notes": "Open-source crystal plasticity finite element framework."
    },
    {
      "id": "res_python_packages",
      "name": "Python packages (numpy, pandas, scipy, matplotlib)",
      "type": "package",
      "required": false,
      "access": {
        "method": "package",
        "package": "pip install numpy pandas scipy matplotlib"
      },
      "notes": "For post-processing and data writing."
    },
    {
      "id": "res_cpp_compiler",
      "name": "C++ compiler and CMake",
      "type": "package",
      "required": false,
      "access": {
        "method": "package",
        "package": "apt-get install g++ cmake"
      },
      "notes": "Required to build PRISMS-Plasticity."
    }
  ]
}