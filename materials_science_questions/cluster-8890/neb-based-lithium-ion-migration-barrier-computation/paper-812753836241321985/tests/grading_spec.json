{
  "scoring_tier": "result-level",
  "scoring_justification": "Recomputation from raw DFT outputs is infeasible in the verifier sandbox; we compare agent-reported energies/barriers/lattice constant to paper-reported values within tolerances derived from expected toolchain spread.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "All gold reference values for lattice constant, adsorption energies, and diffusion barriers.",
      "source_provenance": "Paper-reported numbers from Table 1, Table 2, Figure 4, and the paper's claim of optimized lattice constant 3.153 Å.",
      "generation_method": "Exact values copied from the paper.",
      "why_not_fabricated": "These are the actual numbers the paper reports; they serve as the hidden reference for the reproduction task."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "lattice_constant.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "lattice_constant": "number (unit: angstrom)"
          }
        },
        "description": "Optimized lattice constant of the 7-ZZ-MoS2 nanoribbon."
      },
      {
        "file": "single_li_adsorption.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "site",
            "energy_eV"
          ],
          "units": {
            "energy_eV": "eV"
          }
        },
        "description": "Adsorption energies of single Li atoms at all distinct sites on 2D MoS2 and the 7-ZZ-MoS2 NR."
      },
      {
        "file": "two_li_adsorption.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "configuration",
            "energy_eV"
          ],
          "units": {
            "energy_eV": "eV"
          }
        },
        "description": "Adsorption energies of two Li atoms at edge configurations."
      },
      {
        "file": "diffusion_barriers.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "path",
            "barrier_eV"
          ],
          "units": {
            "barrier_eV": "eV"
          }
        },
        "description": "Energy barriers for Li diffusion along different paths."
      }
    ],
    "notes": "All scored outputs will be compared to paper-reported reference values with predefined tolerances. The agent must compute these quantities using an open-source DFT implementation and the specified pseudopotentials, following the workflow described in the steps."
  },
  "steps": [
    {
      "id": "lattice_constant",
      "output_file": "lattice_constant.json",
      "kind": "reference_match",
      "weight": 0.1,
      "params": {
        "target": 3.153,
        "tolerance": 0.005
      }
    },
    {
      "id": "single_li_adsorption",
      "output_file": "single_li_adsorption.csv",
      "kind": "reference_match",
      "weight": 0.5,
      "params": {
        "tolerance": 0.1,
        "gold_table": {
          "S1": 3.75,
          "S2": 3.44,
          "S4": 3.5,
          "S5": 3.52,
          "S6": 3.64,
          "Mo4'": 2.87,
          "Mo5'": 2.05,
          "Mo6'": 2.14,
          "Mo7'": 3.11,
          "middle_a": 2.73,
          "middle_b": 2.76,
          "middle_c": 2.99,
          "middle_d": 3.04,
          "Mo-top": 1.7,
          "S-top": 1.01,
          "valley-top": 1.54
        },
        "s_sites": [
          "S1",
          "S2",
          "S4",
          "S5",
          "S6"
        ],
        "mo_sites": [
          "Mo4'",
          "Mo5'",
          "Mo6'",
          "Mo7'"
        ],
        "middle_sites": [
          "middle_a",
          "middle_b",
          "middle_c",
          "middle_d"
        ],
        "2d_sites": [
          "Mo-top",
          "S-top",
          "valley-top"
        ],
        "numeric_weight": 0.8,
        "trend_weight": 0.2
      }
    },
    {
      "id": "two_li_adsorption",
      "output_file": "two_li_adsorption.csv",
      "kind": "reference_match",
      "weight": 0.2,
      "params": {
        "tolerance": 0.1,
        "gold_table": {
          "S_terminal_1-1N": 6.71,
          "S_terminal_1-d": 6.29,
          "S_terminal_1-1s": 6.98,
          "Mo_terminal_7'-7N'": 5.23,
          "Mo_terminal_7'-a": 5.13,
          "Mo_terminal_7'-1'": 4.93,
          "Mo_terminal_7'-7s'": 5.57
        },
        "s_configs": [
          "S_terminal_1-1N",
          "S_terminal_1-d",
          "S_terminal_1-1s"
        ],
        "mo_configs": [
          "Mo_terminal_7'-7N'",
          "Mo_terminal_7'-a",
          "Mo_terminal_7'-1'",
          "Mo_terminal_7'-7s'"
        ],
        "numeric_weight": 0.8,
        "trend_weight": 0.2
      }
    },
    {
      "id": "diffusion_barriers",
      "output_file": "diffusion_barriers.csv",
      "kind": "reference_match",
      "weight": 0.2,
      "params": {
        "tolerance": 0.05,
        "gold_table": {
          "S_edge_T1_T2": 0.31,
          "Mo_edge_T1_T2": 0.47,
          "middle_to_S_edge": 0.18,
          "middle_to_Mo_edge": 0.22,
          "2D_monolayer": 0.23
        },
        "numeric_weight": 0.8,
        "trend_weight": 0.2
      }
    }
  ]
}