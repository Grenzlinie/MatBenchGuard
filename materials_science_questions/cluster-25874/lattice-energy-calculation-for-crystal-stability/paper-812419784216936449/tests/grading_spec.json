            "unit": "string"
          },
          "lattice_energy_hf": {
            "value": "number",
            "unit": "string"
          },
          "lattice_energy_mp2": {
            "value": "number",
            "unit": "string"
          },
          "pair_energies": {
            "(1)-(2)": "number",
            "(1)-(3)": "number",
            "(1)-(4)": "number",
            "(1)-(5)": "number",
            "(1)-(6)": "number",
            "(1)-(7)": "number",
            "(1)-(8)": "number",
            "unit": "string"
          }
        },
        "description": "Final scored results containing lattice constants, bond length, lattice energies and pair interaction energies."
      }
