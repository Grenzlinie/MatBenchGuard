{
  "scoring_tier": "recompute",
  "scoring_justification": "Voltage recomputed from total energies; structural and charge quantities compared to paper targets with tolerances that account for toolchain spread.",
  "pass_threshold": 0.7,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold values for lattice parameters, bond lengths, energies, voltage, electron counts.",
      "source_provenance": "Paper Tables 1-3 and text; values from 'Calc' rows and explicit text values.",
      "generation_method": "Extracted directly from the paper; electron count midpoints chosen from ranges given in Table 3.",
      "why_not_fabricated": "All numbers match published values in the referenced paper."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "relaxed_structure.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "properties": {
            "a": {
              "type": "number",
              "unit": "Å"
            },
            "c": {
              "type": "number",
              "unit": "Å"
            },
            "volume": {
              "type": "number",
              "unit": "Å³"
            },
            "Li": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            },
            "Si": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            }
          },
          "required": [
            "a",
            "c",
            "volume",
            "Li",
            "Si"
          ]
        },
        "description": "DFT-relaxed lattice constants, unit-cell volume, and fractional coordinates of Li and Si in LiSi."
      },
      {
        "file": "bond_data.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "properties": {
            "Si_Si_bonds": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Si–Si bond lengths (Å)"
            },
            "Li_Li_bonds": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Li–Li bond lengths (Å)"
            },
            "Li_Si_bonds": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Li–Si bond distances (Å)"
            },
            "Si_Si_Si_angles": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Si–Si–Si bond angles (°)"
            }
          },
          "required": [
            "Si_Si_bonds",
            "Li_Li_bonds",
            "Li_Si_bonds",
            "Si_Si_Si_angles"
          ]
        },
        "description": "Interatomic distances and bond angles computed from the relaxed LiSi structure."
      },
      {
        "file": "total_energies.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "properties": {
            "LiSi_per_fu": {
              "type": "number",
              "unit": "eV"
            },
            "Li_per_atom": {
              "type": "number",
              "unit": "eV"
            },
            "Si_per_atom": {
              "type": "number",
              "unit": "eV"
            }
          },
          "required": [
            "LiSi_per_fu",
            "Li_per_atom",
            "Si_per_atom"
          ]
        },
        "description": "Total energies per formula unit (LiSi) and per atom (Li, Si) from DFT calculations."
      },
      {
        "file": "intercalation_voltage.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "text",
          "content": "A single number (float) in volts."
        },
        "description": "Average intercalation voltage V̄ for Li + Si → LiSi."
      },
      {
        "file": "electron_counts.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "properties": {
            "Li_in_LiSi": {
              "type": "object",
              "properties": {
                "s": {
                  "type": "number"
                },
                "p": {
                  "type": "number"
                },
                "d": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              },
              "required": [
                "s",
                "p",
                "d",
                "total"
              ]
            },
            "Si_in_LiSi": {
              "type": "object",
              "properties": {
                "s": {
                  "type": "number"
                },
                "p": {
                  "type": "number"
                },
                "d": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              },
              "required": [
                "s",
                "p",
                "d",
                "total"
              ]
            }
          },
          "required": [
            "Li_in_LiSi",
            "Si_in_LiSi"
          ]
        },
        "description": "Valence electron counts (s, p, d, total) within Wigner–Seitz spheres for Li and Si in LiSi."
      }
    ],
    "notes": "Outputs are compared against hidden reference values from the source paper with appropriate tolerances. The checker also recomputes the intercalation voltage from total_energies.json to ensure self-consistency."
  },
  "target_policies": {
    "relaxed_structure.json": "reference_match",
    "bond_data.json": "reference_match",
    "total_energies.json": "reference_match",
    "intercalation_voltage.txt": "metric_recompute",
    "electron_counts.json": "reference_match"
  },
  "steps": [
    {
      "id": "struct_check",
      "output_file": "relaxed_structure.json",
      "weight": 0.2,
      "kind": "numeric_comparison",
      "fields": [
        {
          "path": "a",
          "target": 9.34,
          "tolerance": 0.02
        },
        {
          "path": "c",
          "target": 5.76,
          "tolerance": 0.02
        },
        {
          "path": "volume",
          "target": 502.5,
          "tolerance": 2.0
        },
        {
          "path": "Li.x",
          "target": 0.0807,
          "tolerance": 0.005
        },
        {
          "path": "Li.y",
          "target": 0.8857,
          "tolerance": 0.005
        },
        {
          "path": "Li.z",
          "target": 0.0551,
          "tolerance": 0.005
        },
        {
          "path": "Si.x",
          "target": 0.1107,
          "tolerance": 0.005
        },
        {
          "path": "Si.y",
          "target": 0.9528,
          "tolerance": 0.005
        },
        {
          "path": "Si.z",
          "target": 0.5951,
          "tolerance": 0.005
        }
      ]
    },
    {
      "id": "bond_check",
      "output_file": "bond_data.json",
      "weight": 0.2,
      "kind": "numeric_list_comparison",
      "list_fields": [
        {
          "path": "Si_Si_bonds",
          "expected_list": [
            2.42,
            2.5
          ],
          "tolerance": 0.05
        },
        {
          "path": "Li_Li_bonds",
          "expected_list": [
            2.69,
            2.94,
            2.95
          ],
          "tolerance": 0.05
        },
        {
          "path": "Li_Si_bonds",
          "expected_list": [
            2.63,
            2.72,
            2.74,
            2.89,
            3.09
          ],
          "tolerance": 0.05
        },
        {
          "path": "Si_Si_Si_angles",
          "expected_list": [
            107.5,
            110.8,
            117.4
          ],
          "tolerance": 0.5
        }
      ]
    },
    {
      "id": "energy_check",
      "output_file": "total_energies.json",
      "weight": 0.15,
      "kind": "numeric_comparison",
      "fields": [
        {
          "path": "LiSi_per_fu",
          "target": -7.717,
          "tolerance": 0.02
        },
        {
          "path": "Li_per_atom",
          "target": -1.897,
          "tolerance": 0.02
        },
        {
          "path": "Si_per_atom",
          "target": -5.414,
          "tolerance": 0.02
        }
      ]
    },
    {
      "id": "voltage_check",
      "output_file": "intercalation_voltage.txt",
      "weight": 0.15,
      "kind": "recompute_voltage",
      "voltage_target": 0.405,
      "voltage_tolerance": 0.05
    },
    {
      "id": "electron_check",
      "output_file": "electron_counts.json",
      "weight": 0.3,
      "kind": "numeric_comparison",
      "fields": [
        {
          "path": "Li_in_LiSi.s",
          "target": 0.485,
          "tolerance": 0.05
        },
        {
          "path": "Li_in_LiSi.p",
          "target": 0.995,
          "tolerance": 0.05
        },
        {
          "path": "Li_in_LiSi.d",
          "target": 0.355,
          "tolerance": 0.05
        },
        {
          "path": "Li_in_LiSi.total",
          "target": 1.835,
          "tolerance": 0.05
        },
        {
          "path": "Si_in_LiSi.s",
          "target": 1.38,
          "tolerance": 0.05
        },
        {
          "path": "Si_in_LiSi.p",
          "target": 2.225,
          "tolerance": 0.05
        },
        {
          "path": "Si_in_LiSi.d",
          "target": 0.24,
          "tolerance": 0.05
        },
        {
          "path": "Si_in_LiSi.total",
          "target": 3.845,
          "tolerance": 0.05
        }
      ]
    }
  ]
}