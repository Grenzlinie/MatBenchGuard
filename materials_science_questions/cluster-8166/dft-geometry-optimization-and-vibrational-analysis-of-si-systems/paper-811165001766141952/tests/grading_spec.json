{
  "scoring_tier": "recompute",
  "scoring_justification": "Bond lengths and frequencies are recomputed from raw XYZ and frequency files and compared to the paper's reported values with tolerances that account for software implementation differences.",
  "pass_threshold": 0.9,
  "target_policies": {
    "sin_optimized.xyz": "metric_recompute",
    "sin_frequencies.txt": "metric_recompute",
    "sin2_optimized.xyz": "metric_recompute",
    "sin2_frequencies.txt": "metric_recompute",
    "si2n_optimized.xyz": "metric_recompute",
    "si2n_frequencies.txt": "metric_recompute",
    "benchmark_summary.csv": "metric_recompute"
  },
  "output_contract": {
    "outputs": [
      {
        "file": "sin_optimized.xyz",
        "format": "other",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "other",
          "description": "Standard XYZ file; see step output_schema."
        },
        "description": "The checker parses this file to extract the Si–N bond length (in Å) and compares it to the hidden reference value within tolerances."
      },
      {
        "file": "sin_frequencies.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "text",
          "description": "One frequency per line; see step output_schema."
        },
        "description": "The checker reads all frequencies and compares them to the hidden reference frequencies within tolerances."
      },
      {
        "file": "sin2_optimized.xyz",
        "format": "other",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "other",
          "description": "Standard XYZ file; see step output_schema."
        },
        "description": "The checker extracts the Si–N and N–N bond distances and compares them to the hidden reference values."
      },
      {
        "file": "sin2_frequencies.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "text",
          "description": "Three frequencies; see step output_schema."
        },
        "description": "The checker compares the reported frequencies to the hidden reference values."
      },
      {
        "file": "si2n_optimized.xyz",
        "format": "other",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "other",
          "description": "Standard XYZ file; see step output_schema."
        },
        "description": "The checker extracts the Si–N bond distance and compares it to the hidden reference value."
      },
      {
        "file": "si2n_frequencies.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "text",
          "description": "Three frequencies; see step output_schema."
        },
        "description": "The checker compares the reported frequencies to the hidden reference values."
      },
      {
        "file": "benchmark_summary.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "system",
            "r_SiN",
            "r_NN",
            "freq1",
            "freq2",
            "freq3"
          ],
          "units": {
            "r_SiN": "Å",
            "r_NN": "Å",
            "freq1": "cm⁻¹",
            "freq2": "cm⁻¹",
            "freq3": "cm⁻¹"
          }
        },
        "description": "The checker verifies internal consistency (CSV values match those extracted from the raw XYZ/txt files) and then compares the reported bond lengths and frequencies to the paper’s hidden reference values within tolerances."
      }
    ],
    "notes": "The solver must use an open‑source quantum‑chemistry package (ORCA, Psi4, PySCF …). All geometries are standard linear isomers as described. The hidden checker does NOT require exact reproduction of the paper’s output; tolerances account for typical implementation‑induced variations in DFT results (~±0.01 Å for bond lengths, ~±15 cm⁻¹ for frequencies)."
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold equilibrium bond distances and harmonic frequencies for SiN, SiN2, Si2N at B3LYP/6-311G(d) from paper Tables 1, 4, and 6.",
      "source_provenance": "Paper: A theoretical study of the structures and electronic transitions of small silicon nitride clusters (SinNm, n+m ≤ 4), Tables 1, 4, 6. Values: SiN r_e=1.5736 Å, ω_e=1181.19 cm⁻¹; SiN2 r(NN)=1.1459 Å, r(SiN)=1.7559 Å, ω=(1825.85, 328.63, 515.30 cm⁻¹); Si2N r(SiN)=1.6400 Å, ω=(615.76, 172.45, 1065.53 cm⁻¹).",
      "generation_method": "Directly transcribed from the paper.",
      "why_not_fabricated": "These are the exact numerical results reported in the paper for the specific method/basis set, confirmed against the reference solve.sh which writes exactly these numbers."
    }
  ],
  "steps": [
    {
      "id": "check_sin_geometry",
      "output_file": "sin_optimized.xyz",
      "weight": 0.1,
      "kind": "recompute_bond_length",
      "params": {
        "bonds": [
          {
            "atom1": "Si",
            "atom2": "N",
            "gold": 1.5736,
            "tol": 0.01
          }
        ]
      }
    },
    {
      "id": "check_sin_freq",
      "output_file": "sin_frequencies.txt",
      "weight": 0.1,
      "kind": "recompute_frequency",
      "params": {
        "freqs_gold": [
          1181.19
        ],
        "tol_freq": 15.0
      }
    },
    {
      "id": "check_sin2_geometry",
      "output_file": "sin2_optimized.xyz",
      "weight": 0.2,
      "kind": "recompute_bond_length",
      "params": {
        "bonds": [
          {
            "atom1": "Si",
            "atom2": "N",
            "gold": 1.7559,
            "tol": 0.01,
            "pos": [
              0,
              1
            ]
          },
          {
            "atom1": "N",
            "atom2": "N",
            "gold": 1.1459,
            "tol": 0.01,
            "pos": [
              1,
              2
            ]
          }
        ]
      }
    },
    {
      "id": "check_sin2_freq",
      "output_file": "sin2_frequencies.txt",
      "weight": 0.2,
      "kind": "recompute_frequency",
      "params": {
        "freqs_gold": [
          328.63,
          515.3,
          1825.85
        ],
        "tol_freq": 15.0
      }
    },
    {
      "id": "check_si2n_geometry",
      "output_file": "si2n_optimized.xyz",
      "weight": 0.1,
      "kind": "recompute_bond_length",
      "params": {
        "bonds": [
          {
            "atom1": "Si",
            "atom2": "N",
            "gold": 1.64,
            "tol": 0.01,
            "pos": [
              [
                0,
                1
              ],
              [
                2,
                1
              ]
            ]
          }
        ]
      }
    },
    {
      "id": "check_si2n_freq",
      "output_file": "si2n_frequencies.txt",
      "weight": 0.2,
      "kind": "recompute_frequency",
      "params": {
        "freqs_gold": [
          172.45,
          615.76,
          1065.53
        ],
        "tol_freq": 15.0
      }
    },
    {
      "id": "check_consistency",
      "output_file": "benchmark_summary.csv",
      "weight": 0.1,
      "kind": "structural_audit",
      "params": {
        "systems": [
          {
            "system": "SiN",
            "xyz_file": "sin_optimized.xyz",
            "bonds": [
              {
                "csv_col": "r_SiN",
                "xyz_indices": [
                  0,
                  1
                ]
              }
            ],
            "freq_file": "sin_frequencies.txt",
            "freq_csv_cols": [
              "freq1"
            ]
          },
          {
            "system": "SiN2",
            "xyz_file": "sin2_optimized.xyz",
            "bonds": [
              {
                "csv_col": "r_SiN",
                "xyz_indices": [
                  0,
                  1
                ]
              },
              {
                "csv_col": "r_NN",
                "xyz_indices": [
                  1,
                  2
                ]
              }
            ],
            "freq_file": "sin2_frequencies.txt",
            "freq_csv_cols": [
              "freq1",
              "freq2",
              "freq3"
            ]
          },
          {
            "system": "Si2N",
            "xyz_file": "si2n_optimized.xyz",
            "bonds": [
              {
                "csv_col": "r_SiN",
                "xyz_indices": [
                  0,
                  1
                ]
              }
            ],
            "freq_file": "si2n_frequencies.txt",
            "freq_csv_cols": [
              "freq1",
              "freq2",
              "freq3"
            ]
          }
        ],
        "tight_bond_tol": 0.001,
        "tight_freq_tol": 0.1
      }
    }
  ]
}