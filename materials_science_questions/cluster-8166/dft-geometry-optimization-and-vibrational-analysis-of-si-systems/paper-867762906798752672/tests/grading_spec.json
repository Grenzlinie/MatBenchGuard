{
  "scoring_tier": "structural",
  "scoring_justification": "Headline quantities (MSD, H-H distance) are produced by full DFT-MD runs; the verifier cannot recompute them from raw trajectories (not submitted) and the public instruction scores by physical consistency criteria (enhancement trend, plausible bond distance range) rather than exact match to paper values.",
  "pass_threshold": 0.6,
  "hidden_assets": [],
  "output_contract": {
    "outputs": [
      {
        "file": "simulation_log.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "text",
          "required": {
            "keywords": [
              "atom count",
              "temperature",
              "timestep",
              "steps",
              "pseudopotential",
              "functional",
              "ground-state MD performed",
              "light-excited MD performed"
            ]
          }
        },
        "description": "Metadata log confirming simulation parameters and executed MD runs."
      },
      {
        "file": "msd_results.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "text",
          "required": {
            "lines": [
              "ground_state_msd: <float> Ang^2",
              "light_excited_msd: <float> Ang^2"
            ]
          }
        },
        "description": "Time-averaged mean squared displacement of H atoms; must show light_excited_msd > ground_state_msd."
      },
      {
        "file": "sih2_hh_distance.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "text",
          "required": {
            "lines": [
              "SiH2_HH_distance: <float> Ang"
            ]
          }
        },
        "description": "Reported H-H distances for any SiH2 dihydride units; at least one line required with a distance in plausible range (2.2–2.6 Å)."
      }
    ],
    "notes": "Scoring is structural: msd_results.txt checked for enhancement (light > ground), sih2_hh_distance.txt checked for presence and plausible H-H distance range, simulation_log.txt audited for required keywords. No exact value match to the paper is required."
  },
  "steps": [
    {
      "id": "simulation_log_check",
      "output_file": "simulation_log.txt",
      "kind": "structural_audit",
      "weight": 0.1,
      "target_policy": "structural_audit",
      "required_keywords": [
        "atom count",
        "temperature",
        "timestep",
        "steps",
        "pseudopotential",
        "functional",
        "ground-state MD performed",
        "light-excited MD performed"
      ]
    },
    {
      "id": "msd_check",
      "output_file": "msd_results.txt",
      "kind": "structural_audit",
      "weight": 0.5,
      "target_policy": "structural_audit",
      "expect_positive": true,
      "expect_enhancement": true
    },
    {
      "id": "sih2_check",
      "output_file": "sih2_hh_distance.txt",
      "kind": "structural_audit",
      "weight": 0.4,
      "target_policy": "structural_audit",
      "min_distance": 2.2,
      "max_distance": 2.6,
      "required_min_count": 1
    }
  ]
}