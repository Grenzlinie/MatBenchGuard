        "description": "Ideal tensile strength and strain at failure for the [100] direction from DFT stress‑strain simulation."
      },
      {
        "file": "step_05_phonon_frequencies.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
