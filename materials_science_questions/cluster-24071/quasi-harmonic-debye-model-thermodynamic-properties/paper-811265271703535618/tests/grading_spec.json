            "c(Å)": "angstrom",
            "Ef(kJ/mol)": "kJ/mol"
          }
        },
        "description": "Equilibrium lattice parameters and formation enthalpy per atom. The b column may be empty for cubic/tetragonal systems."
      },
      {
