  "target_policies": {
    "step_01_e_v_data.csv": "metric_recompute",
    "step_02_dielectric_function.csv": "metric_recompute",
    "step_03_thermal_properties.csv": "metric_recompute",
    "results.json": "reference_match"
  },
  "hidden_assets": [
