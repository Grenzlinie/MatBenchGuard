{
  "scoring_tier": "recompute",
  "scoring_justification": "Checker recomputes closeness of submitted numeric values to paper-reported gold values using tolerance comparisons; a full recompute from raw simulation logs is infeasible because the verifier sandbox cannot redo the heavy RIP model minimization. This is a legitimate fallback (T0) with a real hidden gold (paper tables).",
  "pass_threshold": 0.6,
  "target_policies": {
    "transition_pressures_volume_drops.csv": "reference_match",
    "elastic_properties.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold reference values for transition pressures, volume drops, and elastic properties extracted directly from the paper's Tables 2 and 3.",
      "source_provenance": "paper/paper.md Tables 2 and 3, columns 'Present' for the model.",
      "generation_method": "Extracted from the paper markdown and verified against the reference solver (solution/solve.sh).",
      "why_not_fabricated": "Values are the paper's own published numerical results, used as hidden gold for the reproduction target."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "transition_pressures_volume_drops.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "compound",
            "temperature_K",
            "transition_pressure_GPa",
            "volume_drop_percent"
          ],
          "columns": {
            "compound": "string",
            "temperature_K": "int",
            "transition_pressure_GPa": "float",
            "volume_drop_percent": "float"
          }
        },
        "description": "Computed structural phase transition pressures (GPa) and volume drops (%) for LaS and PrS at T=0K and T=300K."
      },
      {
        "file": "elastic_properties.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "compound",
            "temperature_K",
            "property",
            "value"
          ],
          "columns": {
            "compound": "string",
            "temperature_K": "int",
            "property": "string",
            "value": "float"
          }
        },
        "description": "Computed second‑order elastic constants and derived mechanical properties. Possible property names: C11, C12, C44, Y, BT, G, CS, CL, A, zeta, sigma, nu_l, nu_t, nu_m, dBT_dP, dCS_dP, dC44_dP, C12_minus_C44, BT_over_G, s1, s2, s3, F12, F44. Units: elastic moduli in GPa, velocities in m/s, others dimensionless."
      }
    ],
    "notes": "The agent must implement the full RIP model from scratch. Input constants (lattice constants, bulk moduli, ionic radii) are listed in the paper’s Table 1 and should be hard‑coded. Only pure LaS and PrS are required; mixed‑concentration alloys are excluded."
  },
  "steps": [
    {
      "id": "check_transition_table",
      "output_file": "transition_pressures_volume_drops.csv",
      "weight": 0.4,
      "target_policy": "reference_match",
