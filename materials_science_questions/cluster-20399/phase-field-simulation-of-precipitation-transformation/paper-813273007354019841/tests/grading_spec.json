{
  "scoring_tier": "recompute",
  "scoring_justification": "Gibbs-Thomson slope and LSW rate constants are recomputed from the agent's raw data arrays, and PSD peak location is extracted from binned distributions; all comparisons use hidden reference values derived from the paper.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold Gibbs-Thomson slope, K values, PSD peak positions",
      "source_provenance": "paper Equations (14), Table 3, Fig. 5 (slope), and Fig. 7/Fig. 8 (K and PSD peaks); slope computed from γ=0.41 J/m², ξ_p=3.42×10¹¹ J/m³, Δc_eq≈1.0; K values taken from paper text; PSD peaks estimated from mean radii at t=175 s scaled by LSW peak-to-mean ratio.",
      "generation_method": "analytical from paper parameters; PSD peaks approximated as 0.95×mean radius at end.",
      "why_not_fabricated": "all quantities are traceable to the paper and are the same conditions the agent must reproduce"
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "simulation_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "gibbs_thomson",
            "coarsening_5at",
            "coarsening_10at",
            "K_5at",
            "K_10at",
            "PSD_5at_start",
            "PSD_5at_end",
            "PSD_10at_start",
            "PSD_10at_end"
          ],
          "properties": {
