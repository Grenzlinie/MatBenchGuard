  "steps": [
    {
      "id": "gibbs_thomson_slope",
      "output_file": "simulation_results.json",
      "weight": 0.2,
      "kind": "recompute_metric",
      "target": 0.0024,
      "tolerance": 0.00024,
      "description": "Recalc linear regression slope of delta_cp vs curvature_1_nm"
    },
    {
      "id": "coarsening_K_5at",
      "output_file": "simulation_results.json",
      "weight": 0.3,
      "kind": "recompute_metric",
      "target": 0.1024,
      "tolerance": 0.03,
      "description": "Fit K from mean_radius_nm^3 vs time_s for 5at% Cu"
    },
    {
      "id": "coarsening_K_10at",
