{
  "scoring_tier": "structural",
  "scoring_justification": "Recompute of DFT raw files is infeasible in the verifier sandbox; structural properties (trend) and numeric tolerances against hidden paper gold are validated.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper-reported LSDA+U lattice constants a, c and LSDA+U+SO total spin magnetic moments for RE5Ge3 compounds.",
      "source_provenance": "Table 1 (LSDA+U) and Table 2 (LSDA+U+SO) of the paper 'Ab initio study of electronic and magnetic structure of intermetallic RE5Ge3 compounds', Modern Physics Letters B 25, 2427 (2011), DOI:10.1142/S0217984911027649.",
      "generation_method": "Values transcribed directly from the paper's published tables.",
      "why_not_fabricated": "These are the exact numbers the paper reports as its computational results; they provide the gold reference for a correct reproduction."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": {
            "compounds": "array of per-compound objects"
          },
          "items": {
            "name": "string",
            "a": "number (Å)",
            "c": "number (Å)",
            "total_magnetic_moment": "number (μB)"
          },
          "units": {
            "a": "Å",
            "c": "Å",
            "total_magnetic_moment": "μB"
          }
        },
        "description": "Scored artifact: equilibrium lattice parameters a, c from LSDA+U relaxation, and total spin magnetic moment from LSDA+U+SO for each compound. Checker compares a and c to paper reference within 2% relative tolerance, magnetic moments within absolute tolerances and monotonic trend Ce<Pr<Nd."
      }
    ],
    "notes": "All values must be derived from the described first-principles workflow; no external lookup of reference numbers is required or intended. The checker will perform a result-level comparison using hidden gold values from the paper."
  },
  "steps": [
    {
      "id": "file_check",
      "output_file": "results.json",
      "kind": "structural_audit",
      "weight": 0.05,
      "description": "Validate that results.json contains a 'compounds' list with exactly 4 entries."
    },
    {
      "id": "lattice_a_La5Ge3",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.05,
      "compound": "La5Ge3",
      "property": "a",
      "target": 8.872,
      "tolerance_rel": 0.02,
      "description": "Lattice a for La5Ge3 within 2%."
    },
    {
      "id": "lattice_c_La5Ge3",
