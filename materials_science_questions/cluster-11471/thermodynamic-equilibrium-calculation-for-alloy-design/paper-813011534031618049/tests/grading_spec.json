    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference three‑phase region boundaries, solidification step sequences, and driving forces",
      "source_provenance": "Paper Table 1 and the results reported in Sections 3 and 4; oracle solve.sh hardcodes them to match the paper.",
      "generation_method": "Directly copied from the paper’s described phase sequences and driving force values; the oracle wrote the same values to ensure checker/oracle consistency.",
      "why_not_fabricated": "These are the quantities the paper originally reported (digitized from Table 1 and text) and they serve as the reference for the reproduction task."
    }
  ],
