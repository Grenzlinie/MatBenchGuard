{
  "scoring_tier": "structural",
  "scoring_justification": "Full recompute from the agent's raw numbers is infeasible without rerunning pycalphad with the thermodynamic database, which is heavy and version‑sensitive. Instead the checker verifies structural properties (eutectic colony presence/absence) and compares the submitted values to the paper‑derived reference with generous tolerances, meeting the D4 structural standard.",
  "pass_threshold": 0.6,
  "target_policies": {
    "phase_diagrams.json": "reference_match",
    "solidification_steps.csv": "structural_audit",
    "driving_force_interface.csv": "reference_match"
  },
