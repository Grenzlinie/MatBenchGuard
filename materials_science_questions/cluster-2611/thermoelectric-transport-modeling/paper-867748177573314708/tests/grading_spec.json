{
  "scoring_tier": "result_compare",
  "scoring_justification": "Full DFT and Boltzmann transport recomputation is infeasible in the verifier sandbox; the checker compares agent-reported summary values to paper hidden gold with tolerances and threshold_or_better monotonic scoring.",
  "pass_threshold": 0.6,
  "target_policies": {
    "puckering_critical_distances.json": "exact_match",
    "electronic_properties.json": "threshold_or_better",
    "thermopower_summary.json": "threshold_or_better"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold values for puckering distances, band gaps, Seebeck coefficients and bipolar flag.",
      "source_provenance": "Paper main text, Fig.4, Fig.6 and supplemental document Fig.1 caption: d_metal_semimetal=0.06 Å, d_semimetal_semiconductor=0.7 Å; band gaps from Fig.4 text; thermopower peaks from Fig.6 text (500-600 μV/K, ~300 μV/K, low Bi value).",
      "generation_method": "Values extracted from the paper; match the reference solve.sh.",
      "why_not_fabricated": "All gold values are directly quoted from numerical statements in the paper (0.06/0.7 Å, 0.99/0.85/0.46 eV…, 500-600 μV/K…)."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "puckering_critical_distances.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": [
            "d_metal_semimetal_A",
            "d_semimetal_semiconductor_A"
          ],
          "properties": {
            "d_metal_semimetal_A": {
              "type": "number",
              "unit": "angstrom"
            },
            "d_semimetal_semiconductor_A": {
              "type": "number",
              "unit": "angstrom"
            }
          }
        },
        "description": "Critical puckering displacement distances for Sb monolayer, where the transitions metal→semimetal and semimetal→semiconductor occur."
      },
      {
        "file": "electronic_properties.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": [
            "As",
            "Sb",
            "Bi"
          ],
          "properties": {
            "As": {
              "type": "object",
              "required": [
                "direct_gap_no_SOI_eV",
                "direct_gap_with_SOI_eV",
                "SOI_gap_at_DP_eV"
              ],
              "properties": {
                "direct_gap_no_SOI_eV": {
                  "type": "number",
                  "unit": "eV"
                },
                "direct_gap_with_SOI_eV": {
                  "type": "number",
                  "unit": "eV"
                },
                "SOI_gap_at_DP_eV": {
                  "type": "number",
                  "unit": "eV"
                }
              }
            },
            "Sb": {
              "type": "object",
              "required": [
                "direct_gap_no_SOI_eV",
                "direct_gap_with_SOI_eV",
                "SOI_gap_at_DP_eV"
              ],
              "properties": {
                "direct_gap_no_SOI_eV": {
                  "type": "number",
                  "unit": "eV"
                },
                "direct_gap_with_SOI_eV": {
                  "type": "number",
                  "unit": "eV"
                },
                "SOI_gap_at_DP_eV": {
                  "type": "number",
                  "unit": "eV"
                }
              }
            },
            "Bi": {
              "type": "object",
              "required": [
                "direct_gap_no_SOI_eV",
                "direct_gap_with_SOI_eV",
                "SOI_gap_at_DP_eV"
              ],
              "properties": {
                "direct_gap_no_SOI_eV": {
                  "type": "number",
                  "unit": "eV"
                },
                "direct_gap_with_SOI_eV": {
                  "type": "number",
                  "unit": "eV"
                },
                "SOI_gap_at_DP_eV": {
                  "type": "number",
                  "unit": "eV"
                }
              }
            }
          }
        },
        "description": "Direct band gaps at Γ (with and without spin‑orbit coupling) and the SOI‑induced gap at the upper Dirac point for As, Sb, Bi puckered monolayers."
      },
      {
        "file": "thermopower_summary.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": [
            "As",
            "Sb",
            "Bi"
          ],
          "properties": {
            "As": {
              "type": "object",
              "required": [
                "peak_p_type_Seebeck_uV_per_K",
                "peak_n_type_Seebeck_uV_per_K"
              ],
              "properties": {
                "peak_p_type_Seebeck_uV_per_K": {
                  "type": "number",
                  "unit": "µV/K"
                },
                "peak_n_type_Seebeck_uV_per_K": {
                  "type": "number",
                  "unit": "µV/K"
                }
              }
            },
            "Sb": {
              "type": "object",
              "required": [
                "peak_p_type_Seebeck_uV_per_K",
                "peak_n_type_Seebeck_uV_per_K"
              ],
              "properties": {
                "peak_p_type_Seebeck_uV_per_K": {
                  "type": "number",
                  "unit": "µV/K"
                },
                "peak_n_type_Seebeck_uV_per_K": {
                  "type": "number",
                  "unit": "µV/K"
                }
              }
            },
            "Bi": {
              "type": "object",
              "required": [
                "peak_p_type_Seebeck_uV_per_K",
                "bipolar_suppression_observed"
              ],
              "properties": {
                "peak_p_type_Seebeck_uV_per_K": {
                  "type": "number",
                  "unit": "µV/K"
                },
                "bipolar_suppression_observed": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "description": "Peak Seebeck coefficients for p‑type and n‑type carriers in As, Sb, peak p‑type Seebeck coefficient in Bi, and a flag indicating whether bipolar suppression is observed in Bi."
      }
    ],
    "notes": "SbAs and BiSb are not included as scored targets; the paper's main thermoelectric and puckering results are for the pure group‑V monolayers. The omitted binaries are not required for the core reproduction and their absence does not degrade the verifiability of the principal claims."
  },
  "steps": [
    {
      "id": "step2",
      "output_file": "puckering_critical_distances.json",
      "kind": "numeric",
      "weight": 0.1,
      "thresholds": {
        "d_metal_semimetal_A": {
          "value": 0.06,
          "abs_tol": 0.02
        },
        "d_semimetal_semiconductor_A": {
          "value": 0.7,
          "abs_tol": 0.1
        }
      }
    },
    {
      "id": "step4",
      "output_file": "electronic_properties.json",
      "kind": "numeric",
      "weight": 0.3,
      "thresholds": {
        "As": {
          "direct_gap_no_SOI_eV": {
            "value": 0.99,
            "abs_tol": 0.15
          },
          "direct_gap_with_SOI_eV": {
            "value": 0.98,
            "abs_tol": 0.15
          },
          "SOI_gap_at_DP_eV": {
            "value": 0.001,
            "abs_tol": 0.002
          }
        },
        "Sb": {
          "direct_gap_no_SOI_eV": {
            "value": 0.85,
            "abs_tol": 0.15
          },
          "direct_gap_with_SOI_eV": {
            "value": 0.69,
            "abs_tol": 0.15
          },
          "SOI_gap_at_DP_eV": {
            "value": 0.1,
            "abs_tol": 0.03
          }
        },
        "Bi": {
          "direct_gap_no_SOI_eV": {
            "value": 0.46,
            "abs_tol": 0.15
          },
          "direct_gap_with_SOI_eV": {
            "value": 0.095,
            "abs_tol": 0.05
          },
          "SOI_gap_at_DP_eV": {
            "value": 1.0,
            "abs_tol": 0.25
          }
        }
      }
    },
    {
      "id": "step6",
      "output_file": "thermopower_summary.json",
      "kind": "numeric",
      "weight": 0.6,
      "thresholds": {
        "As": {
          "peak_p_type_Seebeck_uV_per_K": {
            "value": 500,
            "better_direction": "greater"
          },
          "peak_n_type_Seebeck_uV_per_K": {
            "value": 300,
            "better_direction": "greater"
          }
        },
        "Sb": {
          "peak_p_type_Seebeck_uV_per_K": {
            "value": 500,
            "better_direction": "greater"
          },
          "peak_n_type_Seebeck_uV_per_K": {
            "value": 300,
            "better_direction": "greater"
          }
        },
        "Bi": {
          "peak_p_type_Seebeck_uV_per_K": {
            "value": 200,
            "better_direction": "less"
          },
          "bipolar_suppression_observed": {
            "expected": true
          }
        }
      }
    }
  ]
}