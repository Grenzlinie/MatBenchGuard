            "C44_GPa": "GPa",
            "B_GPa": "GPa",
            "G_GPa": "GPa",
            "Y_GPa": "GPa",
            "B_G_ratio": "dimensionless",
            "nu": "dimensionless",
            "A": "dimensionless"
          }
