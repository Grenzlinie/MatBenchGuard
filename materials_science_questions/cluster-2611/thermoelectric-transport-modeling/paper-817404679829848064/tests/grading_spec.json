{
  "scoring_tier": "structural",
  "scoring_justification": "Full recomputation of transport properties from raw DFT outputs is infeasible in the verifier sandbox; scoring relies on structural consistency checks (sign, monotonic trends, ordering) and comparison with paper-reported reference values within tolerances.",
  "pass_threshold": 0.6,
