{
  "scoring_tier": "structural",
  "scoring_justification": "Seebeck step uses structural checks (sign, magnitude) because recomputing from band structure in the checker would require running BoltzTraP2, and the paper does not tabulate the GGA Seebeck values.",
  "pass_threshold": 0.6,
  "target_policies": {
    "band_gaps.json": "reference_match",
    "seebeck_coefficient.csv": "structural_audit"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold band gap values for comparison",
      "source_provenance": "paper text describing GGA band gaps",
      "generation_method": "extracted directly from paper's 'Band Structure' section",
      "why_not_fabricated": "These are the actual reported GGA gaps."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "band_gaps.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "compound",
              "indirect_gap_eV",
              "direct_gap_eV"
            ],
            "properties": {
              "compound": {
                "type": "string"
              },
              "indirect_gap_eV": {
                "type": "number",
                "unit": "eV"
              },
              "direct_gap_eV": {
                "type": "number",
                "unit": "eV"
              }
            }
          }
        },
        "description": "Indirect and direct band gaps (GGA) for OsP2, OsAs2, OsSb2."
      },
      {
        "file": "seebeck_coefficient.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "temperature_K",
            "seebeck_uV_K",
            "compound",
            "carrier_type",
            "carrier_concentration_cm3"
          ],
          "units": {
            "temperature_K": "K",
            "seebeck_uV_K": "uV/K",
            "carrier_concentration_cm3": "cm^{-3}"
          }
        },
        "description": "Seebeck coefficient vs temperature for n- and p-type doping at three carrier concentrations."
      }
    ],
    "notes": "The checker will compare reported band gaps and Seebeck curves against the paper's GGA values and Figure 10, respectively, with appropriate tolerances. The Seebeck step is load-bearing to ensure genuine DFT execution."
  },
  "steps": [
    {
      "id": "step04_band_gaps",
      "output_file": "band_gaps.json",
      "kind": "numeric",
      "weight": 0.3,
      "gold": {
        "OsP2": {
          "indirect": 0.78,
          "direct": 1.03
        },
        "OsAs2": {
          "indirect": 0.71,
          "direct": 0.9
        },
        "OsSb2": {
          "indirect": 0.33,
          "direct": 0.75
        }
      },
      "tolerances": {
        "indirect": 0.05,
        "direct": 0.1
      }
    },
    {
      "id": "step05_seebeck",
      "output_file": "seebeck_coefficient.csv",
      "kind": "structural",
      "weight": 0.7,
      "sign_check": true,
      "min_magnitude": 50
    }
  ]
}