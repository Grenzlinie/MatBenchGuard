{
  "scoring_tier": "recompute",
  "scoring_justification": "Seebeck coefficient is recomputed from E_Fermi; CTP frequencies are spot‐checked against paper value and verified for monotonic trends; effective masses, phonon conductivity and ZT are compared to paper‐reported numbers with tolerances. Full recompute from raw DFTB+ band structure is infeasible in the verifier sandbox.",
  "pass_threshold": 0.6,
  "target_policies": {
    "eff_masses.json": "exact_match",
    "ctp_frequencies.csv": "structural_audit",
    "seebeck.csv": "metric_recompute",
    "chi_vibr.json": "exact_match",
    "zt.csv": "structural_audit"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper‐reported numeric results for effective masses, Fermi energies, Seebeck coefficients, phonon conductivity, ZT values, and a CTP spot frequency",
      "source_provenance": "Extracted from the paper text: m_eff polyacetylene=0.455, polypyrrole=0.502, polythiophene=0.446 (m_e); E_Fermi polyacetylene=0.04069 eV, polypyrrole=0.01727 eV, polythiophene=0.01822 eV; Seebeck {90,212,201} µV/K; χ_vibr=0.77 W/(m·K); ZT {0.08,0.45,0.40}; CTP frequency polyacetylene at R=7.41 Å ≈0.73 eV.",
      "generation_method": "Copied directly from the paper’s stated numbers.",
      "why_not_fabricated": "These are the paper’s own reported results that the reproduction aims to match."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "eff_masses.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": [
            "polyacetylene",
            "polypyrrole",
            "polythiophene"
          ],
          "properties": {
            "polyacetylene": {
              "type": "object",
              "required": [
                "m_eff",
                "E_Fermi"
              ],
              "properties": {
                "m_eff": {
                  "type": "number",
                  "description": "effective mass relative to free electron mass"
                },
                "E_Fermi": {
                  "type": "number",
                  "description": "Fermi energy in eV, measured from conduction band bottom"
                }
              }
            },
            "polypyrrole": {
              "type": "object",
              "required": [
                "m_eff",
                "E_Fermi"
              ],
              "properties": {
                "m_eff": {
                  "type": "number",
                  "description": "effective mass relative to free electron mass"
                },
                "E_Fermi": {
                  "type": "number",
                  "description": "Fermi energy in eV"
                }
              }
            },
            "polythiophene": {
              "type": "object",
              "required": [
                "m_eff",
                "E_Fermi"
              ],
              "properties": {
                "m_eff": {
                  "type": "number",
                  "description": "effective mass relative to free electron mass"
                },
                "E_Fermi": {
                  "type": "number",
                  "description": "Fermi energy in eV"
                }
              }
            }
          }
        },
        "description": "Effective electron masses and Fermi energies extracted from SCC-DFTB band structures for the three nanoparticle-bridge systems."
      },
      {
        "file": "ctp_frequencies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "table",
          "required_columns": [
            "bridge",
            "R_angstrom",
            "frequency_eV"
          ],
          "units": {
            "R_angstrom": "Å",
            "frequency_eV": "eV"
          }
        },
        "description": "Charge-transfer plasmon frequencies computed from the analytical model for each bridge type at five nanoparticle radii (4.69, 7.41, 10.0, 12.0, 14.0 Å)."
      },
      {
        "file": "seebeck.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "bridge",
            "S_uV_per_K"
          ],
          "units": {
            "S_uV_per_K": "µV/K"
          }
        },
        "description": "Seebeck coefficients (thermopower) for the three bridge systems at 300 K, obtained from the universal 1D equation."
      },
      {
        "file": "chi_vibr.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": [
            "chi_vibr_W_per_mK"
          ],
          "properties": {
            "chi_vibr_W_per_mK": {
              "type": "number",
              "description": "phonon thermal conductivity in W/(m·K)"
            }
          }
        },
        "description": "Phonon (lattice) thermal conductivity of the Au309-polyacetylene periodic chain from LAMMPS molecular dynamics."
      },
      {
        "file": "zt.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "table",
          "required_columns": [
            "bridge",
            "ZT"
          ],
          "units": {
            "ZT": "dimensionless"
          }
        },
        "description": "Thermoelectric figure of merit ZT for the three periodic systems at 300 K, combining electrical quantum conductance, Seebeck coefficient, and total thermal conductivity."
      }
    ],
    "notes": "The verification compares the effective masses, CTP frequency for polyacetylene at R=7.41 Å, Seebeck coefficients, phonon thermal conductivity, and ZT values to expected ranges; it also checks overall physical consistency."
  },
  "steps": [
    {
      "id": "eff_masses_check",
      "output_file": "eff_masses.json",
      "weight": 0.25,
      "kind": "numeric",
      "target_policy": "exact_match",
      "target": {
        "polyacetylene": {
          "m_eff": 0.455,
          "E_Fermi": 0.04069
        },
        "polypyrrole": {
          "m_eff": 0.502,
          "E_Fermi": 0.01727
        },
        "polythiophene": {
          "m_eff": 0.446,
          "E_Fermi": 0.01822
        }
      },
      "tolerances": {
        "m_eff": 0.02,
        "E_Fermi": 0.005
      }
    },
    {
      "id": "ctp_frequencies_check",
      "output_file": "ctp_frequencies.csv",
      "weight": 0.2,
      "kind": "structural_audit",
      "target_policy": "structural_audit",
      "spot_check": {
        "bridge": "polyacetylene",
        "R": 7.41,
        "target": 0.73,
        "tolerance": 0.1
      },
      "monotonic_decrease": true,
      "cross_bridge_ordering": true
    },
    {
      "id": "seebeck_check",
      "output_file": "seebeck.csv",
      "weight": 0.1,
      "kind": "recompute_metric",
      "target_policy": "metric_recompute",
      "recompute_from": "eff_masses.json",
      "tolerance_pct": 5
    },
    {
      "id": "chi_vibr_check",
      "output_file": "chi_vibr.json",
      "weight": 0.1,
      "kind": "numeric",
      "target_policy": "exact_match",
      "target": 0.77,
      "tolerance": 0.1
    },
    {
      "id": "zt_check",
      "output_file": "zt.csv",
      "weight": 0.35,
      "kind": "structural_audit",
      "target_policy": "structural_audit",
      "ranges": {
        "polyacetylene": [
          0.0,
          0.2
        ],
        "polypyrrole": [
          0.3,
          0.6
        ],
        "polythiophene": [
          0.3,
          0.5
        ]
      },
      "trend": "polypyrrole > polythiophene > polyacetylene"
    }
  ]
}