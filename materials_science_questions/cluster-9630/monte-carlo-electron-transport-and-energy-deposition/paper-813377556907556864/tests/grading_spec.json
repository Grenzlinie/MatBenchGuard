{
  "scoring_tier": "structural",
  "scoring_justification": "Absolute scission yields are not tabulated and vary with Monte‐Carlo implementation. The paper’s reproduction targets are the ordering ZEP1>ZEP2>PMMA and the ZEP‑1/ZEP‑2 ratio range (≈4‑6), which are verifiable without exact absolute gold.",
  "pass_threshold": 0.8,
  "target_policies": {
    "scission_yields.json": "structural_audit"
  },
  "hidden_assets": [],
  "output_contract": {
    "outputs": [
      {
        "file": "scission_yields.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "yields",
            "ratios"
          ],
          "yields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "resist",
                "voltage_keV",
                "dose_pC_per_cm",
                "position",
                "scission_yield"
              ],
              "properties": {
                "resist": {
                  "type": "string"
                },
                "voltage_keV": {
                  "type": "integer"
                },
                "dose_pC_per_cm": {
                  "type": "number"
                },
                "position": {
                  "type": "string",
                  "enum": [
                    "center",
                    "edge"
                  ]
                },
                "scission_yield": {
                  "type": "number"
                }
              }
            }
          },
          "ratios": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "voltage_keV",
                "position",
                "ratio"
              ],
              "properties": {
                "voltage_keV": {
                  "type": "integer"
                },
                "position": {
                  "type": "string",
                  "enum": [
                    "center",
                    "edge"
                  ]
                },
                "ratio": {
                  "type": "number"
                }
              }
            }
          }
        },
        "description": "Scission yields at half-depth of 55 nm resist for 70 nm pitch grating at center and edge; doses: 3 keV/40 pC/cm, 10 keV/90 pC/cm, 30 keV/350 pC/cm."
      }
    ],
    "notes": "Only the specified energies, doses, and positions are scored. The yields are dimensionless scissions per monomer. The ratio ZEP-1/ZEP-2 is also provided."
  },
  "steps": [
    {
      "id": "array_shape",
      "output_file": "scission_yields.json",
      "kind": "file_exists",
      "weight": 0.05,
      "target_policy": "structural_audit"
    },
    {
      "id": "ordering",
      "output_file": "scission_yields.json",
      "kind": "structural",
      "weight": 0.4,
      "description": "Verify that for each voltage (3,10,30) and position (center,edge), ZEP Model 1 yield > ZEP Model 2 yield > PMMA yield."
    },
    {
      "id": "ratio_range",
      "output_file": "scission_yields.json",
      "kind": "rubric",
      "weight": 0.4,
      "params": {
        "ratio_min": 3.0,
        "ratio_max": 7.0
      },
      "description": "Verify that each ZEP‑1/ZEP‑2 ratio in the ratios array lies within [3.0, 7.0]."
    },
    {
      "id": "self_consistency",
      "output_file": "scission_yields.json",
      "kind": "consistency",
      "weight": 0.15,
      "description": "Check that the reported ratios are consistent with the yields (difference < 0.2)."
    }
  ]
}