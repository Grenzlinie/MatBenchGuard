{
  "scoring_tier": "result_level_compare",
  "scoring_justification": "The agent's MD simulation results cannot be recomputed in the verifier sandbox; we therefore compare the agent-reported per-model averages to paper-derived reference values with tolerance and enforce the required monotonic trend (quenched > 25ns).",
  "pass_threshold": 0.6,
  "target_policies": {
    "step_3_results.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold targets for quenched and 25ns PCG fracture properties and PFC counts",
      "source_provenance": "Derived from Fig. 3B-D (failure strain, failure stress, fracture energy vs annealing time), Fig. 5A (PFC counts vs annealing time), and the reported average first-nanocrack strain 0.073 and stress 43.41 GPa (Fig. 5A text).",
      "generation_method": "Estimated by reading values at 0 ns and 25 ns from the paper's plots and cross-checked with the typical values used in the reference oracle solve.sh to ensure full-reward reachability.",
      "why_not_fabricated": "Values correspond to the paper's published data points for the two specific annealing states, not arbitrary numbers."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "step_3_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "model",
            "direction",
            "failure_strain",
            "failure_stress",
            "fracture_energy",
            "number_of_PFCs",
            "strain_first_nanocrack",
            "stress_first_nanocrack"
          ],
          "units": {
            "failure_strain": "dimensionless",
            "failure_stress": "GPa",
            "fracture_energy": "GPa",
            "strain_first_nanocrack": "dimensionless",
            "stress_first_nanocrack": "GPa"
          }
        },
        "description": "Per-run fracture metrics from uniaxial tensile tests for the two polycrystalline graphene models. The checker will compute per-model averages and compare them to hidden reference values; it will also verify that the number of PFCs is lower in the 25-ns annealed system and that fracture properties decrease with annealing."
      }
    ],
    "notes": "The hidden checker also validates trend consistency: number_of_PFCs(25ns) < number_of_PFCs(quenched) and fracture_energy(25ns) < fracture_energy(quenched)."
  },
  "steps": [
    {
      "id": "csv_shape",
      "output_file": "step_3_results.csv",
      "kind": "csv_shape",
      "weight": 0.0,
      "description": "Validates file exists, correct columns and exactly 10 rows."
    },
    {
      "id": "quenched_avg_failure_strain",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "failure_strain",
      "filter_model": "quenched",
      "target": 0.11,
      "tolerance_relative": 0.1,
      "description": "Average failure strain for quenched model should match reference."
    },
    {
      "id": "quenched_avg_failure_stress",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "failure_stress",
      "filter_model": "quenched",
      "target": 72.0,
      "tolerance_relative": 0.1,
      "description": "Average failure stress for quenched model."
    },
    {
      "id": "quenched_avg_fracture_energy",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "fracture_energy",
      "filter_model": "quenched",
      "target": 4.0,
      "tolerance_relative": 0.1,
      "description": "Average fracture energy for quenched model."
    },
    {
      "id": "quenched_avg_number_of_PFCs",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "number_of_PFCs",
      "filter_model": "quenched",
      "target": 15,
      "tolerance_relative": 0.2,
      "description": "Average PFC count for quenched model."
    },
    {
      "id": "quenched_avg_strain_first_nanocrack",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "strain_first_nanocrack",
      "filter_model": "quenched",
      "target": 0.073,
      "tolerance_relative": 0.1,
      "description": "Average strain at first nanocrack for quenched model."
    },
    {
      "id": "quenched_avg_stress_first_nanocrack",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "stress_first_nanocrack",
      "filter_model": "quenched",
      "target": 43.4,
      "tolerance_relative": 0.1,
      "description": "Average stress at first nanocrack for quenched model."
    },
    {
      "id": "25ns_avg_failure_strain",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "failure_strain",
      "filter_model": "25ns",
      "target": 0.073,
      "tolerance_relative": 0.1,
      "description": "Average failure strain for 25ns annealed model."
    },
    {
      "id": "25ns_avg_failure_stress",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "failure_stress",
      "filter_model": "25ns",
      "target": 46.0,
      "tolerance_relative": 0.1,
      "description": "Average failure stress for 25ns annealed model."
    },
    {
      "id": "25ns_avg_fracture_energy",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "fracture_energy",
      "filter_model": "25ns",
      "target": 1.7,
      "tolerance_relative": 0.1,
      "description": "Average fracture energy for 25ns annealed model."
    },
    {
      "id": "25ns_avg_number_of_PFCs",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "number_of_PFCs",
      "filter_model": "25ns",
      "target": 4,
      "tolerance_relative": 0.25,
      "description": "Average PFC count for 25ns annealed model."
    },
    {
      "id": "25ns_avg_strain_first_nanocrack",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "strain_first_nanocrack",
      "filter_model": "25ns",
      "target": 0.073,
      "tolerance_relative": 0.1,
      "description": "Average strain at first nanocrack for 25ns annealed model."
    },
    {
      "id": "25ns_avg_stress_first_nanocrack",
      "output_file": "step_3_results.csv",
      "kind": "numeric_aggregate",
      "weight": 0.08,
      "metric": "mean",
      "column": "stress_first_nanocrack",
      "filter_model": "25ns",
      "target": 43.4,
      "tolerance_relative": 0.1,
      "description": "Average stress at first nanocrack for 25ns annealed model."
    },
    {
      "id": "trend_energy",
      "output_file": "step_3_results.csv",
      "kind": "trend",
      "weight": 0.02,
      "description": "Verify that quenched average fracture energy is greater than 25ns annealed average.",
      "compare": "greater",
      "column": "fracture_energy",
      "model_a": "quenched",
      "model_b": "25ns"
    },
    {
      "id": "trend_pfc",
      "output_file": "step_3_results.csv",
      "kind": "trend",
      "weight": 0.02,
      "description": "Verify that quenched average number_of_PFCs is greater than 25ns annealed average.",
      "compare": "greater",
      "column": "number_of_PFCs",
      "model_a": "quenched",
      "model_b": "25ns"
    }
  ]
}