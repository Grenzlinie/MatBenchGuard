      "access": {
        "url": "https://www.lammps.org/",
        "notes": "Open-source; version with MANYBODY package for REBO/SED-REBO potentials."
      }
    },
    {
      "id": "rebo_potential",
      "name": "Second-generation REBO potential",
      "type": "file",
      "access": {
        "package": "LAMMPS MANYBODY package",
        "notes": "Used for liquid quench and annealing at 4000 K."
      }
    },
    {
      "id": "sed_rebo_potential",
      "name": "Screened environment-dependent REBO (SED-REBO) potential",
      "type": "file",
      "access": {
        "package": "LAMMPS MANYBODY package (pair_style rebos)",
        "notes": "Used for final relaxation and all tensile tests."
      }
    },
    {
      "id": "python_packages",
      "name": "Python with numpy, matplotlib",
      "type": "package",
      "access": {
        "package": "pip install numpy matplotlib",
        "notes": "For post-processing stress-strain curves and computing fracture properties."
      }
    }
  ]
}