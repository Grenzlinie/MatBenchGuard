{
  "scoring_tier": "consistency",
  "scoring_justification": "Order parameters cannot be recomputed without the full self-consistent solver; they are compared to paper gold with tolerances. Phase labels are verified for consistency with the order parameters. Fermi surfaces are structurally audited.",
  "pass_threshold": 0.5,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference order parameter values for selected doping points from the paper (Figures 2,4).",
      "source_provenance": "Paper text and Figure 4 caption give explicit numbers: n=0.98: δ_h1=0.130, δ_d2=0.090, m1=0.47, m2=0.68; n=0.95: δ_h1=0.180, δ_d2=0.080, m1=0.05, m2=0.73; n=0.90: δ_h1=0.225, δ_d2=0.025, m1=0.01, m2=0.95.",
      "generation_method": "Directly extracted from the paper's reported values.",
      "why_not_fabricated": "Values are quoted from the paper. They are used only as reference checks for the agent's computed quantities."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "order_parameters.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "n",
            "W",
            "t_perp_t",
            "delta_1",
            "delta_2",
            "chi_1",
            "chi_2",
            "m_1",
            "m_2",
            "delta_h_1",
            "delta_d_2",
            "mu"
          ],
          "columns": {
            "n": "float",
            "W": "float",
            "t_perp_t": "float",
            "delta_1": "float",
            "delta_2": "float",
            "chi_1": "float",
            "chi_2": "float",
            "m_1": "float",
            "m_2": "float",
            "delta_h_1": "float",
            "delta_d_2": "float",
            "mu": "float"
          }
        },
        "description": "Converged mean-field order parameters for each (n,W,t_perp) point. The checker will compare the agent's values for a hidden set of points to paper-reported reference values with relative tolerances."
      },
      {
        "file": "phase_diagram.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "n",
            "W",
            "t_perp_t",
            "phase"
          ],
          "columns": {
            "n": "float",
            "W": "float",
            "t_perp_t": "float",
            "phase": "string"
          }
        },
        "description": "Phase classification for each (n,W) grid point at t_perp/t=0.5. The checker compares the labels to the paper's reported phase diagram boundaries."
      },
      {
        "file": "fermi_dispersions.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "object",
          "required_keys": [
            "n=0.98",
            "n=0.95",
            "n=0.90",
            "n=0.85"
          ],
          "per_key": {
            "type": "object",
            "required_keys": [
              "k_path",
              "energies",
              "features"
            ],
            "k_path": "list of [kx,ky] arrays",
            "energies": "list of four lists of floats",
            "features": "string"
          }
        },
        "description": "Fermi surface and band dispersion data for four doping levels. The checker audits structural features (pocket presence, flat bands, interlayer splitting) described in the 'features' field."
      }
    ],
    "notes": "The first step's output is load-bearing: the checker scores order parameters at hidden (n,W,t_perp) points not explicitly given, requiring the agent to run the full solver. The other steps derive from the same solver output and are checked by label accuracy and structural audit."
  },
  "steps": [
    {
      "id": "check_order_params",
      "output_file": "order_parameters.csv",
      "weight": 0.5,
      "kind": "numeric",
      "target_policy": "reference_match",
      "check_points": [
        {
          "n": 0.98,
          "W": 0.05,
          "t_perp_t": 0.5,
          "expected": {
            "delta_h_1": 0.13,
            "delta_d_2": 0.09,
            "m_1": 0.47,
            "m_2": 0.68
          },
          "tol_abs": {
            "delta_h_1": 0.04,
            "delta_d_2": 0.04,
            "m_1": 0.15,
            "m_2": 0.2
          }
        },
        {
          "n": 0.95,
          "W": 0.05,
          "t_perp_t": 0.5,
          "expected": {
            "delta_h_1": 0.18,
            "delta_d_2": 0.08,
            "m_1": 0.05,
            "m_2": 0.73
          },
          "tol_abs": {
            "delta_h_1": 0.04,
            "delta_d_2": 0.04,
            "m_1": 0.05,
            "m_2": 0.2
          }
        },
        {
          "n": 0.9,
          "W": 0.05,
          "t_perp_t": 0.5,
          "expected": {
            "delta_h_1": 0.225,
            "delta_d_2": 0.025,
            "m_1": 0.01,
            "m_2": 0.95
          },
          "tol_abs": {
            "delta_h_1": 0.04,
            "delta_d_2": 0.04,
            "m_1": 0.05,
            "m_2": 0.2
          }
        },
        {
          "n": 0.85,
          "W": 0.05,
          "t_perp_t": 0.5,
          "expected": {
            "delta_h_1": 0.25,
            "delta_d_2": 0.0,
            "m_1": 0.0,
            "m_2": 0.0
          },
          "tol_abs": {
            "delta_h_1": 0.04,
            "delta_d_2": 0.01,
            "m_1": 0.05,
            "m_2": 0.05
          }
        }
      ]
    },
    {
      "id": "check_phase_consistency",
      "output_file": "phase_diagram.csv",
      "weight": 0.2,
      "kind": "consistency",
      "target_policy": "structural_audit",
      "thresholds": {
        "m": 0.01,
        "delta": 0.001
      }
    },
    {
      "id": "check_fermi_bands",
      "output_file": "fermi_dispersions.json",
      "weight": 0.3,
      "kind": "structural",
      "target_policy": "structural_audit",
      "required_features": [
        "pocket",
        "flat band",
        "no nodal splitting"
      ]
    }
  ]
}