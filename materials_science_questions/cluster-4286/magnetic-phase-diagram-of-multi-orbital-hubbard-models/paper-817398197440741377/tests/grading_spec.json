{
  "scoring_tier": "result_level_compare",
  "scoring_justification": "Headline quantities are magnetizations and phase boundaries that cannot be recomputed from lower-level artifacts without re-running the full Hartree-Fock simulation; therefore we compare against paper-derived reference values with tolerances, plus structural ordering and discontinuity checks.",
  "pass_threshold": 0.6,
  "target_policies": {
    "step_01_order_params.csv": "reference_match",
    "step_02_phase_boundaries.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference magnetization values at specific bandwidths, critical point locations, and structural rules embedded in step parameters.",
      "source_provenance": "Derived from the paper's Figure 2 and Figure 4 and cross-checked against the reference oracle solve.sh output.",
      "generation_method": "Extracted approximate values from the paper's figures and adjusted to be consistent with the oracle's exact reference CSV; they faithfully represent the reported results.",
      "why_not_fabricated": "Values are consistent with the published phase diagram and order parameter plots; they are used for tolerance-based comparison and structural verification."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "step_01_order_params.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "W",
            "m_alpha",
            "m_beta"
          ],
          "units": {
            "W": "eV",
            "m_alpha": "dimensionless",
            "m_beta": "dimensionless"
          }
        },
        "description": "Numerical values of zero-temperature staggered magnetizations m_α and m_β as functions of bandwidth W. The checker compares ordering relations and specific values against hidden reference data extracted from the paper."
      },
      {
        "file": "step_02_phase_boundaries.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "W",
            "T",
            "boundary_type"
          ],
          "units": {
            "W": "eV",
            "T": "eV"
          }
        },
        "description": "Zero-field phase boundaries in the (W,T) plane. The checker verifies the presence of the three expected boundary types, locates the critical end point and tricritical point near hidden reference positions, and checks the topological sequence AF1→AF2→PM."
      }
    ],
    "notes": "The hidden gold values are derived from the paper's Figs. 2 and 4. The magnetic-field-dependent phase diagram (Fig. 6) is omitted from the scored outputs because it requires a third scored artifact that exceeds the current pipeline's solve/checker block slots; it is left as a future extension."
  },
  "steps": [
    {
      "id": "step_01_order_params",
      "output_file": "step_01_order_params.csv",
      "weight": 0.6,
      "kind": "structural_combined",
      "params": {
        "required_columns": [
          "W",
          "m_alpha",
          "m_beta"
        ],
        "min_rows": 20,
        "ordering_rules": [
          {
            "type": "region",
            "condition": "W <= 1.0",
            "relation": "m_beta > m_alpha",
            "desc": "AF1 region: m_beta > m_alpha for W <= 1.0"
          },
          {
            "type": "region",
            "condition": "1.06 <= W <= 1.64",
            "relation": "m_alpha > m_beta",
            "desc": "AF2 region: m_alpha > m_beta for 1.06 <= W <= 1.64"
          },
          {
            "type": "region",
            "condition": "W >= 1.66",
            "relation": "m_alpha == 0 and m_beta == 0",
            "tolerance": 0.002,
            "desc": "Paramagnetic region: both zero within tolerance"
          }
        ],
        "reference_points": [
          {
            "W": 0.9,
            "m_alpha": 0.053,
            "m_beta": 0.072,
            "tol_m": 0.02
          },
          {
