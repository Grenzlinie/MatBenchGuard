            "m_beta": 0.0,
            "tol_m": 0.01
          }
        ],
        "discontinuity_check": {
          "W_before_low": 1.03,
          "W_before_high": 1.05,
          "W_after_low": 1.06,
          "m_alpha_increase_min": 0.003,
          "m_beta_decrease_min": 0.01
