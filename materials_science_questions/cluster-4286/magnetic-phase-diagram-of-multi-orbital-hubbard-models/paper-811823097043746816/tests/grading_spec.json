{
  "scoring_tier": "consistency",
  "scoring_justification": "Full recompute of the FLEX simulation in the checker is infeasible. The checker verifies that the submitted occupancies, eigenvalues, and TN are consistent with the paper's reported reference numbers within tolerance, and checks required physical trends (d-wave eigenvalue > extended-s, TN peak near Ud=8).",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference occupancy, eigenvalue, and TN values from the paper (Figs. 6,10,13,18).",
      "source_provenance": "Extracted from published figures and text of Phys. Rev. B 47, 12153 (1993).",
      "generation_method": "Values read from the paper's reported data points and cross-checked to match the reference solve.sh which reproduces the same simulation protocol.",
      "why_not_fabricated": "These are the paper's own reported results; the hidden checker compares the agent's computed quantities against these benchmark values."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "occupancies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "param_set",
            "n_d",
            "n_p_h",
            "n_p_n"
          ],
          "units": {}
        },
        "description": "Average orbital occupancies from FLEX. Checked against reference values from the paper."
      },
      {
        "file": "eigenvalues.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "T_over_tpd",
            "lambda_d",
            "lambda_sstar"
          ],
          "units": {}
        },
        "description": "Singlet pairing eigenvalues for d-wave and extended-s. Values and inequality λ_d > λ_s* will be checked."
      },
      {
        "file": "TN.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "Ud_over_tpd",
            "TN_over_tpd"
          ],
          "units": {}
        },
        "description": "Magnetic crossover temperature. Checked against reference and monotonic trend."
      }
    ],
    "notes": "The Wannier-state analysis and one-band model comparison are not required. Only the three-band results are scored."
  },
  "steps": [
