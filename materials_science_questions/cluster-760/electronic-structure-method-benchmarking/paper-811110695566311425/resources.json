{
  "version": 1,
  "resources": [
    {
      "id": "res_electronic_energies",
      "name": "Ground-state electronic energies (E0)",
      "type": "dataset",
      "access": {
        "method": "bundled",
        "notes": "Provided as CSV file (electronic_energies.csv) containing E0 values for ethane and nine fluoroethanes for methods G2(MP2), G2, CBS-4, CBS-Q, extracted from the paper's Table 4."
      }
    },
    {
      "id": "res_vibrational_freq",
      "name": "Scaled vibrational frequencies",
      "type": "dataset",
      "access": {
        "method": "bundled",
        "notes": "Provided as CSV file (vibrational_frequencies.csv) containing harmonic frequencies (HF/6-31G(d), scaled by 0.8929) from the paper's Table 3."
      }
    },
    {
      "id": "res_experimental_Hf",
      "name": "Experimental enthalpies of formation",
      "type": "dataset",
      "access": {
        "method": "bundled",
        "notes": "Provided as CSV file (experimental_enthalpies.csv) containing Δ_fH° at 298 K with uncertainties, from the paper's Table 5A."
      }
    },
    {
      "id": "res_atomization_data",
      "name": "Atomization enthalpies of elements",
      "type": "dataset",
      "access": {
        "method": "bundled",
        "notes": "Provided as CSV file (atomization_enthalpies.csv) containing standard thermochemical reference values for C(g), H(g), and F(g)."
      }
    },
    {
      "id": "res_delta_CF",
      "name": "C–F bond additivity correction parameters",
      "type": "dataset",
      "access": {
        "method": "bundled",
        "notes": "Provided as CSV file (delta_CF_parameters.csv) containing Δ_C-F values for each method from the paper's Table 6B."
      }
    },
    {
      "id": "res_python",
      "name": "Python scientific stack",
      "type": "package",
      "access": {
        "method": "pip",
        "notes": "numpy, scipy, pandas. Use Tsinghua mirror for installation."
      }
    }
  ],
