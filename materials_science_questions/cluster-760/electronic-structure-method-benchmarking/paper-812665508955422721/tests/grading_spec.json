  "steps": [
    {
      "id": "step_predict",
      "output_file": "predictions.csv",
      "kind": "recompute_metric",
      "weight": 0.8,
      "metric": "MAE_and_MSE",
      "target_mae": 5.0,
      "target_mse_abs": 1.0,
      "threshold_mae": 5.0,
      "threshold_mse_abs": 1.0,
