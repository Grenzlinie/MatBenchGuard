    {
      "id": "step_metrics",
      "output_file": "summary_metrics.json",
      "kind": "json_field",
      "weight": 0.2,
      "fields": [
        "MAE_kJmol",
        "MSE_kJmol"
      ],
      "tolerance_abs": 0.5,
      "description": "Check that the agent-reported MAE and MSE in summary_metrics.json are consistent with the recomputed values within 0.5 kJ/mol absolute tolerance."
    }
  ]
