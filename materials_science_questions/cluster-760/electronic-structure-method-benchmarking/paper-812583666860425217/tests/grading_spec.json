{
  "scoring_tier": "result-level_compare",
  "scoring_justification": "T1 recompute infeasible because DFT raw outputs are not part of the scored contract; T0 with tolerances and structural trend checks is the strongest feasible tier.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold values for binding energies and K-O distances from the paper, plus trend conditions.",
      "source_provenance": "Paper reported values (Table III, Fig. 1, etc.), aligned with the reference solve.sh output.",
      "generation_method": "Values extracted from the paper's description and cross-checked with the reference solution.",
      "why_not_fabricated": "All values trace back to the paper's published quantities; they represent a correct reproduction according to the paper."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "dft_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "complex",
            "functional",
            "basis",
            "binding_energy_kcal_mol",
            "K_O_distance_angstrom"
          ],
          "units": {
            "binding_energy_kcal_mol": "kcal/mol",
            "K_O_distance_angstrom": "angstrom"
          }
        },
        "description": "Computed DFT binding energies and K-O bond lengths. Checker compares each value to hidden gold tolerances and verifies relative trends: BLYP binding energy for K+:12c4 is at least 4 kcal/mol less negative than SVWN, and SVWN K-O distance is at least 0.05 Å shorter than BP86 for the same complex."
      }
    ],
    "notes": "All values are electronic binding energies (BSSE-uncorrected) as reported in the paper. Scoring also checks the qualitative trends described in the notes."
  },
  "steps": [
    {
      "id": "dft_row_accuracy",
      "output_file": "dft_results.csv",
      "kind": "numeric",
      "weight": 0.7,
      "tolerances": {
        "binding_energy_kcal_mol": 2.0,
        "K_O_distance_angstrom": 0.02
      },
      "gold_table": [
        {
          "complex": "K+:DME",
          "functional": "SVWN",
          "basis": "aug-cc-pVDZ",
          "binding_energy_kcal_mol": -20.2,
          "K_O_distance_angstrom": 2.47
        },
        {
          "complex": "K+:DME",
          "functional": "BP86",
          "basis": "aug-cc-pVDZ",
          "binding_energy_kcal_mol": -18.0,
          "K_O_distance_angstrom": 2.58
        },
        {
          "complex": "K+:DME",
          "functional": "BLYP",
          "basis": "aug-cc-pVDZ",
          "binding_energy_kcal_mol": -16.4,
          "K_O_distance_angstrom": 2.64
        },
        {
          "complex": "K+:12c4",
          "functional": "SVWN",
          "basis": "cc-pVDZ",
          "binding_energy_kcal_mol": -49.6,
          "K_O_distance_angstrom": 2.79
        },
        {
          "complex": "K+:12c4",
          "functional": "BP86",
          "basis": "cc-pVDZ",
          "binding_energy_kcal_mol": -47.3,
          "K_O_distance_angstrom": 2.86
        },
        {
          "complex": "K+:12c4",
          "functional": "BLYP",
          "basis": "cc-pVDZ",
          "binding_energy_kcal_mol": -42.5,
          "K_O_distance_angstrom": 2.9
        },
        {
          "complex": "K+:18c6",
          "functional": "SVWN",
          "basis": "cc-pVDZ",
          "binding_energy_kcal_mol": -80.0,
          "K_O_distance_angstrom": 2.84
        },
        {
          "complex": "K+:18c6",
          "functional": "BP86",
          "basis": "cc-pVDZ",
          "binding_energy_kcal_mol": -78.5,
          "K_O_distance_angstrom": 2.91
        },
        {
          "complex": "K+:18c6",
          "functional": "BLYP",
          "basis": "cc-pVDZ",
          "binding_energy_kcal_mol": -73.5,
          "K_O_distance_angstrom": 2.95
        }
      ]
    },
    {
      "id": "trend_binding",
      "output_file": "dft_results.csv",
      "kind": "structural",
      "weight": 0.15,
      "conditions": [
        {
          "description": "BLYP binding energy for K+:12c4 is at least 4 kcal/mol greater (less negative) than SVWN",
          "check": "complex==K+:12c4, functional=BLYP binding > SVWN binding + 4.0"
        }
      ]
    },
    {
      "id": "trend_distance",
      "output_file": "dft_results.csv",
      "kind": "structural",
      "weight": 0.15,
      "conditions": [
        {
          "description": "SVWN K-O distance for K+:12c4 is at least 0.05 Å shorter than BP86",
          "check": "complex==K+:12c4, functional=SVWN distance < BP86 distance - 0.05"
        }
      ]
    }
  ]
}