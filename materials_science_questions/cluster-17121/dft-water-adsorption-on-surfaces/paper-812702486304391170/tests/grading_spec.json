{
  "scoring_tier": "structural",
  "scoring_justification": "Headline results are structural features (hydration layers, ionic positions, organic molecule penetration) and salinity trends rather than a single metric that can be recomputed against labeled data. Verifying these structural properties from the agent's raw CSV artifacts is the strongest feasible tier.",
  "pass_threshold": 0.6,
  "target_policies": {
    "density_profiles.csv": "structural_audit",
    "rdf_Na_Bz_interface.csv": "structural_audit",
    "rdf_Na_Ow_interface.csv": "structural_audit",
    "survival_probability.csv": "structural_audit",
    "residence_times.csv": "structural_audit"
  },
  "hidden_assets": [],
  "steps": [
    {
      "id": "density_check",
      "output_file": "density_profiles.csv",
      "kind": "structural",
      "weight": 0.4,
      "params": {
        "ow_first_peak_range_A": [
          2.0,
          3.0
        ],
        "bz_peak_min_z_A": 5.0,
        "salinity_order": [
          "DW",
          "LS",
          "SW"
        ],
        "na_peak_proximity_A": 2.0,
        "cl_further_than_na": true
      }
    },
    {
      "id": "rdf_nabz_check",
      "output_file": "rdf_Na_Bz_interface.csv",
      "kind": "structural",
      "weight": 0.2,
      "params": {
        "peak_pos_range_A": [
          4.2,
          4.8
        ],
        "peak_height_order": [
          "LS",
          "SW",
          "DW"
        ],
        "tolerance_ratio": 0.1
      }
    },
    {
      "id": "rdf_naow_check",
      "output_file": "rdf_Na_Ow_interface.csv",
      "kind": "structural",
      "weight": 0.15,
      "params": {
        "peak_pos_range_A": [
          2.1,
          2.7
        ],
        "min_peak_height": 1.0
      }
    },
    {
      "id": "survival_check",
      "output_file": "survival_probability.csv",
      "kind": "structural",
      "weight": 0.15,
      "params": {
        "salinity_order": [
          "DW",
          "LS",
          "SW"
        ],
        "decay_time_ps": 50.0,
        "decay_ordering": true
      }
    },
    {
      "id": "residence_check",
      "output_file": "residence_times.csv",
      "kind": "structural",
      "weight": 0.1,
      "params": {
        "salinity_order": [
          "DW",
          "LS",
          "SW"
        ],
        "consistency_with_survival_tolerance": 0.2
      }
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "density_profiles.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "salinity",
            "z",
            "Ow_density",
            "Hw_density",
            "Bz_density",
            "Na_density",
            "Cl_density"
          ],
          "units": {
            "z": "Å",
            "Ow_density": "atoms/Å³",
            "Hw_density": "atoms/Å³",
            "Bz_density": "atoms/Å³",
            "Na_density": "atoms/Å³",
            "Cl_density": "atoms/Å³"
          }
        },
        "description": "Number density profiles of water oxygen, hydrogen, benzoate, Na+, and Cl- along the surface normal for DW, LS, SW salinities."
      },
      {
        "file": "rdf_Na_Bz_interface.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "salinity",
            "r",
            "g_r"
          ],
          "units": {
            "r": "Å",
            "g_r": "dimensionless"
          }
        },
        "description": "Radial distribution function g(r) for Na+ - benzoate pairs at the calcite/brine interface, for each salinity."
      },
      {
        "file": "rdf_Na_Ow_interface.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "salinity",
            "r",
            "g_r"
          ],
          "units": {
            "r": "Å",
            "g_r": "dimensionless"
          }
        },
        "description": "Radial distribution function g(r) for Na+ - water oxygen pairs at the interface, for each salinity."
      },
      {
        "file": "survival_probability.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "salinity",
            "time",
            "p_t"
          ],
          "units": {
            "time": "ps",
            "p_t": "dimensionless"
          }
        },
        "description": "Survival probability P(t) of benzoate molecules at the interface for each salinity."
      },
      {
        "file": "residence_times.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "salinity",
            "residence_time"
          ],
          "units": {
            "residence_time": "ps"
          }
        },
        "description": "Benzoate residence times at the interface, one per salinity."
      }
    ],
    "notes": "All artifacts must be produced from the last 20 ns of 50 ns MD trajectories for the three salinities DW, LS, SW. Density profiles are averaged over both calcite slabs. The exact system dimensions and force fields are as specified in the steps."
  }
}