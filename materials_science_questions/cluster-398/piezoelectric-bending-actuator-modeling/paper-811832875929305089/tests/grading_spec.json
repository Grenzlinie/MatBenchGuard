{
  "scoring_tier": "recompute",
  "scoring_justification": "The agent's final normalized fracture parameters are compared pointwise to reference values digitized from the paper's Figures 2–4 and 8–9, embedded inline. The fraction of matched points within tolerance constitutes the reward.",
  "pass_threshold": 0.6,
  "target_policies": {
    "results.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference normalized intensity factor values for the four parametric sweeps described in the paper (length ratio, vertical separation, horizontal offset, dielectric permittivity effect).",
      "source_provenance": "Digitized from Figures 2, 3, 4, 5, 8, 9 of the source paper (Yan & Jiang, 2009, Acta Mechanica) using a graphical extraction tool with manual verification of key data points. Values represent the paper's reported results for the given configurations under PZT-4 material, far-field tensile stress 20 MPa and electric displacement 1e-3 C/m².",
      "generation_method": "X-Y coordinates extracted by digitizing the published figures at multiple parameter values; the extracted values were cross-checked for consistency with the qualitative trends described in the paper. For configurations not explicitly shown at every point, linear interpolation between nearby extracted points was used. The reference K_COD^S (single-crack COD intensity factor) was also digitized from the appropriate figures.",
      "why_not_fabricated": "All values originate from the paper's own published curves, ensuring they represent the paper's actual results. No data were invented; they trace back to specific points on the published figures."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "case_id",
            "parameter_name",
            "parameter_value",
            "material_gradient",
            "crack_model",
            "crack",
            "tip",
            "K_I_norm",
            "K_II_norm",
            "K_D_norm",
            "K_COD_norm"
          ],
          "units": {
            "parameter_value": "dimensionless",
            "material_gradient": "1/mm or dimensionless",
            "K_I_norm": "dimensionless",
            "K_II_norm": "dimensionless",
            "K_D_norm": "dimensionless",
            "K_COD_norm": "dimensionless"
          }
        },
        "description": "Normalized stress and electric displacement intensity factors for interacting parallel cracks, compared to hidden gold values from the paper."
      }
    ],
    "notes": "The single-crack reference values are computed for the same crack length as appropriate for each normalization. The CSV includes all data points required to reproduce the paper's Figures 2–4 and 8–9."
  },
