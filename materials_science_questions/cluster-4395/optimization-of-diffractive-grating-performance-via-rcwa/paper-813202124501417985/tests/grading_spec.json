{
  "scoring_tier": "consistency",
  "scoring_justification": "Net absorption/Jsc and flat-film peak are compared to paper-reported values with tolerances/thresholds; angle dependence is verified for structural invariance. Recompute from raw RCWA outputs is not required as the agent directly reports final calculated values.",
  "pass_threshold": 0.6,
  "target_policies": {
    "flat_film_peak.json": "exact_match",
    "net_absorption_Jsc.csv": "threshold_or_better",
    "angle_dependence.json": "structural_audit"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold reference values for flat-film peak and net absorption/Jsc thresholds",
      "source_provenance": "Table 1 and Fig. 1(d) of the paper 'Optical Absorption Characteristic in Thin a-Si Film Embedded Between an Ultrathin Metal Grating and a Metal Reflector', IEEE Photonics Journal, 2013. The reference solve.sh outputs match these values.",
      "generation_method": "Values extracted directly from the paper's reported numeric results (Table 1 and text descriptions) and verified against the solve.sh reference.",
      "why_not_fabricated": "These are the actual reported numbers from the paper, as used in the experiment."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "flat_film_peak.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "required": [
            "peak_wavelength_nm",
            "fwhm_nm"
          ],
          "properties": {
            "peak_wavelength_nm": {
              "type": "number",
              "unit": "nm"
            },
            "fwhm_nm": {
              "type": "number",
              "unit": "nm"
            }
          }
        },
        "description": "Resonant absorption peak wavelength and bandwidth of the planar absorber."
      },
      {
        "file": "net_absorption_Jsc.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "required_columns": [
            "configuration",
            "polarization",
            "net_absorption_total",
            "net_absorption_Ag",
            "net_absorption_aSi",
            "Jsc_mA_cm2"
          ],
          "column_types": {
            "configuration": "string",
            "polarization": "string",
            "net_absorption_total": "float",
            "net_absorption_Ag": "float",
            "net_absorption_aSi": "float",
            "Jsc_mA_cm2": "float"
          },
          "units": {
            "net_absorption_total": "dimensionless",
            "net_absorption_Ag": "dimensionless",
            "net_absorption_aSi": "dimensionless",
            "Jsc_mA_cm2": "mA/cm^2"
          }
        },
        "description": "Net absorption efficiencies and short-circuit current density for thick and ultrathin grating configurations at normal incidence."
      },
      {
        "file": "angle_dependence.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "required_keys": [
            "ultrathin_TM",
            "ultrathin_TE"
          ],
          "array_schema": {
            "type": "array",
            "items": {
              "required": [
                "angle_deg",
                "peak_wavelength_nm",
                "max_absorption"
              ],
              "properties": {
                "angle_deg": {
                  "type": "number",
                  "unit": "deg"
                },
                "peak_wavelength_nm": {
                  "type": "number",
                  "unit": "nm"
                },
                "max_absorption": {
                  "type": "number",
                  "unit": "dimensionless"
                }
              }
            }
          }
        },
        "description": "Angle-dependent peak positions and maximum absorption for the ultrathin grating, used to verify peak wavelength invariance and TM threshold."
      }
    ],
    "notes": "All outputs are derived from RCWA simulations using public optical constants and the AM1.5G spectrum. The flat film peak is checked against a fixed target; net absorption/Jsc use threshold-or-better policy; the angle dependence checks structural invariance and absorption threshold."
  },
  "steps": [
    {
      "id": "step1",
      "output_file": "flat_film_peak.json",
      "kind": "result_compare",
      "weight": 0.2,
      "reference": {
        "peak_wavelength_nm": 660,
        "fwhm_nm": 100,
        "tolerance_nm": 5
      }
    },
    {
      "id": "step2",
      "output_file": "net_absorption_Jsc.csv",
      "kind": "result_compare",
      "weight": 0.5,
      "thresholds": [
        {
          "configuration": "thick_grating",
          "polarization": "TM",
          "net_absorption_aSi_min": 0.382,
          "Jsc_mA_cm2_min": 13.29
        },
        {
          "configuration": "thick_grating",
          "polarization": "TE",
          "net_absorption_aSi_min": 0.161,
          "Jsc_mA_cm2_min": 5.58
        },
        {
          "configuration": "ultrathin_grating",
          "polarization": "TM",
          "net_absorption_aSi_min": 0.482,
          "Jsc_mA_cm2_min": 16.64
        },
        {
          "configuration": "ultrathin_grating",
          "polarization": "TE",
          "net_absorption_aSi_min": 0.431,
          "Jsc_mA_cm2_min": 14.53
        }
      ]
    },
    {
      "id": "step3",
      "output_file": "angle_dependence.json",
      "kind": "structural_audit",
      "weight": 0.3,
      "tolerance_nm": 5,
      "tm_absorption_threshold": 0.9
    }
  ]
}