        "description": "Mapping pressure (GPa) to melting temperature (K) with error estimate. Checked against paper-reported melting points within tolerance."
      },
      {
        "file": "phonon_frequencies.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pressure_GPa": {
                "type": "number"
              },
              "phase": {
