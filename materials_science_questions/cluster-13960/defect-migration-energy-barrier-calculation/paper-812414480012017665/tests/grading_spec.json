{
  "scoring_tier": "consistency",
  "scoring_justification": "T1 full recompute from raw Mott‑Littleton simulations is infeasible within the verifier sandbox; scoring relies on internal consistency (T1 recompute of derived relations) plus result‑level comparison (T0) against the paper's tabulated values.",
  "pass_threshold": 0.6,
  "target_policies": {
    "computed_energies.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold energies for defect, unoccupied, trap formation, solution, migration and basic energies from Tables 3–8 of the paper",
      "source_provenance": "paper Tables 3,4,5(a‑c),6,7(a‑c),8 and derived basic energies",
      "generation_method": "extracted directly from the published tables and the derivation relations in the paper’s appendix",
      "why_not_fabricated": "these are the exact numerical results the paper reports; they serve as the reproduction target and are exactly what the reference solver writes"
    }
  ],
