        "x_vals": [
          0.0,
          0.05,
          0.1,
          0.15,
          0.2,
          0.25,
          0.3,
          0.35,
          0.4
        ],
        "a_vals": [
          5.418,
          5.4233,
          5.4286,
          5.4339,
          5.4392,
          5.4445,
          5.4498,
          5.4551,
          5.4604
        ]
      },
      "tolerance": 0.005,
      "columns": {
        "x": "x",
        "a": "a"
      }
    },
    {
      "id": "step_assoc",
      "output_file": "association_energies.csv",
