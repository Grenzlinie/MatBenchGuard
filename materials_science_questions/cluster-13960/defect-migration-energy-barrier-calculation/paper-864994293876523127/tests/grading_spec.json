{
  "scoring_tier": "result-level compare",
  "scoring_justification": "Full SMM recompute in checker is infeasible; hidden gold tolerances absorb legitimate implementation spread while structural trend checks verify key physical behaviors.",
  "pass_threshold": 0.7,
  "target_policies": {
    "lattice_parameter.csv": "exact_match",
    "association_energies.csv": "exact_match",
    "migration_energies.csv": "exact_match",
    "trapping_migration_energies.csv": "exact_match",
    "conductivity.csv": "exact_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference lattice parameter, association energies, migration energies, trapping energies, conductivity values from the paper",
      "source_provenance": "Paper Fig.2, Table 2, Table 3, text, and conductivity formula with parameters from paper",
      "generation_method": "Extracted from paper's reported values and conductivity model",
      "why_not_fabricated": "Values are those published in the paper"
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "lattice_parameter.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "x",
            "a"
          ],
          "units": {
            "x": null,
            "a": "Angstrom"
          }
        },
        "description": "Lattice parameter a as a function of Sm doping x at room temperature."
      },
      {
        "file": "association_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "position",
            "E_ass"
          ],
          "units": {
            "position": null,
            "E_ass": "eV"
          }
        },
        "description": "Vacancy-dopant association energies at 1NN and 2NN positions."
      },
      {
        "file": "migration_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "edge",
            "E_m"
          ],
          "units": {
            "edge": null,
            "E_m": "eV"
          }
        },
        "description": "Vacancy migration energies across Ce-Ce, Ce-Sm, and Sm-Sm edges."
      },
      {
        "file": "trapping_migration_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "configuration",
            "E_m"
          ],
          "units": {
            "configuration": null,
            "E_m": "eV"
          }
        },
        "description": "Migration energies for three trapping configurations (1,2,3 Sm ions at 1NN sites)."
      },
      {
        "file": "conductivity.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "x",
            "sigma"
          ],
          "units": {
            "x": null,
            "sigma": "S/cm"
          }
        },
        "description": "Ionic conductivity at T=1073 K as a function of Sm doping."
      }
    ],
    "notes": "All scored values are compared to hidden paper-reported references within appropriate tolerances. Structural relations (e.g., E_ass_1NN < E_ass_2NN, E_m(Ce-Ce) < E_m(Ce-Sm) < E_m(Sm-Sm), conductivity peak near x=0.15) are also verified."
  },
  "steps": [
    {
      "id": "step_lattice",
      "output_file": "lattice_parameter.csv",
      "weight": 0.1,
      "kind": "numeric",
      "compare_type": "absolute_tolerance",
