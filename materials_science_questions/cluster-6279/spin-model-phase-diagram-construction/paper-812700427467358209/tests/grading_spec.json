{
  "scoring_tier": "result-level compare",
  "scoring_justification": "Recomputing RG iteration and finite-size scaling from raw eigenvalues is infeasible in the lightweight checker; paper-reported numbers provide a reliable gold for direct result-level comparison with appropriate tolerances.",
  "pass_threshold": 0.6,
  "target_policies": {
    "rg_results.json": "exact_match",
    "fss_phase_diagram.csv": "exact_match",
    "fss_nu.csv": "exact_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold fixed-point coordinates, thermal eigenvalues, ν, phase boundaries, and critical exponent values.",
