      {
        "file": "fss_phase_diagram.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "lambda2_lambda1",
            "h1_lambda1_critical",
            "phase_region"
