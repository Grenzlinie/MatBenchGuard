          "units": {
            "lambda2_lambda1": "dimensionless ratio",
            "h1_lambda1_critical": "dimensionless ratio",
            "phase_region": "string category"
          }
        },
        "description": "Phase boundaries on the surface λ₂/λ₁ = h₂/h₁."
      },
      {
        "file": "fss_nu.csv",
        "format": "csv",
