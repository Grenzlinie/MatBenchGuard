                  "x_equal_y": {
                    "type": "number"
                  },
                  "nu": {
                    "type": "number"
                  },
                  "lambda_t2": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "description": "Fixed points and critical properties from self-dual and block renormalization group."
