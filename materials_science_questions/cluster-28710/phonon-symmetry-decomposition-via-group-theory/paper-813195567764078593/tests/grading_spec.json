{
  "scoring_tier": "structural",
  "scoring_justification": "Full recompute infeasible without running DFT; value comparison to paper gold and trend checks provide robust evaluation.",
  "pass_threshold": 0.5,
  "output_contract": {
    "outputs": [
      {
        "file": "results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "a",
              "c",
              "volume",
              "TO1",
              "TO2",
              "TO3",
              "TO4"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "a": {
                "type": "number"
              },
              "c": {
                "type": "number"
              },
              "volume": {
                "type": "number"
              },
              "TO1": {
                "type": "number"
              },
              "TO2": {
                "type": "number"
              },
              "TO3": {
                "type": "number"
              },
              "TO4": {
                "type": "number"
              }
            }
          }
        },
        "description": "Averaged lattice parameters (a, c in Å, volume in Å³) and Γ‑TO phonon frequencies (TO1–TO4 in cm⁻¹) for LiNb1−xTaxO3 at x = 0.00, 0.25, 0.50, 0.75, 1.00. Each entry corresponds to one composition."
      }
    ],
    "notes": "Only the final averaged results are scored; the process steps produce evidence logs for auditing but are not directly rewarded."
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference lattice parameters and phonon frequencies for five compositions.",
      "source_provenance": "Paper Table 1 (phonon frequencies) and Figure 1 (lattice parameters); confirmed against reference solve.sh.",
      "generation_method": "Extracted from the paper's reported data and hardcoded inline.",
      "why_not_fabricated": "These values are the paper's own published results."
    }
  ],
  "steps": [
    {
      "id": "shape_validation",
      "output_file": "results.json",
      "kind": "structural",
      "description": "Validate that results.json is a list of 5 objects with x=0.0,0.25,0.5,0.75,1.0 and all required keys.",
      "weight": 0.02
    },
    {
      "id": "lattice_params",
      "output_file": "results.json",
      "kind": "numeric",
      "description": "Check lattice parameters a, c, volume against paper reference within 2% relative tolerance.",
      "weight": 0.18,
      "gold": {
        "0.0": {
          "a": 5.148,
          "c": 13.863,
          "volume": 318.16
        },
        "0.25": {
          "a": 5.15,
          "c": 13.842,
          "volume": 317.86
        },
        "0.5": {
          "a": 5.151,
          "c": 13.822,
          "volume": 317.5
        },
        "0.75": {
          "a": 5.152,
          "c": 13.801,
          "volume": 317.27
        },
        "1.0": {
          "a": 5.154,
          "c": 13.78,
          "volume": 317.02
        }
      },
      "tolerance_rel": 0.02
    },
    {
      "id": "phonon_freqs",
      "output_file": "results.json",
      "kind": "numeric",
      "description": "Check phonon frequencies TO1–TO4 against paper reference within absolute tolerance 30 cm⁻¹.",
      "weight": 0.4,
      "gold": {
        "0.0": {
          "TO1": 235,
          "TO2": 254,
          "TO3": 323,
          "TO4": 609
        },
        "0.25": {
          "TO1": 229,
          "TO2": 244,
          "TO3": 327,
          "TO4": 598
        },
        "0.5": {
          "TO1": 214,
          "TO2": 241,
          "TO3": 335,
          "TO4": 588
        },
        "0.75": {
          "TO1": 208,
          "TO2": 242,
          "TO3": 342,
          "TO4": 582
        },
        "1.0": {
          "TO1": 200,
          "TO2": 242,
          "TO3": 348,
          "TO4": 577
        }
      },
      "tolerance_abs": 30
    },
    {
      "id": "trends",
      "output_file": "results.json",
      "kind": "structural",
      "description": "Enforce composition-dependent trends: a increases with x; c and volume decrease; TO1,TO2,TO4 decrease, TO3 increases. Monotonicity with tolerance (2 cm⁻¹ for phonons, 0.0001 for lengths).",
      "weight": 0.4,
      "trend_rules": {
        "a": {
          "direction": "increasing",
          "tol": 0.001
        },
        "c": {
          "direction": "decreasing",
          "tol": 0.001
        },
        "volume": {
          "direction": "decreasing",
          "tol": 0.01
        },
        "TO1": {
          "direction": "decreasing",
          "tol": 2
        },
        "TO2": {
          "direction": "decreasing",
          "tol": 2
        },
        "TO3": {
          "direction": "increasing",
          "tol": 2
        },
        "TO4": {
          "direction": "decreasing",
          "tol": 2
        }
      }
    }
  ]
}