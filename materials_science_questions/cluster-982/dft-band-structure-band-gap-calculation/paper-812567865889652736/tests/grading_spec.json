{
  "scoring_tier": "reference_match",
  "scoring_justification": "The paper reports results of DFT calculations; the verifier cannot re-run DFT but compares the agent's reported scalar values to the paper's reported reference values with tolerances, and checks relative trends (band gap increase, adsorption energy reduction, work function increase).",
  "pass_threshold": 0.6,
  "target_policies": {
    "computed_results.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference values from paper (Table/Figures) for adsorption energies, band gaps, work functions.",
      "source_provenance": "Paper's text, Figures, and Table; verbatim numeric values.",
      "generation_method": "Extracted from published paper: band gaps from text/Fig. 2-4,7-9; adsorption energies from text; work functions from Fig. 11 approximated from bar chart (values used in solve.sh).",
      "why_not_fabricated": "Values are taken directly from the paper."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "computed_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "pristine_hYN_bandgap",
            "H2S_ads_E",
            "H2S_bandgap",
            "SO2_ads_E",
            "SO2_bandgap",
            "O2_ads_E",
            "O2_hYN_bandgap",
            "H2S_O2_hYN_ads_E",
            "H2S_O2_hYN_bandgap",
            "SO2_O2_hYN_ads_E",
            "SO2_O2_hYN_bandgap",
            "work_functions"
          ],
          "properties": {
            "pristine_hYN_bandgap": {
              "type": "number",
              "units": "eV"
            },
            "H2S_ads_E": {
              "type": "number",
              "units": "eV"
            },
            "H2S_bandgap": {
              "type": "number",
              "units": "eV"
            },
            "SO2_ads_E": {
              "type": "number",
              "units": "eV"
            },
            "SO2_bandgap": {
              "type": "number",
              "units": "eV"
            },
            "O2_ads_E": {
              "type": "number",
              "units": "eV"
            },
            "O2_hYN_bandgap": {
              "type": "number",
              "units": "eV"
            },
            "H2S_O2_hYN_ads_E": {
              "type": "number",
              "units": "eV"
            },
            "H2S_O2_hYN_bandgap": {
              "type": "number",
              "units": "eV"
            },
            "SO2_O2_hYN_ads_E": {
              "type": "number",
              "units": "eV"
            },
            "SO2_O2_hYN_bandgap": {
              "type": "number",
              "units": "eV"
            },
            "work_functions": {
              "type": "object",
              "required": [
                "pristine_hYN",
                "H2S_hYN",
                "SO2_hYN",
                "O2_hYN",
                "H2S_O2_hYN",
                "SO2_O2_hYN"
              ],
              "properties": {
                "pristine_hYN": {
                  "type": "number",
                  "units": "eV"
                },
                "H2S_hYN": {
                  "type": "number",
                  "units": "eV"
                },
                "SO2_hYN": {
                  "type": "number",
                  "units": "eV"
                },
                "O2_hYN": {
                  "type": "number",
                  "units": "eV"
                },
                "H2S_O2_hYN": {
                  "type": "number",
                  "units": "eV"
                },
                "SO2_O2_hYN": {
                  "type": "number",
                  "units": "eV"
                }
              }
            }
          }
        },
        "description": "All computed adsorption energies, indirect band gaps, and work functions for the six systems under study."
      }
    ],
    "notes": "The agent must provide one JSON file containing the computed quantities. The checker will compare each value to the paper-reported reference using appropriate tolerances."
  },
  "steps": [
    {
      "id": "check_bandgaps",
      "output_file": "computed_results.json",
      "kind": "reference_match",
      "weight": 0.4,
      "field_weight_total": 0.7,
      "trend_weight_total": 0.3,
      "fields": {
        "pristine_hYN_bandgap": {
          "target": 0.722,
          "tolerance": 0.05
        },
        "H2S_bandgap": {
          "target": 0.862,
          "tolerance": 0.05
        },
        "SO2_bandgap": {
          "target": 0.976,
          "tolerance": 0.05
        },
        "O2_hYN_bandgap": {
          "target": 0.96,
          "tolerance": 0.05
        },
        "H2S_O2_hYN_bandgap": {
          "target": 0.976,
          "tolerance": 0.05
        },
        "SO2_O2_hYN_bandgap": {
          "target": 1.032,
          "tolerance": 0.05
        }
      },
      "trend": {
        "description": "Band gap increases upon gas adsorption relative to pristine h-YN (and relative to O2-h-YN for O2-loaded cases).",
        "checks": [
          {
            "expr": "H2S_bandgap > pristine_hYN_bandgap",
            "weight_portion": 0.2
          },
          {
            "expr": "SO2_bandgap > pristine_hYN_bandgap",
            "weight_portion": 0.2
          },
          {
            "expr": "O2_hYN_bandgap > pristine_hYN_bandgap",
            "weight_portion": 0.2
          },
          {
            "expr": "H2S_O2_hYN_bandgap > O2_hYN_bandgap",
            "weight_portion": 0.2
          },
          {
            "expr": "SO2_O2_hYN_bandgap > O2_hYN_bandgap",
            "weight_portion": 0.2
          }
        ]
      }
    },
    {
      "id": "check_adsorption_energies",
      "output_file": "computed_results.json",
      "kind": "reference_match",
      "weight": 0.4,
      "field_weight_total": 0.7,
      "trend_weight_total": 0.3,
      "fields": {
        "H2S_ads_E": {
          "target": -3.24,
          "tolerance": 0.1
        },
        "SO2_ads_E": {
          "target": -4.21,
          "tolerance": 0.1
        },
        "O2_ads_E": {
          "target": -6.15,
          "tolerance": 0.1
        },
        "H2S_O2_hYN_ads_E": {
          "target": -2.46,
          "tolerance": 0.1
        },
        "SO2_O2_hYN_ads_E": {
          "target": -1.75,
          "tolerance": 0.1
        }
      },
      "trend": {
        "description": "O2 pre-adsorption reduces adsorption energies of H2S and SO2 (i.e., H2S_O2_hYN_ads_E > H2S_ads_E, and SO2_O2_hYN_ads_E > SO2_ads_E).",
        "checks": [
          {
            "expr": "H2S_O2_hYN_ads_E > H2S_ads_E",
            "weight_portion": 0.5
          },
          {
            "expr": "SO2_O2_hYN_ads_E > SO2_ads_E",
            "weight_portion": 0.5
          }
        ]
      }
    },
    {
      "id": "check_work_functions",
      "output_file": "computed_results.json",
      "kind": "reference_match",
      "weight": 0.2,
      "field_weight_total": 0.6,
      "trend_weight_total": 0.4,
      "fields": {
        "pristine_hYN": {
          "target": 2.71,
          "tolerance": 0.1
        },
        "H2S_hYN": {
          "target": 2.85,
          "tolerance": 0.1
        },
        "SO2_hYN": {
          "target": 2.93,
          "tolerance": 0.1
        },
        "O2_hYN": {
          "target": 3.12,
          "tolerance": 0.1
        },
        "H2S_O2_hYN": {
          "target": 3.22,
          "tolerance": 0.1
        },
        "SO2_O2_hYN": {
          "target": 3.31,
          "tolerance": 0.1
        }
      },
      "trend": {
        "description": "Work function increases upon gas adsorption (pristine_hYN < H2S_hYN; SO2_hYN > pristine_hYN; etc. Also O2_hYN > pristine; H2S_O2_hYN > O2_hYN; SO2_O2_hYN > O2_hYN).",
        "checks": [
          {
            "expr": "H2S_hYN > pristine_hYN",
            "weight_portion": 0.2
          },
          {
            "expr": "SO2_hYN > pristine_hYN",
            "weight_portion": 0.2
          },
          {
            "expr": "O2_hYN > pristine_hYN",
            "weight_portion": 0.2
          },
          {
            "expr": "H2S_O2_hYN > O2_hYN",
            "weight_portion": 0.2
          },
          {
            "expr": "SO2_O2_hYN > O2_hYN",
            "weight_portion": 0.2
          }
        ]
      }
    }
  ]
}