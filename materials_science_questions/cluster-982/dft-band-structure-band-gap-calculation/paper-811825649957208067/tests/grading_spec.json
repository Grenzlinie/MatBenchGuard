{
  "scoring_tier": "consistency",
  "scoring_justification": "Full recompute of DFT results is infeasible in the verifier sandbox; compare submitted values to paper-reported gold values with tolerances.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
