          "type": "object",
          "required": {
            "CuAlS2": "object with a, c, V",
            "CuGaS2": "object with a, c, V",
            "CuInS2": "object with a, c, V",
            "AgGaS2": "object with a, c, V"
          },
          "units": {
            "a": "Å",
            "c": "Å",
            "V": "Å^3"
          }
        },
        "description": "Optimized lattice constants from DFT geometry optimization for all four compounds."
      },
      {
