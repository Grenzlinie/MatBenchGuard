        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "TO_cm1",
            "LO_cm1",
            "symmetry",
            "Z_star",
            "epsilon"
          ],
          "units": {
