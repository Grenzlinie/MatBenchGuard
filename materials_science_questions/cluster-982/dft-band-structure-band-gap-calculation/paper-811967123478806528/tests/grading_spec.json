{
  "scoring_tier": "reference_match",
  "scoring_justification": "Compare agent's reported band gaps, bond angles, and formation energies to paper's hidden reference values with tolerances, and verify monotonic trends.",
  "pass_threshold": 0.6,
  "target_policies": {
    "step_01_band_gaps.csv": "reference_match",
    "step_02_bond_angles.csv": "reference_match",
    "step_03_formation_energies.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper-reported band gaps, bond angles, and formation energies for Sc, Y, La doped PZT.",
