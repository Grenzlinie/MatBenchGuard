          "optical_band_gap_eV": 3.1
        },
        "Sc": {
          "energy_band_gap_eV": 1.55,
          "optical_band_gap_eV": 3.3
        }
      },
      "energy_tolerance": 0.1,
      "optical_tolerance": 0.1,
      "trend": {
        "energy": "increasing",
        "optical": "increasing"
      }
    },
    {
      "id": "bond_angles_check",
