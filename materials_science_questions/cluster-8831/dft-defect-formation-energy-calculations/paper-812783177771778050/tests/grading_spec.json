{
  "scoring_tier": "result-level compare",
  "scoring_justification": "DFT results are compute‑intensive and cannot be recomputed in the verifier; comparison to paper’s reference values with tolerances.",
  "pass_threshold": 0.6,
  "target_policies": {
    "dft_results.json": "exact_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold values for each field of dft_results.json",
      "source_provenance": "Paper Table 1, row TiN/WN₀.₅, Λ=3.327 nm; formation energy difference from paper text/Fig. 1 (vacancy‑containing lower, ca. –0.15 eV/atom); phonon_stable=T from Fig. 1b.",
      "generation_method": "direct read‑off from the paper’s reported data",
      "why_not_fabricated": "values are copied from the published table and figures; they are the authoritative reference for the experiment"
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "dft_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "properties": {
            "B": {
              "type": "number",
              "units": "GPa"
            },
            "G": {
              "type": "number",
              "units": "GPa"
            },
            "E": {
              "type": "number",
              "units": "GPa"
            },
            "B_over_G": {
              "type": "number"
            },
            "Cauchy_pressure": {
              "type": "number",
              "units": "GPa"
            },
            "poisson_ratio": {
              "type": "number"
            },
            "formation_energy_difference": {
              "type": "number",
              "units": "eV/atom"
            },
            "phonon_stable": {
              "type": "boolean"
            }
          },
          "required": [
            "B",
            "G",
            "E",
            "B_over_G",
            "Cauchy_pressure",
            "poisson_ratio",
            "formation_energy_difference",
            "phonon_stable"
          ]
        },
        "description": "Computed elastic moduli, B/G ratio, Cauchy pressure, formation energy difference, and phonon stability verdict for the TiN/WN₀.₅ superlattice with bilayer period ~3.3 nm."
      }
    ],
    "notes": "The agent must perform the DFT workflow using Quantum ESPRESSO (or another open-source plane-wave DFT code) and Phonopy. The hidden checker compares the submitted values to the paper's reference values with appropriate tolerances."
  },
  "steps": [
    {
      "id": "dft_B",
      "output_file": "dft_results.json",
      "kind": "numeric_match",
      "field": "B",
      "target": 307.0,
      "tolerance": 30.0,
      "weight": 0.15
    },
    {
      "id": "dft_G",
      "output_file": "dft_results.json",
      "kind": "numeric_match",
      "field": "G",
      "target": 125.0,
      "tolerance": 30.0,
      "weight": 0.15
    },
    {
      "id": "dft_E",
      "output_file": "dft_results.json",
      "kind": "numeric_match",
      "field": "E",
      "target": 331.0,
      "tolerance": 30.0,
      "weight": 0.15
    },
    {
      "id": "dft_B_over_G",
      "output_file": "dft_results.json",
      "kind": "numeric_match",
      "field": "B_over_G",
      "target": 2.456,
      "tolerance": 0.05,
      "weight": 0.1
    },
    {
      "id": "dft_Cauchy",
      "output_file": "dft_results.json",
      "kind": "numeric_match",
      "field": "Cauchy_pressure",
      "target": 80.0,
      "tolerance": 50.0,
      "weight": 0.15
    },
    {
      "id": "dft_poisson",
      "output_file": "dft_results.json",
      "kind": "numeric_match",
      "field": "poisson_ratio",
      "target": 0.32,
      "tolerance": 0.05,
      "weight": 0.1
    },
    {
      "id": "dft_form_energy",
      "output_file": "dft_results.json",
      "kind": "formation_energy_check",
      "field": "formation_energy_difference",
      "target": -0.15,
      "tolerance": 0.02,
      "weight": 0.1
    },
    {
      "id": "dft_phonon",
      "output_file": "dft_results.json",
      "kind": "boolean_check",
      "field": "phonon_stable",
      "expected": true,
      "weight": 0.1
    }
  ]
}