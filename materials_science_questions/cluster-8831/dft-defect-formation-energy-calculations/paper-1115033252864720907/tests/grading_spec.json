          "relation": "lt"
        },
        {
          "defect1": "Cu_Ce^{2-}",
          "defect2": "Cu_i^+",
          "relation": "lt"
        },
        {
          "defect1": "Ni_Ce^{2-}",
          "defect2": "Ni_i^{2+}",
          "relation": "lt"
        }
      ]
    },
    {
      "id": "migration_barriers",
      "output_file": "migration_barriers.json",
      "kind": "json_field",
      "weight": 0.15,
      "fields": {
        "polaron_etaCe_minus_barrier_eV": {
          "target": 0.19,
          "tolerance_abs": 0.05
        },
        "oxygen_vacancy_VO2plus_barrier_eV": {
          "target": 0.72,
          "tolerance_abs": 0.05
        },
        "hydrogen_interstitial_Hi_plus_barrier_eV": {
          "target": 0.06,
          "tolerance_abs": 0.05
        }
      }
    }
  ]
}