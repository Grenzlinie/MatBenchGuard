{
  "version": 1,
  "resources": [
    {
      "id": "dft_code",
      "name": "Quantum ESPRESSO (open-source DFT code) or equivalent",
      "type": "tool",
      "access": {
        "method": "url",
        "url": "https://www.quantum-espresso.org/download",
        "notes": "Must support PBE-GGA with PAW pseudopotentials. Alternative: GPAW."
      }
    },
    {
      "id": "pseudopotentials",
      "name": "PBE PAW pseudopotentials for W, Ti, V, Zr, Nb, Hf, Ta, Re",
      "type": "dataset",
      "access": {
        "method": "url",
        "url": "https://www.quantum-espresso.org/pseudopotentials",
        "notes": "Also available from SSSP or other standard libraries. Include potentials with and without semicore (W 5p) states."
      }
    },
    {
      "id": "ase",
      "name": "Atomic Simulation Environment (ASE)",
      "type": "package",
      "required": false,
      "access": {
        "method": "package",
        "package": "ase",
        "notes": "pip install ase"
      }
    },
    {
      "id": "pymatgen",
      "name": "Pymatgen",
      "type": "package",
      "required": false,
      "access": {
        "method": "package",
        "package": "pymatgen",
        "notes": "pip install pymatgen"
      }
    },
    {
      "id": "numpy_pandas",
      "name": "numpy, pandas",
      "type": "package",
      "required": false,
      "access": {
        "method": "package",
        "package": "numpy pandas",
        "notes": "pip install numpy pandas"
      }
    }
  ]
}