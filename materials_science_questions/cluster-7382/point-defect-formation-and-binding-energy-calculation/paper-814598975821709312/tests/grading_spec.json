{
  "scoring_tier": "recompute",
  "scoring_justification": "Checker recomputes structural relationships (ordering, binding sign) from submitted CSV artifacts and compares formation energies to paper-reported gold with tolerance; a full DFT recompute is infeasible in the verifier, but the result-level comparison is sufficient for this compute-driven reproduction.",
  "pass_threshold": 0.1,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold formation energies for all defects from paper Table 1.",
      "source_provenance": "Paper Table 1 (final corrected formation energies).",
      "generation_method": "Copied directly from the paper's Table 1 as reported.",
      "why_not_fabricated": "Values are the exact paper-reported numbers used as reference; the checker compares submitted formation energies against these within tolerance."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "formation_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "element",
            "defect_type",
            "formation_energy_eV"
          ],
          "description": "element: W, Ti, V, Zr, Nb, Hf, Ta, Re; defect_type: sub, bridge, 111, 110; formation_energy_eV: float in eV."
        },
        "description": "Final corrected formation energies for all substitutional and interstitial defects. Checker compares values within tolerance and verifies ordering for Ti, V, Re."
      },
      {
        "file": "binding_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "table",
          "required_columns": [
            "element",
            "binding_energy_eV"
          ],
          "description": "element: Ti, V, Zr, Nb, Hf, Ta, Re; binding_energy_eV: float, negative indicates attraction."
        },
        "description": "Binding energies between self-interstitial atoms and substitutional solutes. Checker verifies that binding is negative for Ti, V, Re."
      }
    ],
    "notes": "Formation volumes and anisotropy analysis are excluded as they are not in the scored scope."
  },
  "steps": [
    {
      "id": "step3_formation_csv_accuracy",
      "output_file": "formation_energies.csv",
      "kind": "numeric",
      "weight": 0.4,
      "tolerance": 0.15,
      "description": "Compare each formation energy to paper-reported gold values with absolute tolerance."
    },
    {
      "id": "step3_formation_csv_ordering",
      "output_file": "formation_energies.csv",
      "kind": "structural",
      "weight": 0.3,
      "elements": [
        "Ti",
        "V",
        "Re"
      ],
      "tolerance_diff": 0.05,
      "description": "Verify bridge formation energy is lower than both 111 and 110 for Ti, V, Re."
    },
    {
      "id": "step4_binding_csv",
      "output_file": "binding_energies.csv",
      "kind": "numeric",
      "weight": 0.3,
      "elements": [
        "Ti",
        "V",
        "Re"
      ],
      "description": "Check binding energy is negative for Ti, V, Re."
    }
  ],
