  "steps": [
    {
      "id": "scored_analysis",
      "output_file": "simulation_results.json",
      "kind": "recompute_metric",
      "description": "Verify all six categories of structural, dynamic and electronic properties: g(r) features, S(q) features, bond-angle distributions, CSRO parameters, diffusion coefficients, and DOS features.",
      "weight": 1.0,
      "metric": "category_passes",
      "target": 0.666,
      "tolerance_abs": 0.0,
      "tolerance_rel": 0.0,
      "rubric": {
        "criterion_1": "g(r): first peak 2.52±0.02 Å, second peak 4.58±0.08 Å, first peak height increases with decreasing T, second peak splits at 1403/1233 K.",
