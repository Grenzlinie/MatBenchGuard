{
  "scoring_tier": "recompute",
  "scoring_justification": "Recompute structural, dynamic and electronic features from the raw arrays in simulation_results.json (g(r), S(q), bond-angle distributions, CSRO parameters, diffusion coefficients, DOS) and compare to the paper's reported peak positions, trends, signs, and magnitudes with appropriate tolerances.",
  "pass_threshold": 0.666,
  "target_policies": {
