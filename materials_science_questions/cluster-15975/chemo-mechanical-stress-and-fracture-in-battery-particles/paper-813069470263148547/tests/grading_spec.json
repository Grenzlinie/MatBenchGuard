{
  "scoring_tier": "T0",
  "scoring_justification": "Result‑level compare of simulated voltage, swelling, and jig force time‑series to digitized experimental validation curves (paper Fig. 6) using normalized RMSE with thresholds ≤5 % (voltage, swelling) and ≤10 % (force), and comparison of anode surface concentrations to paper‑derived reference values (Fig. 8c) with monotonic pressure increase and ±15 % tolerance.",
  "pass_threshold": 0.6,
  "target_policies": {
    "step_01_validation_results.csv": "threshold_or_better",
    "step_02_lithiation_results.csv": "threshold_or_better"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference curves and values for scoring validation and lithiation results",
      "source_provenance": "Digitized from paper Fig. 6 (voltage, swelling, jig force vs SOC for stiff/soft configurations at C/5, C/2, 1C, 2C) and Fig. 8c (anode surface lithium concentration vs time/SOC at 0.4, 2.0, 4.0 MPa constant pressure during 5 A CC‑CV charge).",
      "generation_method": "Manually digitized data points from the published figures, then interpolated to a common SOC grid or selected SOC points. The curves follow the qualitative trends and approximate values reported in the paper’s description (e.g., jig force changes of ~1.5 kN for stiff and ~180 N for soft at C/5).",
      "why_not_fabricated": "The experimental validation curves are the authoritative reference that the paper’s model was compared against, and they are the correct benchmark for assessing reproduction accuracy."
    }
  ],
