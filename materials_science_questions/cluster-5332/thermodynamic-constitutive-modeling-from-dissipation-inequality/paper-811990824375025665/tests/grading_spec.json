{
  "scoring_tier": "recompute",
  "scoring_justification": "Bounds and ratio are deterministic algebraic functions of public material constants; energy‑nonincreasing for h within the proved bound is theoretically guaranteed, so it can be enforced without re‑simulating.",
  "pass_threshold": 0.6,
  "hidden_assets": [],
  "output_contract": {
