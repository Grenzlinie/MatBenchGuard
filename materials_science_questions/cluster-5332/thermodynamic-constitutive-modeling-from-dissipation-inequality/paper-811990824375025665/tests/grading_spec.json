    ],
    "notes": ""
  },
  "steps": [
    {
      "id": "bounds_check",
      "output_file": "results.json",
      "kind": "numeric",
      "weight": 0.4,
      "tolerance": 1e-06,
      "target_policy": "exact_match",
      "fields": {
