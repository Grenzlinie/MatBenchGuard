{
  "scoring_tier": "recompute",
  "scoring_justification": "Checker recomputes KA-predicted magnetization from raw CSV time series and compares to simulation via MAE, and compares percolation densities to paper gold.",
  "pass_threshold": 0.6,
  "target_policies": {
    "homogeneous_T0.8_h0.88_simulation.csv": "metric_recompute",
    "breakdown_T0.4_h0.6_simulation.csv": "metric_recompute",
    "percolation_results.json": "reference_match"
  },
  "ka_params": {
    "homogeneous": {
      "a": 1.957,
      "b": 10.75,
      "J_st": 1.75e-06,
      "t0": 19.96,
      "rho_seed": 0.0,
      "m0": 5
    },
    "breakdown": {
      "a": 0.0,
      "b": 693.5,
      "J_st": 0.0,
      "t0": 0.0,
      "rho_seed": 0.0011,
      "m0": 5
    }
  },
  "percolation_gold": {
    "homogeneous_T0.8_h0.88": 0.61,
    "breakdown_T0.4_h0.6": 0.67
  },
  "percolation_tolerances": {
    "homogeneous_T0.8_h0.88": 0.04,
    "breakdown_T0.4_h0.6": 0.06
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "KA model parameters from Table I of the paper, used to recompute KA prediction.",
      "source_provenance": "paper Table I",
      "generation_method": "extracted from paper",
      "why_not_fabricated": "These are the exact numbers reported in the paper for the two conditions."
    },
    {
      "path": "grading_spec_json.inline",
      "purpose": "Percolation area fractions gold values and tolerances",
      "source_provenance": "paper Table I (X_perc column) and text",
      "generation_method": "extracted from paper; tolerances set from paper's reported error bars and expected simulation scatter.",
      "why_not_fabricated": "These are the paper's reported percolation densities."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "homogeneous_T0.8_h0.88_simulation.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "t",
            "M"
          ],
          "header": false,
          "columns": [
            {
              "name": "t",
              "type": "float",
              "description": "time in full lattice updates"
            },
            {
              "name": "M",
              "type": "float",
              "description": "magnetization"
            }
          ]
        },
        "description": "Magnetization time series for homogeneous nucleation at T=0.8, h=0.88."
      },
      {
        "file": "breakdown_T0.4_h0.6_simulation.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "t",
            "M"
          ],
          "header": false,
          "columns": [
            {
              "name": "t",
              "type": "float",
              "description": "time in full lattice updates"
            },
            {
              "name": "M",
              "type": "float",
              "description": "magnetization"
            }
          ]
        },
        "description": "Magnetization time series for prenucleated system at T=0.4, h=0.6."
      },
      {
        "file": "percolation_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "homogeneous_T0.8_h0.88",
            "breakdown_T0.4_h0.6"
          ],
          "properties": {
            "homogeneous_T0.8_h0.88": {
              "type": "number"
            },
            "breakdown_T0.4_h0.6": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "description": "Percolation area fractions for the two simulation conditions."
      }
    ],
    "notes": "The checker recomputes the mean absolute error between the agent's M(t) and the KA-predicted magnetization for each condition. The percolation fractions are compared to hidden reference values."
  },
  "steps": [
    {
      "id": "homogeneous_mae",
      "output_file": "homogeneous_T0.8_h0.88_simulation.csv",
      "weight": 0.3,
      "kind": "mae_check",
      "target_policy": "threshold_or_better",
      "threshold_mae": 0.05,
      "description": "Mean absolute error between simulation magnetization and KA prediction; lower is better, full credit if <= 0.05."
    },
    {
      "id": "breakdown_mae",
      "output_file": "breakdown_T0.4_h0.6_simulation.csv",
      "weight": 0.3,
      "kind": "deviation_check",
      "min_mae": 0.2,
      "description": "MAE must be high enough (>= 0.2) to indicate breakdown; partial credit for intermediate values."
    },
    {
      "id": "percolation_check",
      "output_file": "percolation_results.json",
      "weight": 0.4,
      "kind": "percolation_match",
      "description": "Percolation area fractions must match paper gold within tolerance."
    }
  ]
}