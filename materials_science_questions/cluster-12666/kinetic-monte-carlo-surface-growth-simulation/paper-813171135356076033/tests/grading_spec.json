{
  "scoring_tier": "recompute",
  "scoring_justification": "Peak temperatures are recomputed from TPD CSV files and compared to paper-reported values within tolerance; site analysis is verified structurally; peak consistency cross-checks self-reported values against recomputed peaks. T1 recompute feasible for the main quantity.",
  "pass_threshold": 0.6,
  "target_policies": {
    "tpd_co.csv": "exact_match",
    "tpd_ni.csv": "exact_match",
    "peak_temperatures.json": "exact_match",
    "site_analysis_co.json": "structural_audit",
    "site_analysis_ni.json": "structural_audit"
  },
  "hidden_assets": [],
  "output_contract": {
    "outputs": [
      {
        "file": "tpd_co.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "temperature",
            "desorption_rate"
          ],
          "units": {
            "temperature": "K",
            "desorption_rate": "s^{-1}"
          }
        },
        "description": "Co/Pt TPD spectrum. The checker recomputes the peak temperature from this data and compares to the paper's reported value (within tolerance), and also verifies that the Co peak is higher than the Ni peak."
      },
      {
        "file": "site_analysis_co.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "object",
          "required": {
            "fcc": {
              "average_occupation": "float",
              "average_association_rate": "float"
            },
            "hcp": {
              "average_occupation": "float",
              "average_association_rate": "float"
            },
            "step_110": {
              "average_occupation": "float",
              "average_association_rate": "float"
            },
            "step_100": {
              "average_occupation": "float",
              "average_association_rate": "float"
            },
            "edge": {
              "average_occupation": "float",
              "average_association_rate": "float"
            }
          }
        },
        "description": "Site-resolved kinetics for Co/Pt. Checked for expected site types, occupation in [0,1], and non-negative association rates."
      },
      {
        "file": "tpd_ni.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "temperature",
            "desorption_rate"
          ],
          "units": {
            "temperature": "K",
            "desorption_rate": "s^{-1}"
          }
        },
        "description": "Ni/Pt TPD spectrum. The checker recomputes the peak temperature and compares to the paper's reported value."
      },
      {
        "file": "site_analysis_ni.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "object",
          "required": {
            "fcc": {
              "average_occupation": "float",
              "average_association_rate": "float"
            },
            "hcp": {
              "average_occupation": "float",
              "average_association_rate": "float"
            },
            "step_110": {
              "average_occupation": "float",
              "average_association_rate": "float"
            },
            "step_100": {
              "average_occupation": "float",
              "average_association_rate": "float"
            },
            "edge": {
              "average_occupation": "float",
              "average_association_rate": "float"
            }
          }
        },
        "description": "Site-resolved kinetics for Ni/Pt."
      },
      {
        "file": "peak_temperatures.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": {
            "co_peak_T": "float",
            "ni_peak_T": "float"
          }
        },
        "description": "Self-reported peak temperatures. The checker will cross-validate them against peaks recomputed from the CSV files."
      }
    ],
    "notes": "The agent must implement a standard lattice KMC algorithm with variable-rate continuous-time Monte Carlo. The KMC input energetics are provided in /resources/kmc_inputs.json. The checker does not require the npz trajectory files; only the listed scored artifacts are validated."
  },
  "steps": [
    {
      "id": "recompute_co_peak",
      "output_file": "tpd_co.csv",
      "kind": "numeric",
      "target": 720.0,
      "tolerance": 30.0,
      "weight": 0.25,
      "description": "Recompute Co/Pt desorption peak temperature from tpd_co.csv"
    },
    {
      "id": "recompute_ni_peak",
      "output_file": "tpd_ni.csv",
      "kind": "numeric",
      "target": 640.0,
      "tolerance": 30.0,
      "weight": 0.25,
      "description": "Recompute Ni/Pt desorption peak temperature from tpd_ni.csv"
    },
    {
      "id": "co_ni_order",
      "output_file": null,
      "kind": "trend",
      "target": "co_peak > ni_peak",
      "tolerance": 0.0,
      "weight": 0.15,
      "description": "Verify Co peak temperature is higher than Ni peak temperature"
    },
    {
      "id": "site_analysis_co",
      "output_file": "site_analysis_co.json",
      "kind": "structural",
      "target": null,
      "tolerance": null,
      "weight": 0.1,
      "description": "Validate Co/Pt site analysis structure and plausible values"
    },
    {
      "id": "site_analysis_ni",
      "output_file": "site_analysis_ni.json",
      "kind": "structural",
      "target": null,
      "tolerance": null,
      "weight": 0.1,
      "description": "Validate Ni/Pt site analysis structure and plausible values"
    },
    {
      "id": "peak_consistency",
      "output_file": "peak_temperatures.json",
      "kind": "numeric",
      "target": null,
      "tolerance": 0.001,
      "weight": 0.15,
      "description": "Cross-check self-reported peak temperatures against recomputed peaks from CSVs"
    }
  ]
}