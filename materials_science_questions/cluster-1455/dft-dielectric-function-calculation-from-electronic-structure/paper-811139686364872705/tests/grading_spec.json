          "bandgap_type": "indirect"
        },
        {
          "strain_percent": -2.0,
          "bandgap_eV": 1.155,
          "bandgap_type": "indirect"
        },
        {
          "strain_percent": -1.0,
          "bandgap_eV": 1.265,
          "bandgap_type": "indirect"
        },
        {
          "strain_percent": 0.0,
          "bandgap_eV": 1.364,
          "bandgap_type": "indirect"
        },
        {
          "strain_percent": 1.0,
          "bandgap_eV": 1.395,
          "bandgap_type": "indirect"
        },
        {
          "strain_percent": 2.0,
          "bandgap_eV": 1.375,
          "bandgap_type": "indirect"
        },
        {
          "strain_percent": 3.0,
