          "bandgap_type": "direct"
        }
      ]
    },
    {
      "id": "check_absorption",
      "output_file": "absorption_data.csv",
      "weight": 0.4,
      "kind": "recompute_metric",
      "energy_range_eV": [
        1.0,
        4.0
      ],
      "required_ratio_min": 1.17
    }
  ]
