{
  "scoring_tier": "recompute",
  "scoring_justification": "Dielectric function is recomputed from agent's CSV to check peaks and anisotropy; band gap and PDOS features are result-level compared with paper tolerances. Recompute T1 is feasible for dielectric.",
  "pass_threshold": 0.6,
  "target_policies": {
    "band_gap.json": "exact_match",
    "pdos_features.json": "structural_audit",
    "dielectric_function.csv": "metric_recompute"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper-reported indirect band gap, PDOS features, dielectric function peak positions and anisotropy thresholds",
      "source_provenance": "Paper text, sections 3, Figure 4, Figure 6, Figure 7",
      "generation_method": "Values extracted directly from the paper's textual description and figure annotations",
      "why_not_fabricated": "These are the exact values reported in the paper; no alternative source."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "band_gap.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": {
            "indirect_band_gap_eV": "float (eV)"
          }
        },
        "description": "Computed indirect band gap of CaBi2Ta2O9."
      },
      {
        "file": "pdos_features.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "object",
          "required": {
            "low_band_peak_eV": "float (eV)",
            "valence_band_min_eV": "float (eV)",
            "valence_band_max_eV": "float (eV)",
            "conduction_hybrid_min_eV": "float (eV)",
            "conduction_hybrid_max_eV": "float (eV)",
            "ta_o_hybridization": "bool"
          }
        },
        "description": "Extracted features from the partial density of states that verify orbital hybridization patterns."
      },
      {
        "file": "dielectric_function.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "energy_eV",
            "epsilon2_avg",
            "epsilon2_xx",
            "epsilon2_yy",
            "epsilon2_zz"
          ],
          "units": {
            "energy_eV": "eV",
            "epsilon2_avg": "dimensionless",
            "epsilon2_xx": "dimensionless",
            "epsilon2_yy": "dimensionless",
            "epsilon2_zz": "dimensionless"
          }
        },
        "description": "Imaginary dielectric function components for photon energies 0-13 eV. The checker will recompute peak positions and anisotropy metrics."
      }
    ],
    "notes": "The original study used Wien2k; this task is scoped to open-source DFT codes. Tolerances are chosen to absorb method/code differences."
  },
  "steps": [
    {
      "id": "band_gap",
      "output_file": "band_gap.json",
      "weight": 0.25,
      "kind": "numeric",
      "target_policy": "exact_match",
      "field": "indirect_band_gap_eV",
      "target": 3.114,
      "tolerance": 0.2,
      "description": "Check indirect band gap matches paper within 0.2 eV"
    },
    {
      "id": "pdos_analysis",
      "output_file": "pdos_features.json",
      "weight": 0.25,
      "kind": "structural_audit",
      "checks": {
        "low_band_peak": {
          "field": "low_band_peak_eV",
          "target": -12.0,
          "tolerance": 0.5
        },
        "valence_band_min": {
          "field": "valence_band_min_eV",
          "target": -8.57,
          "tolerance": 0.5
        },
        "valence_band_max": {
          "field": "valence_band_max_eV",
          "target": -3.34,
          "tolerance": 0.5
        },
        "conduction_hybrid_min": {
          "field": "conduction_hybrid_min_eV",
          "target": 0.0,
          "tolerance": 0.5
        },
        "conduction_hybrid_max": {
          "field": "conduction_hybrid_max_eV",
          "target": 4.0,
          "tolerance": 0.5
        },
        "ta_o_hybridization": {
          "field": "ta_o_hybridization",
          "expected": true
        }
      },
      "description": "Verify PDOS features match orbital hybridization patterns from paper"
    },
    {
      "id": "dielectric_function",
      "output_file": "dielectric_function.csv",
      "weight": 0.5,
      "kind": "recompute",
      "target_policy": "metric_recompute",
      "peak_targets": [
        5.0,
        5.45,
        7.0
      ],
      "peak_tolerance": 0.5,
      "isotropy_max_energy": 4.0,
      "max_rel_diff_isotropy": 0.05,
      "anisotropy_min_energy": 4.0,
      "anisotropy_min_diff": 0.5,
      "description": "Recompute peak positions and anisotropy from dielectric function CSV"
    }
  ]
}