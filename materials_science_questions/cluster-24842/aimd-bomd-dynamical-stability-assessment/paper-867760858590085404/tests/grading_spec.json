            "eta_GK",
            "D_GK"
          ],
          "units": {
            "temperature": "K",
            "eta_GK": "Pa·s",
            "D_GK": "m²/s"
          }
        },
        "description": "TIP4P/2005 force-field shear viscosity and finite-size-corrected self-diffusion coefficient at five temperatures."
      },
