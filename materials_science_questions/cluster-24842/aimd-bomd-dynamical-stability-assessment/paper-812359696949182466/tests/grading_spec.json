    {
      "id": "ga13_peak",
      "output_file": "ga13_specific_heat.csv",
      "kind": "peak_comparison",
      "weight": 0.4,
      "description": "Peak temperature for Ga13",
      "target_temperature": 1400,
      "tolerance_abs": 50.0,
      "column_temp": "temperature_K",
      "column_cv": "normalized_specific_heat"
    },
    {
      "id": "trend_check",
      "output_file": "ga17_specific_heat.csv",
      "kind": "trend",
      "weight": 0.2,
      "description": "Trend: both peaks > 303 K and Ga13 peak > Ga17 peak"
    }
  ]
