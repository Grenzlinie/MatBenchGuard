{
  "scoring_tier": "recompute",
  "scoring_justification": "PDOS enhancement recomputed via integration; lattice parameters and binding energies compared to paper values with tolerances.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper-reported DFT values: lattice parameters, band gap, binding energies, bond lengths",
      "source_provenance": "Paper text: a=7.35, b=7.60, c=7.76 Ang; band gap 1.42 eV; Ag binding 0.72 eV; glucose binding on WO3 -1.12 eV; glucose on Ag-WO3 -1.3 eV; bond lengths 2.39, 2.43 Ang",
      "generation_method": "Extracted directly from the paper's DFT results section.",
      "why_not_fabricated": "Values are the actual reported by the authors; used as tolerance targets."
