    },
    {
      "id": "r2",
      "name": "GGA-PBE pseudopotential library (e.g., SSSP, PseudoDojo)",
      "type": "dataset",
      "required": true,
      "public": true,
      "access": {
        "method": "url",
        "url": "https://www.materialscloud.org/discover/sssp/table/efficiency",
        "notes": "Standard pseudopotentials for K, Rb, Cl."
      }
    },
    {
      "id": "r3",
      "name": "BoltzTraP or equivalent transport code",
      "type": "tool",
      "required": true,
      "public": true,
      "access": {
        "method": "url",
        "url": "https://www.boltztrapp.org/",
        "notes": "Required for computing thermoelectric transport coefficients from the DFT band structure."
      }
    }
  ]
