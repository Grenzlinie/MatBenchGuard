{
  "scoring_tier": "structural",
  "scoring_justification": "Cannot recompute DFT; verify structural trends (ordering, threshold) and compare absolute values to paper reference with generous tolerances.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference band gaps, formation energies, absorption edges, and band edges from the paper and solve.sh used as gold for tolerance and trend checks.",
      "source_provenance": "Paper (Table 1 and text) and reference solve.sh values; all reflect the paper's reported numbers.",
      "generation_method": "Extracted from the paper and aligned with solve.sh to ensure the reference oracle passes at 1.0.",
      "why_not_fabricated": "All values are directly from the paper or the oracle output, guaranteeing consistency."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "band_gaps.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "System",
            "BandGap"
          ],
          "units": {
            "BandGap": "eV"
          }
        },
        "description": "Computed band gaps (eV) for undoped, monodoped, and codoped systems."
      },
      {
        "file": "formation_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "System",
            "FormationEnergy_OxygenRich",
            "FormationEnergy_OxygenPoor"
          ],
          "units": {
            "FormationEnergy_OxygenRich": "eV",
            "FormationEnergy_OxygenPoor": "eV"
          }
        },
        "description": "Defect formation energies (eV) under oxygen-rich and oxygen-poor conditions."
      },
      {
        "file": "absorption_edge.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "System",
            "AbsorptionEdgeWavelength"
          ],
          "units": {
            "AbsorptionEdgeWavelength": "nm"
          }
        },
        "description": "Optical absorption edge wavelengths (nm) where absorption coefficient > 10^4 cm^{-1}."
      },
      {
        "file": "band_edge_alignment.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "table",
          "required_columns": [
            "System",
            "VBM_vs_vacuum",
            "CBM_vs_vacuum"
          ],
          "units": {
            "VBM_vs_vacuum": "eV",
            "CBM_vs_vacuum": "eV"
          }
        },
        "description": "Absolute VBM and CBM positions (eV) relative to vacuum. The VBM must be below the H2O/O2 potential (-5.67 eV) and the CBM must be above the H+/H2 potential (-4.44 eV)."
      }
    ],
    "notes": "All columns must be present and values must be numeric. The band edge alignment is verified by threshold conditions: CBM > H+/H2 (-4.44 eV) and VBM < H2O/O2 (-5.67 eV)."
  },
  "steps": [
    {
      "id": "bg_check",
      "output_file": "band_gaps.csv",
      "weight": 0.35,
      "kind": "custom",
      "config": {
        "required_systems": [
          "undoped",
          "N_monodoped",
          "F_monodoped",
          "Cl_monodoped",
          "Br_monodoped",
          "I_monodoped",
          "(N,F)_codoped_strI",
          "(N,F)_codoped_strII",
          "(N,Cl)_codoped",
          "(N,Br)_codoped",
          "(N,I)_codoped"
        ],
        "undoped_gap_ref": 3.61,
        "undoped_tol": 0.3,
        "check_codoped_lt_undoped": true,
        "check_nf_smallest_among_codoped": true,
        "check_nf_strII_lt_strI": true
      }
    },
    {
      "id": "fe_check",
      "output_file": "formation_energies.csv",
      "weight": 0.4,
      "kind": "custom",
      "config": {
        "required_systems": [
          "N_monodoped",
          "F_monodoped",
          "Cl_monodoped",
          "Br_monodoped",
          "I_monodoped",
          "(N,F)_codoped_strI",
          "(N,F)_codoped_strII",
          "(N,Cl)_codoped",
          "(N,Br)_codoped",
          "(N,I)_codoped"
        ],
        "N_mono_rich_ref": 5.22,
        "N_mono_rich_tol": 1.0,
        "N_mono_poor_ref": 0.79,
        "N_mono_poor_tol": 1.0,
        "nf_poor_negative": true,
        "nf_strI_strII_poor_diff_max": 0.2,
        "nf_poor_lt_N_mono_poor": true,
        "halogen_rich_ordering": [
          "F_monodoped",
          "Cl_monodoped",
          "Br_monodoped",
          "I_monodoped"
        ],
        "halogen_poor_ordering": [
          "F_monodoped",
          "Cl_monodoped",
          "Br_monodoped",
          "I_monodoped"
        ]
      }
    },
    {
      "id": "ae_check",
      "output_file": "absorption_edge.csv",
      "weight": 0.1,
      "kind": "custom",
      "config": {
        "required_systems": [
          "undoped",
          "(N,F)_codoped_strI",
          "(N,F)_codoped_strII",
          "(N,Cl)_codoped",
          "(N,Br)_codoped",
          "(N,I)_codoped"
        ],
        "nf_longest_among_codoped": true,
        "codoped_gt_undoped": true
      }
    },
    {
      "id": "bea_check",
      "output_file": "band_edge_alignment.csv",
      "weight": 0.15,
      "kind": "custom",
      "config": {
        "required_systems": [
          "undoped",
          "(N,F)_codoped_strI",
          "(N,F)_codoped_strII",
          "(N,Cl)_codoped",
          "(N,Br)_codoped",
          "(N,I)_codoped"
        ],
        "cbm_threshold": -4.44,
        "vbm_threshold": -5.67
      }
    }
  ]
}