          "ni_ni_distance": 6.79,
          "delta_E": -30,
          "m_tot": 0,
          "coupling": "AFM"
        },
        {
          "case": "Case (3)",
          "ni_ni_distance": 7.49,
          "delta_E": -33,
          "m_tot": 0,
          "coupling": "AFM"
        },
        {
          "case": "Case (4)",
          "ni_ni_distance": 3.14,
          "delta_E": -91,
          "m_tot": 0,
          "coupling": "AFM"
        },
        {
          "case": "Case (5)",
          "ni_ni_distance": 6.79,
          "delta_E": -13,
          "m_tot": 0,
          "coupling": "AFM"
        },
        {
          "case": "Case (6)",
          "ni_ni_distance": 7.56,
          "delta_E": 30,
          "m_tot": 4,
          "coupling": "FM"
        }
      ],
      "tolerances": {
        "ni_ni_distance": 0.1,
        "delta_E_abs": 20,
        "delta_E_rel": 0.5,
        "m_tot": 0.1
      }
    },
    {
      "id": "check_trend",
      "output_file": "results.json",
      "kind": "trend",
      "weight": 0.1,
      "min_satisfied_pairs": 4,
      "pair_count": 6
    }
  ]
}