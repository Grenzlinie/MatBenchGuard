{
  "scoring_tier": "recompute",
  "scoring_justification": "Recompute relative energies (kcal/mol) from reported total energies and reactant energy, then compare to paper's Table I values within ±2 kcal/mol; also verify trend (anti TS < C2h TS) and structural absence of C2h TS geometry.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper-reported relative energies at 3-21G* and DZ+d basis sets from Table I of the paper.",
      "source_provenance": "Table I, J. Am. Chem. Soc. 1993, 115, 3322–3324.",
      "generation_method": "Direct extraction from the published table.",
      "why_not_fabricated": "These are the exact published numerical results that the reproduction aims to match; they are publicly available in the original paper."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "dimerization_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "top-level": [
              "energies",
              "geometries"
            ]
          },
          "items": {
            "energies": {
              "type": "array",
              "item": {
                "type": "object",
                "required": [
                  "state",
                  "level",
                  "energy_au",
                  "relative_kcal"
                ]
              }
            },
            "geometries": {
              "type": "object",
              "properties": {
                "*": {
                  "type": "array",
                  "item": {
                    "type": "object",
                    "required": [
                      "element",
                      "x",
                      "y",
                      "z"
                    ]
                  }
                }
              }
            }
          }
        },
        "description": "Compiled absolute and relative energies plus final geometries for all critical points of the silaethylene dimerization at CAS‑SCF(4,4)/3‑21G* and CAS‑SCF(4,4)/DZ+d levels."
      }
    ],
    "notes": "The agent must run the quantum chemistry calculations itself; the output file must contain the energies and geometries derived from those runs. The checker compares the reported relative energies to hidden paper references within ±2 kcal/mol tolerance and validates selected bond lengths and angles within ±0.05 Å and ±2°."
  },
  "steps": [
