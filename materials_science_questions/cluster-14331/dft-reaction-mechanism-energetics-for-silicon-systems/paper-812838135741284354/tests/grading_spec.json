{
  "scoring_tier": "recompute",
  "scoring_justification": "Energies compared to fixed reference values; fall-off ratios are recomputed from raw CSV; falloff summary cross-checked with recomputed breakdown pressure.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold CBS-QB3 energies and rate constants from paper Tables 2,3,8.",
      "source_provenance": "Extracted directly from Tables 2,3 (energies) and Table 8 (rate constants) of the paper.",
      "generation_method": "Manual transcription from the published manuscript.",
      "why_not_fabricated": "These are the paper's own reported values; they are the authoritative reference for reproduction verification."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "energies.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "R1->P1": {
              "activation": {
                "delta_E0_dagger": "kcal/mol",
                "delta_H298_dagger": "kcal/mol",
                "delta_G298_dagger": "kcal/mol"
              },
              "reaction": {
                "delta_E0": "kcal/mol",
                "delta_H298": "kcal/mol",
                "delta_G298": "kcal/mol"
              }
            },
            "R2->P2": "same structure",
            "R3->P3": "same structure",
            "R4->P4": "same structure"
          }
        },
        "description": "Activation and reaction energies for all four pathways at an equivalent CBS-QB3 composite level."
      },
      {
        "file": "rate_constants.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "pathway",
            "temperature_C",
            "pressure_bar",
            "TST_rate",
            "RRKM_rate"
          ],
          "units": {
            "temperature_C": "degrees Celsius",
            "pressure_bar": "bar",
            "TST_rate": "s^-1",
            "RRKM_rate": "s^-1"
          }
        },
        "description": "TST and RRKM unimolecular rate constants for all four pathways over the experimental temperature range and a pressure grid covering 10⁻¹² to 10² bar."
      },
      {
        "file": "falloff_summary.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "object",
          "required": {
            "pathway1_falloff": "bool",
            "breakdown_pressure_bar": "float (bar)"
          }
        },
        "description": "Boolean and pressure threshold where TST/RRKM ratio drops below 0.9 for pathway 1."
      }
    ],
    "notes": "The energies should be computed using an open-source composite method of CBS-QB3 quality. Lennard-Jones parameters for RRKM can be taken from the paper's Table 1 or standard sources; they are not separately scored."
  },
  "steps": [
    {
      "id": "energies_check",
      "output_file": "energies.json",
      "kind": "json_field",
      "weight": 0.4,
      "tolerance_abs": 2.0,
      "gold_energies": {
        "R1->P1": {
          "activation": {
            "delta_E0_dagger": 33.051,
            "delta_H298_dagger": 32.771,
            "delta_G298_dagger": 34.357
          },
          "reaction": {
            "delta_E0": -13.023,
            "delta_H298": -12.659,
            "delta_G298": -22.275
          }
        },
        "R2->P2": {
          "activation": {
            "delta_E0_dagger": 38.117,
            "delta_H298_dagger": 37.861,
            "delta_G298_dagger": 38.957
          },
          "reaction": {
            "delta_E0": -17.476,
            "delta_H298": -17.047,
            "delta_G298": -28.726
          }
        },
        "R3->P3": {
          "activation": {
            "delta_E0_dagger": 41.317,
            "delta_H298_dagger": 41.202,
            "delta_G298_dagger": 41.639
          },
          "reaction": {
            "delta_E0": -16.485,
            "delta_H298": -15.954,
            "delta_G298": -28.105
          }
        },
        "R4->P4": {
          "activation": {
            "delta_E0_dagger": 42.808,
            "delta_H298_dagger": 42.756,
            "delta_G298_dagger": 43.476
          },
          "reaction": {
            "delta_E0": -14.342,
            "delta_H298": -13.782,
            "delta_G298": -24.898
          }
        }
      }
    },
    {
      "id": "rates_reference",
      "output_file": "rate_constants.csv",
      "kind": "numeric",
      "weight": 0.2,
      "tolerance_factor": 5.0,
      "gold_rates": {
        "151": {
          "TST_rate": 9.79e-05,
          "RRKM_rate": 4.73e-05
        },
        "201": {
          "TST_rate": 0.00543,
          "RRKM_rate": 0.00265
        },
        "246.4": {
          "TST_rate": 0.107,
          "RRKM_rate": 0.0526
        }
      }
    },
    {
      "id": "rates_falloff",
      "output_file": "rate_constants.csv",
      "kind": "recompute_metric",
      "weight": 0.2,
      "description": "Recompute TST/RRKM ratio for pathway 1; verify ratio < 0.9 at some pressure <= 1e-4 bar."
    },
    {
      "id": "falloff_summary",
      "output_file": "falloff_summary.json",
      "kind": "structural_audit",
      "weight": 0.2,
      "description": "Verify pathway1_falloff is true and breakdown_pressure_bar <= 1e-4 bar."
    }
  ]
}