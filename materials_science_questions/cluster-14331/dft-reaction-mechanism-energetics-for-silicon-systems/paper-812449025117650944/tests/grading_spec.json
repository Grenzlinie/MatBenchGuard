{
  "scoring_tier": "reference_match",
  "scoring_justification": "ZPE-corrected barriers cannot be recomputed from the artifact because raw ZPE values are not submitted; use paper gold with tolerance. Internal consistency of raw barriers is recomputed from agent's own raw MP2 energies (T1 check).",
  "pass_threshold": 0.5,
  "target_policies": {
    "energies.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold reference values for all activation barriers and bond enthalpies",
      "source_provenance": "Extracted from Table 1 and Table 2 of the paper (DOI 10.1016/s0169-4332(97)80052-9): raw Ea 39.0 (TS2a) / 53.7 (TS2b); ZPE-corrected Ea 40.7 / 55.4; bond enthalpies 83.4 (Si-H) / 68.8 (Si-Si) kcal/mol.",
      "generation_method": "Directly transcribed from paper tables.",
      "why_not_fabricated": "All values are the published experimental results; they serve as authentic hidden comparison targets."
    }
  ],
  "output_contract": {
    "outputs": [
      {
