  "steps": [
    {
      "id": "consistency_raw_ea_ts2a",
      "output_file": "energies.json",
      "kind": "custom",
      "weight": 0.05,
      "description": "Recompute raw electronic barrier for TS2a from reported raw MP2 energies and compare to reported ts2a_MP2_Ea_kcal_mol_raw; tolerance 0.001 hartree"
    },
    {
      "id": "consistency_raw_ea_ts2b",
      "output_file": "energies.json",
      "kind": "custom",
      "weight": 0.05,
      "description": "Recompute raw electronic barrier for TS2b from reported raw MP2 energies and compare to reported ts2b_MP2_Ea_kcal_mol_raw; tolerance 0.001 hartree"
    },
    {
      "id": "surface_raw_ea_check",
      "output_file": "energies.json",
      "kind": "custom",
      "weight": 0.2,
      "description": "Compare reported raw activation energies (TS2a, TS2b) to paper gold (39.0, 53.7 kcal/mol) within ±3.0 kcal/mol"
    },
    {
      "id": "surface_zpe_ea_check",
      "output_file": "energies.json",
      "kind": "custom",
      "weight": 0.3,
      "description": "Compare reported ZPE-corrected activation energies (TS2a, TS2b) to paper gold (40.7, 55.4 kcal/mol) within ±3.0 kcal/mol"
    },
    {
      "id": "gas_bond_enthalpy_check",
      "output_file": "energies.json",
      "kind": "custom",
      "weight": 0.2,
      "description": "Compare reported gas-phase bond dissociation enthalpies (Si-H, Si-Si) to paper gold (83.4, 68.8 kcal/mol) within ±4.0 kcal/mol"
    },
    {
      "id": "surface_ordering",
      "output_file": "energies.json",
      "kind": "custom",
      "weight": 0.1,
      "description": "Verify that ZPE-corrected activation energy for Si-H splitting (TS2a) is lower than for Si-Si splitting (TS2b)"
    },
    {
      "id": "gas_ordering",
      "output_file": "energies.json",
      "kind": "custom",
      "weight": 0.1,
      "description": "Verify that gas-phase bond dissociation enthalpy of Si-H is greater than that of Si-Si"
    }
  ]
}