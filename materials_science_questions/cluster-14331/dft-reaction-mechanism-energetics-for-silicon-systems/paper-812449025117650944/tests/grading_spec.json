              "properties": {
                "SiH4_MP2_energy_hartree": {
                  "type": "number",
                  "units": "hartree"
                },
                "SiH3_MP2_energy_hartree": {
                  "type": "number",
                  "units": "hartree"
                },
                "H_MP2_energy_hartree": {
                  "type": "number",
                  "units": "hartree"
                },
                "Si2H6_MP2_energy_hartree": {
                  "type": "number",
                  "units": "hartree"
                },
                "SiH_bond_enthalpy_kcal_mol": {
                  "type": "number",
                  "units": "kcal/mol"
