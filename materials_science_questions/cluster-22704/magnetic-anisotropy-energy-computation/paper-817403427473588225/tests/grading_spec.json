{
  "scoring_tier": "consistency",
  "scoring_justification": "Full recompute from raw DFT outputs not feasible in verifier; agent submits computed values (output of DFT pipeline) which are compared to paper-reported gold values with tolerances; directional trends (MAE signs) also checked.",
  "pass_threshold": 0.6,
  "target_policies": {
    "bulk_results.json": "reference_match",
    "mae_results.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold values for bulk structural parameters and energy differences from paper Table I, and MAE values from Table II.",
      "source_provenance": "Paper Table I and Table II",
      "generation_method": "Extracted directly from the paper's reported values (a=8.25 Å, c/a=1.077, ΔE type I=0.03 eV/f.u., etc.; MAE values per Table II).",
      "why_not_fabricated": "These are the exact numerical results published in the source paper, traceable to the tables."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "bulk_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "a_type_II",
            "c_over_a_type_II",
            "delta_E_type_I",
            "delta_E_type_III",
            "delta_E_type_IV",
            "delta_E_normal"
          ],
          "properties": {
            "a_type_II": {
              "type": "number",
              "unit": "Å"
            },
            "c_over_a_type_II": {
              "type": "number",
              "unit": "dimensionless"
            },
            "delta_E_type_I": {
              "type": "number",
              "unit": "eV/f.u."
            },
            "delta_E_type_III": {
              "type": "number",
              "unit": "eV/f.u."
            },
            "delta_E_type_IV": {
              "type": "number",
              "unit": "eV/f.u."
            },
            "delta_E_normal": {
              "type": "number",
              "unit": "eV/f.u."
            }
          }
        },
        "description": "Structural parameters and energy differences for bulk CuFe2O4 configurations."
      },
      {
        "file": "mae_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "bulk_CuFe2O4_MAE",
            "FeO_int_one_unit_CuFe2O4_MgO_MAE",
            "FeO_int_two_unit_CuFe2O4_MgO_MAE",
            "CuO_int_one_unit_CuFe2O4_MgO_MAE",
            "FeO_int_one_unit_Fe3O4_MgO_MAE",
            "FeO_int_two_unit_Fe3O4_MgO_MAE"
          ],
          "properties": {
            "bulk_CuFe2O4_MAE": {
              "type": "number",
              "unit": "meV/f.u."
            },
            "FeO_int_one_unit_CuFe2O4_MgO_MAE": {
              "type": "number",
              "unit": "meV/f.u."
            },
            "FeO_int_two_unit_CuFe2O4_MgO_MAE": {
              "type": "number",
              "unit": "meV/f.u."
            },
            "CuO_int_one_unit_CuFe2O4_MgO_MAE": {
              "type": "number",
              "unit": "meV/f.u."
            },
            "FeO_int_one_unit_Fe3O4_MgO_MAE": {
              "type": "number",
              "unit": "meV/f.u."
            },
            "FeO_int_two_unit_Fe3O4_MgO_MAE": {
              "type": "number",
              "unit": "meV/f.u."
            }
          }
        },
        "description": "Magnetic anisotropy energy values for bulk and superlattice systems."
      }
    ],
    "notes": "The original paper used VASP; this reproduction replaces it with Quantum ESPRESSO (or another open-source plane-wave DFT code) following the same PBE+GGA+U and SOC treatment. Tolerances applied by the hidden checker account for implementation-dependent differences in pseudopotentials and basis sets."
  },
  "steps": [
    {
      "id": "bulk_a_type_II",
      "output_file": "bulk_results.json",
      "kind": "numeric",
      "path": "a_type_II",
      "weight": 0.1,
      "target": 8.25,
      "tolerance": 0.05
    },
    {
      "id": "bulk_c_over_a",
      "output_file": "bulk_results.json",
      "kind": "numeric",
      "path": "c_over_a_type_II",
      "weight": 0.1,
      "target": 1.077,
      "tolerance": 0.02
    },
    {
      "id": "bulk_delta_E_type_I",
      "output_file": "bulk_results.json",
      "kind": "numeric",
      "path": "delta_E_type_I",
      "weight": 0.05,
      "target": 0.03,
      "tolerance": 0.02
    },
    {
      "id": "bulk_delta_E_type_III",
      "output_file": "bulk_results.json",
      "kind": "numeric",
      "path": "delta_E_type_III",
      "weight": 0.05,
      "target": 0.05,
      "tolerance": 0.02
    },
    {
      "id": "bulk_delta_E_type_IV",
      "output_file": "bulk_results.json",
      "kind": "numeric",
      "path": "delta_E_type_IV",
      "weight": 0.1,
      "target": 0.14,
      "tolerance": 0.02
    },
    {
      "id": "bulk_delta_E_normal",
      "output_file": "bulk_results.json",
      "kind": "numeric",
      "path": "delta_E_normal",
      "weight": 0.1,
      "target": 0.61,
      "tolerance": 0.02
    },
    {
      "id": "mae_bulk_CuFe2O4",
      "output_file": "mae_results.json",
      "kind": "numeric",
      "path": "bulk_CuFe2O4_MAE",
      "weight": 0.08,
      "target": 0.12,
      "tolerance": 0.1
    },
    {
      "id": "mae_FeO_int_one_unit_CuFe2O4_MgO",
      "output_file": "mae_results.json",
      "kind": "numeric",
      "path": "FeO_int_one_unit_CuFe2O4_MgO_MAE",
      "weight": 0.08,
      "target": 0.32,
      "tolerance": 0.1
    },
    {
      "id": "mae_FeO_int_two_unit_CuFe2O4_MgO",
      "output_file": "mae_results.json",
      "kind": "numeric",
      "path": "FeO_int_two_unit_CuFe2O4_MgO_MAE",
      "weight": 0.08,
      "target": 0.24,
      "tolerance": 0.1
    },
    {
      "id": "mae_CuO_int_one_unit_CuFe2O4_MgO",
      "output_file": "mae_results.json",
      "kind": "numeric",
      "path": "CuO_int_one_unit_CuFe2O4_MgO_MAE",
      "weight": 0.08,
      "target": 0.05,
      "tolerance": 0.1
    },
    {
      "id": "mae_FeO_int_one_unit_Fe3O4_MgO",
      "output_file": "mae_results.json",
      "kind": "numeric",
      "path": "FeO_int_one_unit_Fe3O4_MgO_MAE",
      "weight": 0.08,
      "target": 0.23,
      "tolerance": 0.1
    },
    {
      "id": "mae_FeO_int_two_unit_Fe3O4_MgO",
      "output_file": "mae_results.json",
      "kind": "numeric",
      "path": "FeO_int_two_unit_Fe3O4_MgO_MAE",
      "weight": 0.08,
      "target": -0.14,
      "tolerance": 0.1
    },
    {
      "id": "mae_trend",
      "output_file": "mae_results.json",
      "kind": "rubric",
      "weight": 0.02,
      "description": "Verify that CuFe2O4-based MAE values are positive, Fe3O4 one-unit positive, Fe3O4 two-unit negative.",
      "conditions": [
        "bulk_CuFe2O4_MAE > 0",
        "FeO_int_one_unit_CuFe2O4_MgO_MAE > 0",
        "FeO_int_two_unit_CuFe2O4_MgO_MAE > 0",
        "CuO_int_one_unit_CuFe2O4_MgO_MAE > 0",
        "FeO_int_one_unit_Fe3O4_MgO_MAE > 0",
        "FeO_int_two_unit_Fe3O4_MgO_MAE < 0"
      ]
    }
  ]
}