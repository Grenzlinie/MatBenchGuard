    {
      "path": "grading_spec_json.inline",
      "purpose": "hidden gold ranges for species mole fractions and gold a,b coefficients",
      "source_provenance": "paper \"Radiochemistry\" Vol. 59 No. 5 2017, Fig. 1-3 and Table 3",
      "generation_method": "ranges extracted from paper's qualitative descriptions (e.g., ~78%, ~22%) and overall temperature behavior; exact coefficients from Table 3.",
      "why_not_fabricated": "these are the paper's reported values that the agent's computation must reproduce within tolerance; they are the true experimental result of the computational study."
    }
