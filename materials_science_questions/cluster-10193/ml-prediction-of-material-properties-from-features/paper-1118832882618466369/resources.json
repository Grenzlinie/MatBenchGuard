{
  "version": 1,
  "resources": [
    {
      "id": "r1",
      "name": "ESTM dataset (doped subset)",
      "type": "dataset",
      "required": true,
      "public": true,
      "access": {
        "method": "url",
        "url": "https://github.com/KRICT-DATA/SIMD",
        "notes": "File estm_dataset.csv in the repository. Intrinsic compounds must be filtered out, keeping only doped entries."
      }
    },
    {
      "id": "r2",
      "name": "SIMD descriptor generation code",
      "type": "tool",
      "required": true,
      "public": true,
      "access": {
        "method": "url",
        "url": "https://github.com/KRICT-DATA/SIMD",
        "notes": "Python implementation of System-Identified Material Descriptor."
      }
    },
    {
      "id": "r3",
      "name": "Magpie descriptor library",
      "type": "package",
      "required": true,
      "public": true,
      "access": {
        "method": "package",
        "package": "pymatgen or matminer",
        "notes": "Use pymatgen or matminer to compute Magpie descriptors from chemical formulas."
      }
    },
    {
      "id": "r4",
      "name": "Deep learning framework PyTorch",
      "type": "package",
      "required": true,
      "public": true,
      "access": {
        "method": "package",
        "package": "pytorch",
        "notes": "Used to implement WaveTENet residual blocks and training loop."
      }
    },
    {
      "id": "r5",
      "name": "PyWavelets",
      "type": "package",
      "required": true,
      "public": true,
      "access": {
        "method": "package",
        "package": "PyWavelets",
        "notes": "For Haar wavelet transform."
      }
    },
    {
      "id": "r6",
      "name": "WaveTENet reference implementation",
      "type": "tool",
      "required": false,
      "public": true,
      "access": {
        "method": "url",
        "url": "https://github.com/FlorianTseng/WaveTENet",
        "notes": "Optional reference repository provided by the authors. Not required for the reproduction."
      }
    }
  ]
}