{
  "scoring_tier": "recompute",
  "scoring_justification": "Recompute qualitative criteria counts and median MAPE from per-molecule rows; for dihedral summary and torsion 2d MAE, recompute per-row comparisons. All checks compare computed aggregates to paper-reported values with direction-appropriate tolerances, no need for raw predictions or hidden holdout labels.",
  "pass_threshold": 0.6,
  "target_policies": {
    "bond_stretch_metrics.csv": "threshold_or_better",
    "dihedral_summary.csv": "exact_match",
    "torsion_2d_mae.csv": "threshold_or_better"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold values for qualitative counts (r0, repulsive wall, attractive forces, spurious minima), median MAPE, dihedral angle and barrier energy, and 2D torsion MAE from the paper's Tables 1–3.",
      "source_provenance": "Paper: Table 1 (counts + median MAPE), Table 2 (dihedrals), Table 3 (torsion MAE).",
      "generation_method": "Values were extracted directly from the published tables in the journal PDF and verified against the textual discussion.",
      "why_not_fabricated": "These are the exact reported numbers the reproduction aims to match within expected toolchain tolerances; no invented or approximated values."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "bond_stretch_metrics.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "table",
          "required_columns": [
            "molecule",
            "method",
            "r0_correct",
            "repulsive_wall_correct",
            "attractive_forces_correct",
            "spurious_minima",
            "median_MAPE"
          ],
          "units": {
            "r0_correct": "1/0",
            "repulsive_wall_correct": "1/0",
            "attractive_forces_correct": "1/0",
            "spurious_minima": "1/0",
            "median_MAPE": "float"
          }
        },
        "description": "Per-molecule qualitative criteria counts and median MAPE for bond stretches; improvement over paper is not penalized."
      },
      {
        "file": "dihedral_summary.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "molecule",
            "method",
            "theta0_deg",
            "barrier_energy_kcal_per_mol"
          ],
          "units": {
            "theta0_deg": "degrees (integer)",
            "barrier_energy_kcal_per_mol": "kcal/mol"
          }
        },
        "description": "Lowest-energy dihedral angle and barrier for biphenyl and sucrose; checked within ±10° and ±20% tolerance."
      },
      {
        "file": "torsion_2d_mae.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "table",
          "required_columns": [
            "molecule",
            "method",
            "MAE_kcal_per_mol"
          ],
          "units": {
            "MAE_kcal_per_mol": "kcal/mol"
          }
        },
        "description": "Mean absolute error of 2D torsion scan energies; lower MAE is better."
      }
    ],
    "notes": "All models must be trained or used as specified. The solver must produce all three scored CSV files under /app/outputs. The checker will compare against paper-reported values with appropriate tolerances and directional scoring."
  },
