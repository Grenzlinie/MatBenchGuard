{
  "version": 1,
  "resources": [
    {
      "id": "dataset_cloud_points",
      "name": "Curated Cloud Point Dataset",
      "type": "dataset",
      "required": true,
      "access": {
        "method": "url",
        "url": "https://pppdb.uchicago.edu/",
        "notes": "Available via the Polymer Property Predictor and Database (3PDb) website. The agent must navigate to the cloud point data section and download the dataset (6524 cloud points, 21 polymers, 61 solvents)."
      }
    },
    {
      "id": "rdkit",
      "name": "RDKit",
      "type": "package",
      "required": true,
      "access": {
        "method": "package",
        "package": "rdkit-pypi",
        "notes": "Cheminformatics toolkit for generating molecular descriptors."
      }
    },
    {
      "id": "xgboost",
      "name": "XGBoost",
      "type": "package",
      "required": true,
      "access": {
        "method": "package",
        "package": "xgboost",
        "notes": "Gradient boosting library for regression."
      }
    },
    {
      "id": "tensorflow",
      "name": "TensorFlow",
      "type": "package",
      "required": true,
      "access": {
        "method": "package",
        "package": "tensorflow",
        "notes": "Deep learning framework for building the neural network model."
      }
    },
    {
      "id": "hyperopt",
      "name": "Hyperopt",
      "type": "package",
      "required": false,
      "access": {
        "method": "package",
        "package": "hyperopt",
        "notes": "Optional: Bayesian optimization for hyperparameter tuning."
      }
    }
  ]
}