{
  "scoring_tier": "recompute",
  "scoring_justification": "Recompute not applicable; result-level compare with threshold_or_better and reference_match is appropriate because the agent reports aggregate metrics and a list, not per-sample predictions.",
  "pass_threshold": 0.6,
  "target_policies": {
    "top_60_fingerprints.csv": "reference_match",
    "regression_results_gaff.json": "threshold_or_better",
    "regression_results_dft.json": "threshold_or_better",
    "transfer_prediction_results.json": "threshold_or_better"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference fingerprint list and regression metrics from paper tables.",
      "source_provenance": "Hidden references are injected at evaluation time via the GOLD_REFERENCES environment variable to prevent information leakage.",
      "generation_method": "Extracted from the paper during benchmark construction.",
      "why_not_fabricated": "The values are the actual reported results; they serve as the target for comparison against the agent's re-produced artifacts."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "top_60_fingerprints.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "rank",
            "l",
            "rc",
            "F_name",
            "importance"
          ],
          "units": {
            "rc": "Å"
          }
        },
        "description": "List of the top 60 fingerprints identified by the screening, with their importance scores."
      },
      {
        "file": "regression_results_gaff.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": [
            "atom_types",
            "total",
            "dipole_moment_R2"
          ],
          "items": {
            "atom_types": {
              "type": "object",
              "required": [
                "H",
                "C",
                "N",
                "O",
                "F"
              ],
              "items": {
                "R2": "float",
                "MAE": "float",
                "MSE": "float"
              }
            },
            "total": {
              "R2": "float",
              "MAE": "float",
              "MSE": "float"
            },
            "dipole_moment_R2": "float"
          }
        },
        "description": "Regression metrics for charge prediction and dipole moment reconstruction on GAFF-optimized geometries."
      },
      {
        "file": "regression_results_dft.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": [
            "atom_types",
            "total",
            "dipole_moment_R2"
          ],
          "items": {
            "atom_types": {
              "type": "object",
              "required": [
                "H",
                "C",
                "N",
                "O",
                "F"
              ],
              "items": {
                "R2": "float",
                "MAE": "float",
                "MSE": "float"
              }
            },
            "total": {
              "R2": "float",
              "MAE": "float",
              "MSE": "float"
            },
            "dipole_moment_R2": "float"
          }
        },
        "description": "Regression metrics for charge prediction and dipole moment reconstruction on DFT geometries (trained and evaluated on DFT)."
      },
      {
        "file": "transfer_prediction_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": [
            "atom_types",
            "total"
          ],
          "items": {
            "atom_types": {
              "type": "object",
              "required": [
                "H",
                "C",
                "N",
                "O",
                "F"
              ],
              "items": {
                "R2": "float",
                "MAE": "float",
                "MSE": "float"
              }
            },
            "total": {
              "R2": "float",
              "MAE": "float",
              "MSE": "float"
            }
          }
        },
        "description": "Regression metrics for transfer prediction: model trained on GAFF data, evaluated on DFT geometries (dipole moment not included)."
      },
      {
        "file": "gaff_generation.log",
        "format": "txt",
        "purpose": "evidence",
        "schema": {},
        "description": "Log of OpenBabel GAFF geometry optimization and charge assignment."
      },
      {
        "file": "descriptor_shape.txt",
        "format": "txt",
        "purpose": "evidence",
        "schema": {},
        "description": "Shape summary of the GAFF descriptor matrix."
      },
      {
        "file": "full_feature_importances.csv",
        "format": "csv",
        "purpose": "evidence",
        "schema": {
          "type": "table",
          "required_columns": ["feature_index", "importance"]
        },
        "description": "Full feature importance list for all 504 fingerprint components."
      },
      {
        "file": "dft_charges_count.txt",
        "format": "txt",
        "purpose": "evidence",
        "schema": {},
        "description": "Count of DFT-geometry charges assigned by OpenBabel."
      },
      {
        "file": "dft_descriptor_shape.txt",
        "format": "txt",
        "purpose": "evidence",
        "schema": {},
        "description": "Shape summary of the DFT descriptor matrix."
      }
    ],
    "notes": "All scoring is result-level compare against the paper's reported values. For R², MAE, MSE the policy is threshold_or_better (meeting or exceeding paper performance earns full credit). The top‑60 fingerprint list is scored by reference match with tolerances on importance values and exact identifier matching."
  },
  "steps": [
    {
      "id": "fingerprints",
      "output_file": "top_60_fingerprints.csv",
      "weight": 0.15,
      "reference": "hidden"
    },
    {
      "id": "gaff_metrics",
      "output_file": "regression_results_gaff.json",
      "weight": 0.25,
      "reference": "hidden"
    },
    {
      "id": "dft_metrics",
      "output_file": "regression_results_dft.json",
      "weight": 0.3,
      "reference": "hidden"
    },
    {
      "id": "transfer_metrics",
      "output_file": "transfer_prediction_results.json",
      "weight": 0.3,
      "reference": "hidden"
    }
  ]
}