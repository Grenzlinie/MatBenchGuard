{
  "scoring_tier": "recompute",
  "scoring_justification": "The checker recomputes the stable count/substrate distribution from Ef/Udiss, RMSE of ΔG(O*) against paper-reported gold from supplementary Table S4, the selective list by thresholding ΔG(O*) > 3.52 eV and comparing to the paper's list of 31 SACs, and compares overpotential against the paper's reported 0.15 V threshold (≤0.25 V). T1 is feasible because all gold values are available from the paper's supplementary tables and can be embedded inline.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold ΔG(O*) values for all 149 stable SACs from Table S4 of the paper",
      "source_provenance": "Paper supplementary Table S4; values extracted from published supporting information.",
      "generation_method": "Direct transcription from supplementary table, organized by SAC_id.",
      "why_not_fabricated": "These are the actual DFT-computed ΔG(O*) values reported by the original study; used to compute RMSE tolerance."
    },
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold set of 31 selective SAC_ids",
      "source_provenance": "Derived from Table S4 by applying ΔG(O*) > 3.52 eV, consistent with the paper's reported 31 selective catalysts.",
      "generation_method": "Extracted from the paper's selectivity screening results.",
      "why_not_fabricated": "Matches the paper's published list of selective SACs."
    },
    {
      "path": "grading_spec_json.inline",
      "purpose": "expected stable counts per substrate",
      "source_provenance": "Paper main text: 15 M@C3, 28 M@N3, 14 M@C4, 15 M@g-N4, 26 M@Pc-N4, 23 M@Py-N4, 28 M@Pr-N4.",
      "generation_method": "Directly quoted from the paper.",
      "why_not_fabricated": "These are the reported numbers of thermodynamically and electrochemically stable SACs."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "step_01_stability_screening.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "SAC_id",
            "metal",
            "substrate",
            "Ef",
            "Udiss",
            "stable"
          ],
          "units": {
            "Ef": "eV",
            "Udiss": "V"
          }
        },
        "description": "Stability metrics (formation energy, dissolution potential) and a stable flag for all 210 SACs."
      },
      {
        "file": "step_02_DeltaG_Ostar.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "SAC_id",
            "DeltaG_Ostar"
          ],
          "units": {
            "DeltaG_Ostar": "eV"
          }
        },
        "description": "O* adsorption free energies for all stable SACs."
      },
      {
        "file": "step_03_selective_SACs.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "SAC_id"
          ]
        },
        "description": "List of SAC IDs that satisfy ΔG(O*) > 3.52 eV."
      },
      {
        "file": "step_04_activity_ZnPcN4.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "table",
          "required_columns": [
            "SAC_id",
            "overpotential"
          ],
          "units": {
            "overpotential": "V"
          }
        },
        "description": "Overpotential for the Zn@Pc-N4 catalyst; must be ≤ 0.25 V."
      }
    ],
    "notes": "The checker compares the submitted Ef/Udiss values, the ΔG(O*) list, the selective SACs list, and the Zn@Pc‑N4 overpotential to paper-reported gold values with tolerances. The overpotential target follows a 'threshold_or_better' policy (lower is better)."
  },
