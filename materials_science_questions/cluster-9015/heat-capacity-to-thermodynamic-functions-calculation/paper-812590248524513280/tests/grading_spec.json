{
  "scoring_tier": "recompute",
  "scoring_justification": "Checker compares agent's phase diagram and activity data to digitized paper values; optimized parameters are checked against the paper's Table 2 to confirm the optimization produced the correct model.",
  "pass_threshold": 0.6,
  "target_policies": {
    "optimized_parameters.json": "metric_recompute",
    "alp_phase_diagram.csv": "threshold_or_better",
    "fealp_isothermal_sections.csv": "threshold_or_better",
    "p_activity_coefficient.csv": "threshold_or_better"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference values for AlP thermodynamic parameters, Al-P melting point, liquidus points, Fe-Al-P isothermal tie-line compositions, and activity coefficients of P in liquid Fe-Al.",
      "source_provenance": "Paper 'Critical Evaluation and Thermodynamic Optimization of the Al-P and Fe-Al-P Systems' Tables 2, Fig.2b, Fig.7, Fig.9.",
      "generation_method": "Digitized from the published figures and validated against the paper's optimized model parameters and experimental data.",
      "why_not_fabricated": "Values are derived directly from the source paper's reported optimized model and experimental comparisons, serving as the true reproduction target."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "optimized_parameters.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "object",
          "required": [
            "AlP",
            "liquid"
          ],
          "properties": {
            "AlP": {
              "type": "object",
              "required": [
                "Delta_H_298",
                "S_298",
                "Cp"
              ],
              "properties": {
                "Delta_H_298": {
                  "type": "number",
                  "description": "Standard enthalpy of formation at 298.15 K in J/mol"
                },
                "S_298": {
                  "type": "number",
                  "description": "Standard entropy at 298.15 K in J/(mol K)"
                },
                "Cp": {
                  "type": "object",
                  "required": [
                    "a",
                    "b",
                    "c"
                  ],
                  "properties": {
                    "a": {
                      "type": "number",
                      "description": "Coefficient a in C_P = a + b*T + c*T^{-2}, J/(mol K)"
                    },
                    "b": {
                      "type": "number",
                      "description": "Coefficient b, J/(mol K^2)"
                    },
                    "c": {
                      "type": "number",
                      "description": "Coefficient c, J*K/mol"
                    }
                  }
                }
              }
            },
            "liquid": {
              "type": "object",
              "required": [
                "delta_g_AlP"
              ],
              "properties": {
                "delta_g_AlP": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  },
                  "description": "Temperature-dependent Al-P pair parameter, [a, b] where Δg_AlP = a + b*T, a in J/mol, b in J/(mol K)"
                },
                "ternary_FeP_Al": {
                  "type": "object",
                  "description": "Optional ternary liquid parameters (Toop, Al asymmetric)",
                  "properties": {
                    "g_FeP_Al_101": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          }
                        }
                      ],
                      "description": "Parameter g_FeP(Al)^{101}, constant or [a,b]"
                    },
                    "g_FeP_Al_011": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          }
                        }
                      ],
                      "description": "Parameter g_FeP(Al)^{011}, constant or [a,b]"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Optimized Gibbs energy parameters for the Fe-Al-P system. Contains all data needed to recompute phase boundaries and thermodynamic properties."
      },
      {
        "file": "alp_phase_diagram.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "table",
          "required_columns": [
            "T_K",
            "x_P",
            "phase_flag"
          ],
          "description": "Must include the liquidus curve and a separate row indicating the melting temperature of AlP (x_P=0.5)."
        },
        "description": "Al-P phase diagram data: melting temperature of AlP and liquidus compositions."
      },
      {
        "file": "fealp_isothermal_sections.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "table",
          "required_columns": [
            "T_C",
            "region_label",
            "x_Fe",
            "x_Al",
            "x_P"
          ],
          "description": "Each row is a single phase boundary point or tie‑line end‑point, with region_label containing the phase name (e.g., BCC_A2, AlP, liquid)."
        },
        "description": "Fe-Al-P isothermal phase boundaries, each row with a phase name label for a boundary point."
      },
      {
        "file": "p_activity_coefficient.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "table",
          "required_columns": [
            "T_C",
            "wt_Al",
            "gamma_P",
            "log10_gamma_P"
          ],
          "description": "Activity coefficient of P in liquid Fe-Al-P at 1400 and 1600 °C."
        },
        "description": "Activity coefficient of phosphorus in liquid Fe-Al-P alloys."
      }
    ],
    "notes": "The checker will recompute the Al-P phase diagram and other properties from the submitted optimized_parameters.json and compare to experimental data within tolerances. All units are SI (J/mol, K, mole fraction) unless otherwise specified. The solver must adopt published Fe-P and Fe-Al binary parameters as fixed inputs."
  },
  "steps": [
    {
      "id": "step_3_optimization",
      "output_file": "optimized_parameters.json",
      "weight": 0.4,
      "kind": "parameter_match",
      "target_policy": "threshold_or_better",
      "description": "Verify that optimized_parameters.json contains AlP thermodynamic parameters and liquid interaction parameters matching the paper's optimized values within tolerances.",
      "reference_parameters": {
        "AlP_delta_H": {
          "value": -163150,
          "tolerance": 5000
        },
        "AlP_S": {
          "value": 40.34,
          "tolerance": 5
        },
        "AlP_Cp_a": {
          "value": 48.53,
          "tolerance": 2
        },
        "AlP_Cp_b": {
          "value": 0.00457,
          "tolerance": 0.001
        },
        "AlP_Cp_c": {
          "value": -690000,
          "tolerance": 100000
        },
        "liquid_dg_AlP_const": {
          "value": -21443,
          "tolerance": 5000
        },
        "liquid_dg_AlP_Tcoeff": {
          "value": 6.9036,
          "tolerance": 2
        }
      }
    },
    {
      "id": "step_4_alp_diagram",
      "output_file": "alp_phase_diagram.csv",
      "weight": 0.2,
      "kind": "vector_compare",
      "target_policy": "threshold_or_better",
      "description": "Check Al-P phase diagram: melting point at x_P=0.5 should be within 50 K of 2805.15 K; liquidus composition at given temperatures should match digitized reference points within 0.005 mole fraction.",
      "reference_data": {
        "melting_point": {
          "T_K": 2805.15,
          "tolerance": 50
        },
        "liquidus_points": [
          {
            "T_K": 1273,
            "x_P": 0.015
          },
          {
            "T_K": 1373,
            "x_P": 0.025
          },
          {
            "T_K": 1473,
            "x_P": 0.04
          }
        ],
        "liquidus_tolerance": 0.005,
        "temperature_match_tolerance": 1
      }
    },
    {
      "id": "step_5_isotherms",
      "output_file": "fealp_isothermal_sections.csv",
      "weight": 0.2,
      "kind": "vector_compare",
      "target_policy": "threshold_or_better",
      "description": "Verify isothermal sections at 450, 650, 800°C against reference tie-lines/phase boundaries from Fig.7; compositions must match within ±0.02 mole fraction (2 at.%).",
      "reference_data": [
        {
          "T_C": 450,
          "region_label": "BCC_A2",
          "x_Fe": 0.89,
          "x_Al": 0.1,
          "x_P": 0.01
        },
        {
          "T_C": 450,
          "region_label": "AlP",
          "x_Fe": 0.0,
          "x_Al": 0.5,
          "x_P": 0.5
        },
        {
          "T_C": 450,
          "region_label": "Me3P",
          "x_Fe": 0.75,
          "x_Al": 0.0,
          "x_P": 0.25
        },
        {
          "T_C": 650,
          "region_label": "BCC_A2",
          "x_Fe": 0.88,
          "x_Al": 0.1,
          "x_P": 0.02
        },
        {
          "T_C": 650,
          "region_label": "AlP",
          "x_Fe": 0.0,
          "x_Al": 0.5,
          "x_P": 0.5
        },
        {
          "T_C": 800,
          "region_label": "BCC_A2",
          "x_Fe": 0.85,
          "x_Al": 0.1,
          "x_P": 0.05
        },
        {
          "T_C": 800,
          "region_label": "Liquid",
          "x_Fe": 0.6,
          "x_Al": 0.3,
          "x_P": 0.1
        }
      ],
      "tolerance": 0.02
    },
    {
      "id": "step_6_activity",
      "output_file": "p_activity_coefficient.csv",
      "weight": 0.2,
      "kind": "vector_compare",
      "target_policy": "threshold_or_better",
      "description": "Verify activity coefficient of P at 1400 and 1600°C against Fig.9; log10(gamma_P) must be within ±0.5 of reference.",
      "reference_data": {
        "tolerance_log10": 0.5,
        "wt_Al_match_tolerance": 0.1,
        "points": [
          {
            "T_C": 1600,
            "wt_Al": 0.0,
            "log10_gamma_P": 0.0
          },
          {
            "T_C": 1600,
            "wt_Al": 1.0,
            "log10_gamma_P": 0.01
          },
          {
            "T_C": 1600,
            "wt_Al": 3.0,
            "log10_gamma_P": 0.03
          },
          {
            "T_C": 1600,
            "wt_Al": 5.0,
            "log10_gamma_P": 0.06
          },
          {
            "T_C": 1400,
            "wt_Al": 0.0,
            "log10_gamma_P": 0.0
          },
          {
            "T_C": 1400,
            "wt_Al": 1.0,
            "log10_gamma_P": 0.009
          },
          {
            "T_C": 1400,
            "wt_Al": 3.0,
            "log10_gamma_P": 0.026
          },
          {
            "T_C": 1400,
            "wt_Al": 5.0,
            "log10_gamma_P": 0.044
          }
        ]
      }
    }
  ]
}