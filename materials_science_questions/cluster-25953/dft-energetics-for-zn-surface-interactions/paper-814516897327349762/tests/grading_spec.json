        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "orientation",
              "a_ang",
              "b_ang",
              "h_ang",
              "alpha_avg_deg",
              "theta_deg",
              "E_f_eV_per_A2"
            ],
            "properties": {
              "orientation": "string",
              "a_ang": "float, Å",
              "b_ang": "float, Å",
              "h_ang": "float, Å",
              "alpha_avg_deg": "float, degrees",
              "theta_deg": "float, degrees",
              "E_f_eV_per_A2": "float, eV/Å²"
            }
          }
        },
        "description": "Relaxed structural parameters and film formation energies per surface area for six film orientations."
      },
      {
        "file": "band_gaps.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "orientation",
              "E_g_film_eV",
              "E_g_bulk_eV",
              "delta_E_g_eV"
            ],
            "properties": {
              "orientation": "string",
              "E_g_film_eV": "float, eV",
              "E_g_bulk_eV": "float, eV",
              "delta_E_g_eV": "float, eV"
            }
          }
        },
        "description": "Direct band gaps at Γ for films and their corresponding bulk polymorphs, and the difference."
      },
      {
        "file": "dielectric_constants.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "orientation",
              "epsilon_inf_xx",
              "epsilon_inf_yy",
