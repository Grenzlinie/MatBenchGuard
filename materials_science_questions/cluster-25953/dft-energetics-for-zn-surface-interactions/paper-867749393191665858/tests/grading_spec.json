{
  "scoring_tier": "result-level compare",
  "scoring_justification": "Headline quantities are produced by a full DFT workflow; checker verifies the reported numbers against paper gold with tolerances reflecting typical implementation spread.",
  "pass_threshold": 0.6,
  "target_policies": {
    "adsorption_properties.json": "exact_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "hidden gold values for each scored field",
      "source_provenance": "Paper Table I, Table II, text: binding energy 130 meV, Zn-H2 distance 2.9 A, O-site closest distance 3.4 A, rotational transitions at Zn site 10.6/14.0/21.6 meV, at O site 11.0/15.6/18.5 meV, translational frequencies Zn 7.1/15.2/17.5, O 9.5/14.5/21.7 meV/ħ, effective binding energies 100 meV (Zn) and 90 meV (O).",
      "generation_method": "Extracted directly from the paper's reported results.",
      "why_not_fabricated": "These are the actual published values; the checker compares the agent's reproduction against them, with tolerances that allow for different DFT implementations."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "adsorption_properties.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": {
            "binding_energy_Zn_meV": "number",
            "Zn_H2_distance_A": "number",
            "O_site_closest_distance_A": "number",
            "rotational_transitions_Zn_meV": "array of 3 numbers",
            "rotational_transitions_O_meV": "array of 3 numbers",
            "translational_frequencies_Zn_meVps": "array of 3 numbers",
            "translational_frequencies_O_meVps": "array of 3 numbers",
            "effective_binding_energy_Zn_meV": "number",
            "effective_binding_energy_O_meV": "number"
          },
          "items": {},
          "required_columns": [],
          "units": {
            "binding_energy_Zn_meV": "meV",
            "Zn_H2_distance_A": "Å",
            "O_site_closest_distance_A": "Å",
            "rotational_transitions_Zn_meV": "meV",
            "rotational_transitions_O_meV": "meV",
            "translational_frequencies_Zn_meVps": "meV/ħ",
            "translational_frequencies_O_meVps": "meV/ħ",
            "effective_binding_energy_Zn_meV": "meV",
            "effective_binding_energy_O_meV": "meV"
          }
        },
        "description": "Consolidated adsorption properties from vdW-DF calculations: raw binding energies, sorbate–sorbent distances, rotational para–ortho transition energies, translational fundamental frequencies, and zero-point-corrected effective binding energies at the primary Zn site and secondary O site."
      }
    ],
    "notes": "The full-cell relaxation of 24 H2 (step_06) is not scored; it provides qualitative geometry. All other quantities are compared to hidden paper-reported values within tolerances."
  },
  "steps": [
    {
      "id": "check_binding_energy_Zn",
      "output_file": "adsorption_properties.json",
      "kind": "json_field_exact",
      "field": "binding_energy_Zn_meV",
      "target": 130,
      "tolerance": 10,
      "weight": 0.15
    },
    {
      "id": "check_Zn_H2_distance",
      "output_file": "adsorption_properties.json",
      "kind": "json_field_exact",
      "field": "Zn_H2_distance_A",
      "target": 2.9,
      "tolerance": 0.1,
      "weight": 0.05
    },
    {
      "id": "check_O_closest_distance",
      "output_file": "adsorption_properties.json",
      "kind": "json_field_exact",
      "field": "O_site_closest_distance_A",
      "target": 3.4,
      "tolerance": 0.1,
      "weight": 0.05
    },
    {
      "id": "check_rot_Zn",
      "output_file": "adsorption_properties.json",
      "kind": "json_array_exact",
      "field": "rotational_transitions_Zn_meV",
      "target": [
        10.6,
        14.0,
        21.6
      ],
      "tolerance": 1.0,
      "weight": 0.15
    },
    {
      "id": "check_rot_O",
      "output_file": "adsorption_properties.json",
      "kind": "json_array_exact",
      "field": "rotational_transitions_O_meV",
      "target": [
        11.0,
        15.6,
        18.5
      ],
      "tolerance": 1.0,
      "weight": 0.15
    },
    {
      "id": "check_trans_Zn",
      "output_file": "adsorption_properties.json",
      "kind": "json_array_exact",
      "field": "translational_frequencies_Zn_meVps",
      "target": [
        7.1,
        15.2,
        17.5
      ],
      "tolerance": 1.0,
      "weight": 0.15
    },
    {
      "id": "check_trans_O",
      "output_file": "adsorption_properties.json",
      "kind": "json_array_exact",
      "field": "translational_frequencies_O_meVps",
      "target": [
        9.5,
        14.5,
        21.7
      ],
      "tolerance": 1.0,
      "weight": 0.15
    },
    {
      "id": "check_eff_binding_Zn",
      "output_file": "adsorption_properties.json",
      "kind": "json_field_exact",
      "field": "effective_binding_energy_Zn_meV",
      "target": 100,
      "tolerance": 15,
      "weight": 0.1
    },
    {
      "id": "check_eff_binding_O",
      "output_file": "adsorption_properties.json",
      "kind": "json_field_exact",
      "field": "effective_binding_energy_O_meV",
      "target": 90,
      "tolerance": 15,
      "weight": 0.05
    }
  ]
}