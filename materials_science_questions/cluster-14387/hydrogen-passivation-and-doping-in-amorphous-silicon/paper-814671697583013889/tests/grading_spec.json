  "target_policies": {
    "dos_slab.csv": "metric_recompute",
    "dos_isolated_H.csv": "metric_recompute",
    "dos_two_H.csv": "metric_recompute",
    "dos_three_H.csv": "metric_recompute",
    "summary.json": "structural_audit"
  },
  "steps": [
    {
      "id": "check_slab_dos",
      "output_file": "dos_slab.csv",
      "weight": 0.2,
      "kind": "gap_states_check",
      "params": {
        "system": "slab",
        "gap_energy_range": [
          -2,
          2
        ],
        "expected_has_gap_states": false,
        "expected_peak_energies": [],
        "peak_tolerance": 0.0,
        "max_allowed_gap_dos_fraction": 0.01
      }
    },
    {
      "id": "check_isolated_H_dos",
      "output_file": "dos_isolated_H.csv",
      "weight": 0.2,
      "kind": "gap_states_check",
