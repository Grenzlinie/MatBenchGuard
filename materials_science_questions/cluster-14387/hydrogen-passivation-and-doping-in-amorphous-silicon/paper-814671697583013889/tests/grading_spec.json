          "required_columns": [
            "energy_eV",
            "total_dos"
          ],
          "units": {
            "energy_eV": "eV",
            "total_dos": "arbitrary units"
          }
        },
        "description": "Total density of states for the supercell with one bond-centre hydrogen atom."
      },
      {
        "file": "dos_two_H.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
