{
  "scoring_tier": "recompute",
  "scoring_justification": "Beta and gamma_e can be recomputed from dos_data.csv and compared to paper gold; other thermo properties are cross-checked for consistency because the paper lacks explicit values at those conditions.",
  "pass_threshold": 0.6,
  "target_policies": {
    "dos_data.csv": "metric_recompute",
    "thermo_properties.csv": "exact_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold values for beta and gamma_e",
      "source_provenance": "Paper Tables II, III and text",
      "generation_method": "Extracted from paper",
      "why_not_fabricated": "Values are paper-reported, used for comparison"
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "dos_data.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "phase",
            "R_WS_bohr",
            "energy_eV",
            "dos_states_per_eV_per_atom"
          ],
          "units": {
            "energy_eV": "eV",
            "dos_states_per_eV_per_atom": "states/(eV·atom)"
          }
        },
        "description": "Raw electronic density of states for hcp and fcc iron at three compressions; the checker reads this to recompute thermodynamic quantities."
      },
      {
        "file": "thermo_properties.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "phase",
            "R_WS_bohr",
            "beta_mJ_K2_mol",
            "gamma_e",
            "u_e_3000K_eV_per_atom",
            "u_e_6000K_eV_per_atom",
            "f_e_3000K_eV_per_atom",
            "f_e_6000K_eV_per_atom",
            "dp_e_3000K_GPa",
            "dp_e_6000K_GPa"
          ],
          "units": {
            "beta_mJ_K2_mol": "mJ K⁻² mol⁻¹",
            "gamma_e": "dimensionless",
            "u_e_3000K_eV_per_atom": "eV/atom",
            "u_e_6000K_eV_per_atom": "eV/atom",
            "f_e_3000K_eV_per_atom": "eV/atom",
            "f_e_6000K_eV_per_atom": "eV/atom",
            "dp_e_3000K_GPa": "GPa",
            "dp_e_6000K_GPa": "GPa"
          }
        },
        "description": "Electronic thermodynamic quantities derived from the DOS; compared to hidden paper-reported values with tolerances."
      }
    ],
    "notes": "The scoring primarily relies on the recomputation from dos_data.csv. The thermo_properties.csv is cross-checked for consistency and compared against hidden gold values. The pressure calibration is optional and not scored."
  },
  "steps": [
    {
      "id": "dos_recompute",
      "output_file": "dos_data.csv",
      "kind": "recompute_thermo",
      "weight": 0.8,
      "targets": {
        "beta": {
          "gold": {
            "hcp": {
              "2.3": 2.95,
              "2.4": 3.5,
              "2.5": 4.09
            },
            "fcc": {
              "2.3": 2.77,
              "2.4": 3.31,
              "2.5": 3.89
            }
          },
          "tol_rel": 0.3
        },
        "gamma_e": {
          "gold": {
            "hcp": 1.34,
            "fcc": 1.27
          },
          "tol_abs": 0.3
        }
      },
      "structural_checks": {
        "methods_ok": true
      }
    },
    {
      "id": "thermo_consistency",
      "output_file": "thermo_properties.csv",
      "kind": "cross_check",
      "weight": 0.2,
      "tolerance_rel": 0.4
    }
  ]
}