{
  "version": 1,
  "resources": [
    {
      "id": "tool_qe",
      "name": "Quantum ESPRESSO",
      "type": "tool",
      "required": true,
      "access": {
        "method": "url",
        "url": "https://www.quantum-espresso.org"
      },
      "notes": "Open-source plane-wave DFT code."
    },
    {
      "id": "pkg_phonopy",
      "name": "PHONOPY",
      "type": "package",
      "required": true,
      "access": {
        "method": "package",
        "package": "phonopy"
      },
      "notes": "Open-source package for phonon calculations."
    },
    {
      "id": "ps_lib",
      "name": "PBE pseudopotentials for La and C",
      "type": "file",
      "required": true,
      "access": {
        "method": "url",
        "url": "https://dalcorso.github.io/pslibrary/"
      },
      "notes": "Obtain La and C PBE pseudopotentials from the PSLibrary."
    },
    {
      "id": "laC2_structure",
      "name": "LaC2 crystal structure",
      "type": "other",
      "required": true,
      "access": {
        "method": "other",
        "notes": "Construct from space group I4/mmm: La at 2a (0,0,0), C at 4e (0,0,0.4026), lattice constants a=3.9789 Å, c=6.5824 Å."
      },
      "notes": "The experimental crystal structure used in the paper."
    }
  ]
}