          "required_columns": [
            "mode",
            "pressure_GPa",
            "gamma_T"
          ]
        },
        "description": "Mode Grüneisen parameter γ_T as a function of pressure for each Raman mode. The checker will compare values at a set of hidden pressure checkpoints."
      },
