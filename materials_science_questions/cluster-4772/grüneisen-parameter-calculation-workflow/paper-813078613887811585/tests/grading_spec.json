    {
      "path": "grading_spec_json.inline",
      "purpose": "reference gamma and frequency values at checkpoints for trend and tolerance scoring",
      "source_provenance": "paper Tables 1–3 and Eqs. (1)-(5), computed with γ = - (dv/dP · V)/(dV/dP · v) to match the physically correct softening trend",
      "generation_method": "analytically computed from the published coefficients using Python; values embedded inline",
      "why_not_fabricated": "derived directly from the paper’s own tables and equations; consistent with the reference solve.sh which uses these same coefficients"
    }
  ],
