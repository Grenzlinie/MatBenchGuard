{
  "scoring_tier": "recompute",
  "scoring_justification": "Bulk thermal conductivity is recomputed from the agent's raw size‑dependent k data (1/k vs 1/L fit), qualifying as T1. TBR and vacancy reduction are compared to paper values (result‑level) because the required raw temperature profiles are not part of the output contract.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper‑reported bulk thermal conductivities, thermal boundary resistances, and vacancy reduction percentages used as comparison targets.",
      "source_provenance": "Paper text: bulk k (0.73, 0.33, 0.95 W/m‑K) from Fig. 2(b) and text; TBR (7.00e‑9, 6.15e‑9, 3.20e‑9 m²·K/W) from Fig. 6(b) and text; vacancy reduction (44%, 33%, 35%) from Fig. 8 and text.",
      "generation_method": "Exact values as reported in the paper; used as reference for tolerance‑based scoring.",
      "why_not_fabricated": "All numbers are directly quoted from the peer‑reviewed publication and are the central claims we verify."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "size_dependent_k.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "direction",
            "length_nm",
            "k_W_per_mK"
          ],
          "optional_columns": [
            "k_std_W_per_mK"
          ],
          "units": {
            "direction": "string (a*, b*, c*)",
            "length_nm": "nanometre",
            "k_W_per_mK": "W/m·K",
            "k_std_W_per_mK": "W/m·K"
          }
        },
        "description": "Raw thermal conductivity vs. crystal length data for each direction from NEMD simulations."
      },
      {
        "file": "bulk_k.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": {
            "a*": "number (W/m·K)",
            "b*": "number (W/m·K)",
            "c*": "number (W/m·K)"
          },
          "items": "",
          "required_columns": [],
          "units": {
            "a*": "W/m·K",
            "b*": "W/m·K",
            "c*": "W/m·K"
          }
        },
        "description": "Extrapolated bulk thermal conductivities for the three crystallographic directions."
      },
      {
        "file": "tbr_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": {
            "a*-b*": "object",
            "a*-c*": "object",
            "b*-c*": "object"
          },
          "items": {
            "lengths": "list of numbers (nm)",
            "TBR_per_length": "list of numbers (m^2·K/W)",
            "mean_TBR": "number (m^2·K/W)",
            "std_TBR": "number (m^2·K/W)"
          },
          "required_columns": [],
          "units": {
            "mean_TBR": "m^2·K/W",
            "std_TBR": "m^2·K/W",
            "lengths": "nm",
            "TBR_per_length": "m^2·K/W"
          }
        },
        "description": "Thermal boundary resistance for the three representative interfaces, including per-length data and averaged values."
      },
      {
        "file": "vacancy_effect.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": {
            "a*": "object",
            "b*": "object",
            "c*": "object"
          },
          "items": {
            "perfect_k": "number (W/m·K)",
            "vacancy_k_6pct": "number (W/m·K)",
            "reduction_percent": "number (percent)"
          },
          "required_columns": [],
          "units": {
            "perfect_k": "W/m·K",
            "vacancy_k_6pct": "W/m·K",
            "reduction_percent": "percent"
          }
        },
        "description": "Thermal conductivity reduction due to 6% molecular vacancies for each direction."
      }
    ],
    "notes": "The checker will recompute bulk thermal conductivity from size_dependent_k.csv where appropriate. Tolerances accommodate stochastic NEMD variation; exact values are compared to hidden reference quantities."
  },
  "steps": [
    {
      "id": "size_k_sanity",
      "output_file": "size_dependent_k.csv",
      "kind": "structural_audit",
      "weight": 0.05,
      "description": "Verify that the CSV has the required columns, at least three length entries per direction, and that thermal conductivity increases monotonically with length for each direction.",
      "target_policy": "structural_audit"
    },
    {
      "id": "bulk_k_recompute",
      "output_file": "bulk_k.json",
      "kind": "recompute",
      "weight": 0.4,
      "metric": "bulk_thermal_conductivity",
      "directions": [
        "a*",
        "b*",
        "c*"
      ],
      "target": {
        "a*": 0.73,
        "b*": 0.33,
        "c*": 0.95
      },
      "tolerance_rel": 0.2,
      "recompute_from": "size_dependent_k.csv",
      "recompute_method": "linear_fit_inv_k_vs_inv_L",
      "target_policy": "threshold_or_better"
    },
    {
      "id": "tbr_check",
      "output_file": "tbr_results.json",
      "kind": "numeric_compare",
      "weight": 0.35,
      "fields": [
        "a*-b*",
        "a*-c*",
        "b*-c*"
      ],
      "target": {
        "a*-b*": 7e-09,
        "a*-c*": 6.15e-09,
        "b*-c*": 3.2e-09
      },
      "tolerance_abs": 5e-10,
      "target_policy": "exact_match"
    },
    {
      "id": "vacancy_check",
      "output_file": "vacancy_effect.json",
      "kind": "numeric_compare",
      "weight": 0.2,
      "fields": [
        "a*",
        "b*",
        "c*"
      ],
      "subfield": "reduction_percent",
      "target": {
        "a*": 44.0,
        "b*": 33.0,
        "c*": 35.0
      },
      "tolerance_abs": 8.0,
      "target_policy": "exact_match"
    }
  ]
}