{
  "version": 1,
  "resources": [
    {
      "id": "quantum_espresso",
      "name": "Quantum ESPRESSO",
      "type": "package",
      "access": {
        "method": "url",
        "url": "https://www.quantum-espresso.org",
        "notes": "Open-source DFT code; used for ground-state and DFPT calculations"
      }
    },
    {
      "id": "wannier90",
      "name": "Wannier90",
      "type": "tool",
      "access": {
        "method": "url",
        "url": "https://wannier.org",
        "notes": "Used for Wannier interpolation of e-ph matrix elements"
      }
    },
    {
      "id": "pseudodojo_pseudopotentials",
      "name": "PseudoDojo norm-conserving pseudopotentials (Sr, Ti, O)",
      "type": "dataset",
      "access": {
        "method": "url",
        "url": "http://www.pseudo-dojo.org",
        "notes": "PBE pseudopotentials with spin-orbit coupling; required for DFT calculations"
      }
    },
    {
      "id": "tdep",
      "name": "Temperature Dependent Effective Potential (TDEP)",
      "type": "tool",
      "access": {
        "method": "url",
        "url": "https://github.com/tdep-developers/tdep",
        "notes": "Used to obtain anharmonic phonon dispersions including soft modes"
      }
    }
  ]
}