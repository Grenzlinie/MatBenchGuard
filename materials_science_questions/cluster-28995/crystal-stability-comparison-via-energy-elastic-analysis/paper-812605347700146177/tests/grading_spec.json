{
  "scoring_tier": "structural",
  "scoring_justification": "The paper does not provide numerical reference values for force constants or moduli; the verifiable claim is the sign pattern and physical plausibility of the computed quantities. A recompute against a hidden gold is infeasible without an authoritative reference implementation, which is not available.",
  "pass_threshold": 0.6,
  "hidden_assets": [],
  "output_contract": {
    "outputs": [
      {
        "file": "force_constants.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "0.48",
            "0.42",
            "0.36",
            "0.33"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "J",
              "R"
            ],
            "properties": {
              "J": {
                "type": "number",
                "description": "Tangential force constant (Ha)"
              },
              "R": {
                "type": "number",
                "description": "Radial force constant (Ha)"
              }
            }
          }
        },
        "description": "Computed force constants at the FCC close-packed distance for four Rc/Rs ratios."
      },
      {
        "file": "elastic_moduli_groupIII.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "0.48",
            "0.42",
            "0.36",
            "0.33"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "C_FCC",
              "C_prime_FCC"
            ],
            "properties": {
              "C_FCC": {
                "type": "number",
                "description": "Rhombohedral shear modulus (Ha)"
              },
              "C_prime_FCC": {
                "type": "number",
                "description": "Tetragonal shear modulus (Ha)"
              }
            }
          }
        },
        "description": "FCC elastic shear moduli derived from force constants."
      }
    ],
    "notes": "Values are in atomic units (Hartree). The checker will verify self-consistency between the two artifacts, compare absolute values against a hidden reference, and check the sign pattern of the moduli as described by the structural stability argument."
  },
  "steps": [
    {
      "id": "check_force_shape",
      "output_file": "force_constants.json",
      "kind": "json_field",
      "weight": 0.03,
      "description": "All required keys and fields present"
    },
    {
      "id": "check_moduli_shape",
      "output_file": "elastic_moduli_groupIII.json",
      "kind": "json_field",
      "weight": 0.03,
      "description": "All required keys and fields present"
    },
    {
      "id": "check_moduli_self_consistency",
      "output_file": "elastic_moduli_groupIII.json",
      "kind": "self_consistency",
      "weight": 0.2,
      "description": "Recomputed moduli from submitted force constants must match submitted moduli within tight tolerance",
      "tolerance": 1e-05
    },
    {
      "id": "check_moduli_sign",
      "output_file": "elastic_moduli_groupIII.json",
      "kind": "sign_pattern",
      "weight": 0.5,
      "description": "Sign sequence of C_FCC and C_prime_FCC must reproduce the physical pattern",
      "expected_signs": {
        "0.48": {
          "C_FCC": "positive",
          "C_prime_FCC": "positive"
        },
        "0.42": {
          "C_FCC": "negative"
        },
        "0.36": {
          "C_FCC": "positive",
          "C_prime_FCC": "negative"
        },
        "0.33": {
          "C_FCC": "positive",
          "C_prime_FCC": "positive"
        }
      }
    },
    {
      "id": "check_moduli_magnitude_plausible",
      "output_file": "elastic_moduli_groupIII.json",
      "kind": "range_check",
      "weight": 0.09,
      "range": [
        1e-08,
        0.1
      ],
      "description": "All moduli values must lie within physically plausible range [1e-8, 1e-1] Ha"
    },
    {
      "id": "check_force_plausible",
      "output_file": "force_constants.json",
      "kind": "range_check",
      "weight": 0.09,
      "range": [
        -0.1,
        0.1
      ],
      "description": "Force constants must lie within plausible magnitude [-0.1, 0.1] Ha"
    },
    {
      "id": "check_no_degenerate",
      "output_file": "elastic_moduli_groupIII.json",
      "kind": "degeneracy",
      "weight": 0.06,
      "description": "Moduli must not be identical across all ratios (0 if all equal)"
    }
  ]
}