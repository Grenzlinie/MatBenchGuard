{
  "scoring_tier": "recompute",
  "scoring_justification": "Total EPC lambda can be recomputed from α²F(ω) by numerical integration; Tc and gap are scored directionally (threshold_or_better) against paper values.",
  "pass_threshold": 0.8,
  "target_policies": {
    "step_02_epc_properties.json": "threshold_or_better",
    "step_03_eliasberg_spectral_function.json": "metric_recompute"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold values for λ, ω_log, Tc, gap.",
      "source_provenance": "Paper text and figures: λ=1.47, Tc~21 K (McMillan), Tc~21.7 K (Eliashberg), gap~5 meV; ω_log=188 meV from reference solve.sh which reproduces the paper's calculation.",
      "generation_method": "Extracted from paper and verified against reference solve.sh output.",
      "why_not_fabricated": "Values are directly from the paper and consistent with the oracle answer."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "step_01_phonon_stability.txt",
        "format": "txt",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "text",
          "description": "Contains exactly the string 'No imaginary frequencies found.'"
        },
        "description": "Confirms that the phonon calculation produced no imaginary modes, affirming dynamical stability."
      },
      {
        "file": "step_02_epc_properties.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "object",
          "required": [
            "total_EPC_lambda",
            "logavg_phonon_freq_omega_log",
            "Tc_McMillan",
            "Tc_Eliashberg",
            "gap_6K"
          ],
          "units": {
            "total_EPC_lambda": "dimensionless",
            "logavg_phonon_freq_omega_log": "meV",
            "Tc_McMillan": "K",
            "Tc_Eliashberg": "K",
            "gap_6K": "meV"
          }
        },
        "description": "Aggregated superconducting properties derived from the full EPC pipeline. Checker compares to hidden paper-reported benchmarks."
      },
      {
        "file": "step_03_eliasberg_spectral_function.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "array",
          "items": {
            "frequency": "float, meV",
            "a2F": "float, arbitrary units",
            "cumulative_lambda": "float, dimensionless"
          }
        },
        "description": "Eliashberg spectral function α²F(ω) and cumulative λ(ω). The checker recomputes the total EPC constant λ from this data."
      }
    ],
    "notes": "All scored artifacts are produced from previous process steps. The checker recomputes λ from the spectral function and compares the aggregated properties to hidden gold; tolerance accommodates reasonable method-dependent spread."
  },
  "steps": [
    {
      "id": "stability_check",
      "output_file": "step_01_phonon_stability.txt",
      "kind": "exact_string",
      "weight": 0.05,
      "target": "No imaginary frequencies found.",
      "tolerance": 0.0
    },
    {
      "id": "epc_properties",
      "output_file": "step_02_epc_properties.json",
      "kind": "json_field",
      "weight": 0.55,
      "fields": [
        {
          "key": "total_EPC_lambda",
          "target": 1.47,
          "tolerance_abs": 0.05,
          "direction": "exact_match",
          "sub_weight": 0.2
        },
        {
          "key": "logavg_phonon_freq_omega_log",
          "target": 188.0,
          "tolerance_abs": 5.0,
          "direction": "exact_match",
          "sub_weight": 0.1
        },
        {
          "key": "Tc_McMillan",
          "target": 21.0,
          "tolerance_abs": 2.0,
          "direction": "threshold_or_better_lower",
          "sub_weight": 0.25
        },
        {
          "key": "Tc_Eliashberg",
          "target": 21.7,
          "tolerance_abs": 2.0,
          "direction": "threshold_or_better_lower",
          "sub_weight": 0.25
        },
        {
          "key": "gap_6K",
          "target": 5.0,
          "tolerance_abs": 0.5,
          "direction": "threshold_or_better_higher",
          "sub_weight": 0.2
        }
      ]
    },
    {
      "id": "spectral_recompute",
      "output_file": "step_03_eliasberg_spectral_function.json",
      "kind": "recompute_lambda",
      "weight": 0.4,
      "target_lambda": 1.47,
      "tolerance_abs": 0.05
    }
  ]
}