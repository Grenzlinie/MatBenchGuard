{
  "scoring_tier": "structural",
  "scoring_justification": "Full recompute of DFT/DFPT/Wannier self-energy is computationally heavy and requires specific codes not feasible for verifier sandbox; structural features (double-plateau, band-splittings, long-lived pole) are directly verifiable from agent artifacts.",
  "pass_threshold": 0.6,
  "output_contract": {
    "outputs": [
