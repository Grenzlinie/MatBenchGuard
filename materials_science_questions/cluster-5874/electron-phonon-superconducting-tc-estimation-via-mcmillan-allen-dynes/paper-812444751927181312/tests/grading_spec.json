        "chi_eq_abs": 0.1,
        "internal_consistency": 1e-06
      },
      "description": "Verify that every reported χ_eq_low is internally consistent with the element IP/EA (recomputes low-temperature formula), that χ_eq_general is internally consistent (recomputes general formula), and that χ_eq_low matches the paper's Table 2 within tolerance."
    },
    {
      "id": "check_weighted_averages",
      "output_file": "weighted_averages.json",
      "kind": "numeric",
      "weight": 0.4,
      "target": null,
      "tolerances": {
        "metals_avg_abs": 0.05,
        "alloys_low_avg_abs": 0.05,
        "alloys_general_avg_abs": 0.1
      },
      "description": "Recompute the three Tc-weighted averages from the element and alloy CSVs, verify internal consistency with the reported averages, and compare to the paper's reported weighted averages (3.79, 3.98, 4.43 eV) within tolerances."
    }
