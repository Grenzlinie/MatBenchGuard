      "output_file": "results.json",
      "kind": "json_field",
      "path": [
        "flat_sheet",
        "entire_film_ratio"
      ],
      "target": 1.02,
      "tolerance_abs": 0.1,
      "weight": 0.15
    },
    {
      "id": "hollow_sphere_ratio",
      "output_file": "results.json",
      "kind": "json_field",
