              "pressure_derivative": "float, dimensionless",
              "cohesive_energy_eV_per_atom": "float, unit: eV/atom",
              "C11_GPa": "float, unit: GPa",
              "C12_GPa": "float, unit: GPa",
              "C44_GPa": "float, unit: GPa",
              "Zener_anisotropy_A": "float, dimensionless",
              "Poisson_ratio_nu": "float, dimensionless",
              "Young_modulus_E_GPa": "float, unit: GPa",
              "shear_modulus_G_GPa": "float, unit: GPa"
            },
            "HoP": {
              "lattice_constant_A": "float, unit: Angstrom",
              "bulk_modulus_GPa": "float, unit: GPa",
              "pressure_derivative": "float, dimensionless",
              "cohesive_energy_eV_per_atom": "float, unit: eV/atom",
              "C11_GPa": "float, unit: GPa",
              "C12_GPa": "float, unit: GPa",
              "C44_GPa": "float, unit: GPa",
              "Zener_anisotropy_A": "float, dimensionless",
              "Poisson_ratio_nu": "float, dimensionless",
              "Young_modulus_E_GPa": "float, unit: GPa",
              "shear_modulus_G_GPa": "float, unit: GPa"
            }
          }
        },
        "description": "Structural parameters, cohesive energy, elastic constants, and derived polycrystalline moduli. The checker will compare lattice constants, bulk moduli, pressure derivatives, cohesive energies, and elastic constants to the paper's reported values, and will recompute Zener anisotropy, Poisson's ratio, Young's modulus, and shear modulus from the submitted Cij to verify internal consistency and agreement with reference values."
      },
      {
        "file": "step_02_phonon_stability.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": [
            "HoAs",
            "HoP"
          ],
          "properties": {
            "HoAs": {
              "lowest_phonon_frequency_cm-1": "float, unit: cm^-1",
              "has_imaginary_modes": "bool"
            },
            "HoP": {
              "lowest_phonon_frequency_cm-1": "float, unit: cm^-1",
              "has_imaginary_modes": "bool"
            }
          }
        },
        "description": "Phonon stability assessment. The checker requires that for each compound the lowest phonon frequency is not significantly negative (>= -1 cm^-1 tolerance) and that has_imaginary_modes is false, confirming dynamical stability of the B1 phase."
      },
      {
        "file": "step_03_thermodynamics.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "table",
          "required_columns": [
            "compound",
            "temperature_K",
            "pressure_GPa",
            "volume_A3",
            "bulk_modulus_GPa",
            "Cv_J_molK",
            "Cp_J_molK",
            "entropy_J_molK",
            "thermal_expansion_coefficient_K-1",
            "Debye_temperature_K",
            "Gruneisen_parameter"
          ],
          "units": {
            "temperature_K": "K",
            "pressure_GPa": "GPa",
            "volume_A3": "Angstrom^3",
            "bulk_modulus_GPa": "GPa",
            "Cv_J_molK": "J mol^-1 K^-1",
            "Cp_J_molK": "J mol^-1 K^-1",
            "entropy_J_molK": "J mol^-1 K^-1",
            "thermal_expansion_coefficient_K-1": "K^-1",
            "Debye_temperature_K": "K",
            "Gruneisen_parameter": "dimensionless"
          }
        },
        "description": "Quasi-harmonic thermodynamic properties as a function of temperature and pressure. The checker will verify structural trends: Cv approaching ~49.9 J mol^-1 K^-1 at high temperature, Debye temperature decreasing with increasing temperature, and thermal expansion coefficient increasing with temperature at low pressure. Selected reference values will be compared to the paper's reported numbers."
      }
    ],
    "notes": "The electronic band structures and density of states are omitted from the reproduction scope. All DFT calculations use open-source Quantum ESPRESSO with GGA-PBE PAW pseudopotentials as an equivalent substitute for the paper's VASP runs. The verifier recomputes derived elastic moduli, checks phonon stability thresholds, and audits thermodynamic trends and reference points."
  },
