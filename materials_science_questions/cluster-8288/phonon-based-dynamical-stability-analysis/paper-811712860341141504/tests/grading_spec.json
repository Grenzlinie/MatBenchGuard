      "why_not_fabricated": "These are the actual paper-reported quantities used to verify the agent's reproduction."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "step_01_structural_elastic.json",
        "format": "json",
        "purpose": "scored",
