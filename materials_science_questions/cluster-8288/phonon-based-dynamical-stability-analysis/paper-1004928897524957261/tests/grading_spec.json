      "generation_method": "extracted directly from the paper's reported numerical results",
      "why_not_fabricated": "These are the paper's own published numbers; they serve as the hidden gold for result-level comparison. The reference oracle writes these exact values, confirming consistency."
    }
  ],
  "output_contract": {
