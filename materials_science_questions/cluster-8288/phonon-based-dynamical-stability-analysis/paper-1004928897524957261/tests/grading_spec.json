  "pass_threshold": 0.6,
  "target_policies": {
    "pristine_results.json": "exact_match",
    "functionalized_results.json": "threshold_or_better"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference values for pristine results and functionalized band gap / stability flags from the paper (Table 1, Fig. 3, text).",
