              },
              "B_VRH": {
                "type": "number",
                "unit": "GPa"
              },
              "G_VRH": {
                "type": "number",
                "unit": "GPa"
              },
              "Y_VRH": {
                "type": "number",
                "unit": "GPa"
              },
              "Poisson_VRH": {
                "type": "number",
                "unit": "dimensionless"
              }
            },
            "required": [
              "compound",
              "B_VRH",
              "G_VRH",
              "Y_VRH",
              "Poisson_VRH"
            ]
          }
        },
        "description": "Voigt–Reuss–Hill polycrystalline averages of bulk, shear, Young's moduli and Poisson's ratio for each compound."
      },
      {
        "file": "step_04_transition_pressures.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
