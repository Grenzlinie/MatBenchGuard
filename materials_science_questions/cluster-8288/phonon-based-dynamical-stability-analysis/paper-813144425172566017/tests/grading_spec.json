              },
              "beta_min": {
                "type": "number",
                "unit": "TPa⁻¹"
              },
              "beta_max": {
                "type": "number",
                "unit": "TPa⁻¹"
              }
            },
            "required": [
              "compound",
              "Y_min",
              "Y_max",
              "beta_min",
              "beta_max"
            ]
          }
        },
        "description": "Directional elastic anisotropy extremes: minimum and maximum Young's modulus and linear compressibility for the chalcopyrite phase of each compound."
      }
    ],
    "notes": ""
