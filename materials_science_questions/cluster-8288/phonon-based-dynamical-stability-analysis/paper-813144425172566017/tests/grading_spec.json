{
  "scoring_tier": "recompute",
  "scoring_justification": "Polycrystalline moduli and anisotropy extremes are recomputed from the submitted elastic constants; elastic constants themselves and transition pressures are compared to paper-reported values extracted from the published article. Phonon stability is a simple threshold. This mix provides verifiability without relying on hidden test sets.",
  "pass_threshold": 0.6,
  "target_policies": {
    "step_01_elastic_constants.json": "reference_match",
    "step_02_phonon_stability.json": "structural_audit",
    "step_03_polycrystalline_moduli.json": "metric_recompute",
    "step_04_transition_pressures.json": "reference_match",
    "step_05_anisotropy_summary.json": "metric_recompute"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper-reported elastic constants and transition pressures",
      "source_provenance": "Paper Table 2 and Table 3 (Elastic constants and Transition pressures for MSiP2 compounds)",
      "generation_method": "Numbers transcribed from the accepted manuscript (DOI:10.1016/j.jallcom.2014.04.172) with the exact values as reported.",
      "why_not_fabricated": "Values are taken directly from the published article and are necessary to compare against agent reproduction within tolerance."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "step_01_elastic_constants.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "compound": {
                "type": "string"
              },
              "C11": {
                "type": "number",
                "unit": "GPa"
              },
              "C12": {
                "type": "number",
                "unit": "GPa"
              },
              "C13": {
                "type": "number",
                "unit": "GPa"
              },
              "C33": {
                "type": "number",
                "unit": "GPa"
              },
              "C44": {
                "type": "number",
                "unit": "GPa"
              },
              "C66": {
                "type": "number",
                "unit": "GPa"
              }
            },
            "required": [
              "compound",
              "C11",
              "C12",
              "C13",
              "C33",
              "C44",
              "C66"
            ]
          }
        },
        "description": "Single-crystal elastic stiffness constants (Voigt notation) for the chalcopyrite phase of each compound."
      },
      {
        "file": "step_02_phonon_stability.json",
