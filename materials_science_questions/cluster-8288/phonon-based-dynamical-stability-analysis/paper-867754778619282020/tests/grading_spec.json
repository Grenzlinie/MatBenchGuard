          "properties": {
            "cumulene_tensile_stiffness": {
              "type": "number",
              "unit": "eV/Å"
            },
            "polyyne_tensile_stiffness": {
              "type": "number",
              "unit": "eV/Å"
            }
          }
        },
        "description": "Tensile stiffness values for cumulene and polyyne."
      },
      {
        "file": "phonon_frequencies.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "object",
