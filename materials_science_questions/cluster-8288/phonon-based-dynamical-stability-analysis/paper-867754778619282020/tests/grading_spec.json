              "type": "object",
              "required": [
                "total_energy_cell",
                "binding_energy_per_atom"
              ],
              "properties": {
                "total_energy_cell": {
                  "type": "number",
                  "unit": "eV"
                },
                "binding_energy_per_atom": {
                  "type": "number",
                  "unit": "eV/atom"
                }
              }
            },
            "polyyne": {
              "type": "object",
              "required": [
                "total_energy_cell",
                "binding_energy_per_atom"
