  "steps": [
    {
      "id": "step_total_energies",
      "output_file": "total_energies.json",
      "kind": "rubric",
      "weight": 0.5,
      "target": {
        "binding_energy_difference_min_meV": 0.5
      },
      "tolerance": {}
    },
    {
      "id": "step_tensile_stiffness",
      "output_file": "tensile_stiffness.json",
      "kind": "rubric",
      "weight": 0.2,
      "target": {
        "cumulene_stiffness_eV_per_A": 94.669,
        "polyyne_stiffness_eV_per_A": 94.939,
        "tolerance_relative": 0.15
      }
    },
    {
      "id": "step_phonon",
      "output_file": "phonon_frequencies.json",
      "kind": "rubric",
      "weight": 0.3,
      "target": {
        "min_frequency_negative_threshold_THz": -0.001,
        "expect_imaginary": true
      }
    }
  ]
