{
  "pass_threshold": 0.6,
  "scoring_tier": "recompute",
  "scoring_justification": "Bilayer CSV: recompute linear fit R², slope, intercept, crossover field, and Δ_intra trends from raw rows. Monolayer JSON: compare reported values to paper references with tolerance (reference_match fallback). No trust on agent's self-reported metrics.",
  "target_policies": {
    "monolayer_spin_splitting.json": "reference_match",
    "bilayer_ez_splitting.csv": "metric_recompute"
  },
  "hidden_assets": [],
  "output_contract": {
    "outputs": [
      {
        "file": "monolayer_spin_splitting.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "delta_soc_mev": "float, unit: meV",
            "band_gap_indirect_ev": "float, unit: eV"
          }
        },
        "description": "Monolayer spin splitting at K and indirect bandgap."
      },
      {
        "file": "bilayer_ez_splitting.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "Ez",
            "Delta_intra",
            "Delta_inter"
          ],
          "units": {
            "Ez": "eV/Angstrom",
            "Delta_intra": "meV",
            "Delta_inter": "meV"
          }
        },
        "description": "Electric-field-dependent intra- and inter-layer spin splitting components."
      }
    ],
    "notes": "The checker will recompute the linear trend of Δ_inter vs E_z and verify the slope and intercept, and check that Δ_intra is nearly constant. It will also compute the crossover field from the fitted line and verify it lies within a narrow range."
  },
  "steps": [
    {
      "id": "monolayer_delta_soc",
      "output_file": "monolayer_spin_splitting.json",
      "kind": "numeric_field",
      "weight": 0.2,
      "field": "delta_soc_mev",
      "reference": 129,
      "tolerance": 15,
      "description": "Monolayer spin splitting at K (meV)"
    },
    {
      "id": "monolayer_bandgap",
      "output_file": "monolayer_spin_splitting.json",
      "kind": "numeric_field",
      "weight": 0.1,
      "field": "band_gap_indirect_ev",
      "reference": 1.775,
      "tolerance": 0.1,
      "description": "Monolayer indirect bandgap (eV)"
    },
    {
      "id": "bilayer_linear_fit",
      "output_file": "bilayer_ez_splitting.csv",
      "kind": "recompute_linear_fit",
      "weight": 0.3,
      "r2_threshold": 0.9,
      "slope_min": 0.0,
      "intercept_abs_max": 20,
      "description": "Linear fit of Delta_inter vs Ez: R², positive slope, small intercept"
    },
    {
      "id": "bilayer_crossover",
      "output_file": "bilayer_ez_splitting.csv",
      "kind": "recompute_crossover",
      "weight": 0.15,
      "crossover_target": 0.012,
      "crossover_tolerance": 0.003,
      "description": "Crossover field where Delta_inter equals Delta_intra (eV/Å)"
    },
    {
      "id": "bilayer_intra_slope",
      "output_file": "bilayer_ez_splitting.csv",
      "kind": "recompute_delta_intra_slope",
      "weight": 0.1,
      "slope_abs_max": 5.0,
      "description": "Delta_intra should have near-zero slope (meV/(eV/Å))"
    },
    {
      "id": "bilayer_intra_mean",
      "output_file": "bilayer_ez_splitting.csv",
      "kind": "numeric_field_from_table",
      "weight": 0.15,
      "column": "Delta_intra",
      "reference": 129,
      "tolerance": 15,
      "description": "Mean Delta_intra should be close to monolayer splitting (meV)"
    }
  ]
}