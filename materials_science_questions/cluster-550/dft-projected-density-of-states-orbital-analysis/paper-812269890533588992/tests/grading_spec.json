{
  "scoring_tier": "result-level compare",
  "scoring_justification": "Cannot recompute DFT from raw artifacts; compare reported lattice parameters, energy trends, and metallicity flags to paper's published values.",
  "pass_threshold": 0.7,
  "target_policies": {
    "computed_properties.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold lattice parameters, expected metallicity, energy ordering constraints for LiAlSi and Li2AlSi.",
      "source_provenance": "Paper Tables 3 and 4, and text descriptions.",
      "generation_method": "Direct transcription from paper.",
      "why_not_fabricated": "These are the exact paper values, traceable, used only for hidden grading."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "computed_properties.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "compound",
            "arrangement",
            "space_group",
            "optimized_a",
            "total_energy_ev",
            "band_gap_ev",
            "is_metallic"
          ],
          "units": {
            "optimized_a": "Angstrom",
            "total_energy_ev": "eV",
            "band_gap_ev": "eV"
          }
        },
        "description": "Reproduction of DFT-computed properties for Li-Al-Si compounds. The checker compares values against hidden paper-reported references with tolerances."
      }
    ],
    "notes": "The checker uses reference_match policy: compares extracted values (lattice parameters within tolerance, relative energy ordering, metallicity flags) to the paper's reported values. The agent must produce the table; no hidden holdout is required."
  },
  "steps": [
    {
      "id": "csv_shape_gate",
      "output_file": "computed_properties.csv",
      "kind": "rubric",
      "weight": 0.05,
      "params": {
        "required_columns": [
          "compound",
          "arrangement",
          "space_group",
          "optimized_a",
          "total_energy_ev",
          "band_gap_ev",
          "is_metallic"
        ],
        "expected_compounds": [
          "LiAlSi",
          "Li2AlSi",
          "Li7Al3Si4",
          "Li5AlSi2",
          "Li9AlSi3"
        ]
      }
    },
    {
      "id": "lattice_accuracy",
      "output_file": "computed_properties.csv",
      "kind": "numeric",
      "weight": 0.3,
      "params": {
        "tolerance_relative": 0.02,
        "expected": [
          {
            "compound": "LiAlSi",
            "arrangement": "I",
            "optimized_a": 5.9433
          },
          {
            "compound": "LiAlSi",
            "arrangement": "II",
