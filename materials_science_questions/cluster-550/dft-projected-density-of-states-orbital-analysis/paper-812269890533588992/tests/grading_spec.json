          },
          {
            "compound": "Li9AlSi3",
            "arrangement": "ordered",
            "optimized_a": 12.357
          }
        ]
      }
    },
    {
      "id": "lialsi_energy_ordering",
      "output_file": "computed_properties.csv",
      "kind": "ordering",
      "weight": 0.2,
      "params": {
        "compound": "LiAlSi",
        "arrangement_order": [
          "I",
          "II",
          "III"
