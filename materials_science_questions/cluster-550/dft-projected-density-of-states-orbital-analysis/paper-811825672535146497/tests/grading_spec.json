{
  "scoring_tier": "T0",
  "scoring_justification": "Result-level comparison: the headline DFT quantities cannot be recomputed from raw artifacts in the verifier sandbox; we compare the agent's reported numbers to the paper's published reference values with domain‑appropriate tolerances.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden reference values and tolerances for each scored output",
      "source_provenance": "Paper's reported numeric values (text).",
      "generation_method": "Extracted from the paper: total magnetic moment ~2 μB, Ni spin moment ~1.5 μB, band gap ~0.8 eV, FM‑AFM energy difference ~5 meV/f.u., Ni orbital moment ~0.16 μB.",
      "why_not_fabricated": "Values are traced directly to the paper's explicit statements."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "ferromagnetic_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "total_magnetic_moment_per_fu": "number (μB)",
            "Ni_spin_moment": "number (μB)",
            "band_gap_down_spin": "number (eV)",
            "total_energy": "number (eV)"
          }
        },
        "description": "Scored artifact from the ferromagnetic DFT run. Values are compared to the paper's reference within domain-appropriate tolerances."
      },
      {
        "file": "antiferromagnetic_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "energy_difference_FM_minus_AFM": "number (meV/f.u.)"
          }
        },
        "description": "Energy difference between ferromagnetic and antiferromagnetic configurations. Compared to the paper's reference."
      },
      {
        "file": "soc_results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "Ni_orbital_moment": "number (μB)"
          }
        },
        "description": "Ni orbital magnetic moment from SOC calculation. Compared to the paper's reference."
      }
    ],
    "notes": "All outputs are compared to the paper's published numeric results using reference_match policy. Tolerances are hidden. The non-magnetic step evidence is not scored; the task is graded on honest execution of the full workflow."
  },
  "steps": [
    {
      "id": "ferromagnetic",
      "output_file": "ferromagnetic_results.json",
      "weight": 0.4,
      "kind": "numeric",
      "fields": {
        "total_magnetic_moment_per_fu": {
          "target": 2.0,
          "tolerance": 0.1,
          "unit": "μB",
          "required": true
        },
        "Ni_spin_moment": {
          "target": 1.5,
          "tolerance": 0.1,
          "unit": "μB",
          "required": true
        },
        "band_gap_down_spin": {
          "target": 0.8,
          "tolerance": 0.1,
          "unit": "eV",
          "required": true
        },
        "total_energy": {
          "target": null,
          "tolerance": null,
          "check": "exists_and_numeric",
          "required": true,
          "weight": 0.0
        }
      }
    },
    {
      "id": "antiferromagnetic",
      "output_file": "antiferromagnetic_results.json",
      "weight": 0.3,
      "kind": "numeric",
      "fields": {
        "energy_difference_FM_minus_AFM": {
          "target": 5.0,
          "tolerance": 1.0,
          "unit": "meV/f.u.",
          "required": true
        },
        "Ni_spin_moment_AFM": {
          "target": 1.5,
          "tolerance": 0.1,
          "unit": "μB",
          "required": false
        }
      }
    },
    {
      "id": "soc",
      "output_file": "soc_results.json",
      "weight": 0.3,
      "kind": "numeric",
      "fields": {
        "Ni_orbital_moment": {
          "target": 0.16,
          "tolerance": 0.02,
          "unit": "μB",
          "required": true
        }
      }
    }
  ]
}