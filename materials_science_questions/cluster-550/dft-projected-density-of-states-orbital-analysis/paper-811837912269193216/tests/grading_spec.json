{
  "scoring_tier": "recompute",
  "scoring_justification": "Each numeric field is compared against the paper-reported value with an absolute tolerance; a genuine re-run should fall within these tolerances.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "paper-reported gold values for seven quantities",
      "source_provenance": "Table 1 and text of the paper",
      "generation_method": "exact values from paper",
      "why_not_fabricated": "values are directly quoted from the source paper and used as reference targets with generous tolerances"
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "outputs.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": {
            "lattice_constant_a_nm": "float",
            "bulk_modulus_B_GPa": "float",
            "B_prime": "float",
            "C11_GPa": "float",
            "C12_GPa": "float",
            "C44_GPa": "float",
            "total_DOS_at_Fermi_level_N_EF_states_per_eV": "float"
          },
          "units": {
            "lattice_constant_a_nm": "nm",
            "bulk_modulus_B_GPa": "GPa",
            "B_prime": "dimensionless",
            "C11_GPa": "GPa",
            "C12_GPa": "GPa",
            "C44_GPa": "GPa",
            "total_DOS_at_Fermi_level_N_EF_states_per_eV": "states/eV"
          }
        },
        "description": "Seven key physical quantities reproduced from the DFT calculations: lattice constant a, bulk modulus B, its pressure derivative B', elastic constants C11, C12, C44, and total DOS at the Fermi level N(E_F)."
      }
    ],
    "notes": "All values must be computed from the DFT workflow; no external lookup. The hidden checker compares each field to the paper-reported values within absolute tolerances typical for pseudopotential/implementation spread."
  },
  "steps": [
    {
      "id": "check_lattice_constant",
      "output_file": "outputs.json",
      "kind": "numeric",
      "weight": 0.142857,
      "field": "lattice_constant_a_nm",
      "target": 0.3471,
      "tolerance_abs": 0.002,
      "units": "nm",
      "description": "Equilibrium lattice constant in nm"
    },
    {
      "id": "check_bulk_modulus",
      "output_file": "outputs.json",
      "kind": "numeric",
      "weight": 0.142857,
      "field": "bulk_modulus_B_GPa",
      "target": 70.0,
      "tolerance_abs": 2.0,
      "units": "GPa",
      "description": "Bulk modulus B in GPa"
    },
    {
      "id": "check_B_prime",
      "output_file": "outputs.json",
      "kind": "numeric",
      "weight": 0.142857,
      "field": "B_prime",
      "target": 5.61,
      "tolerance_abs": 1.0,
      "units": "dimensionless",
      "description": "First pressure derivative of bulk modulus"
    },
    {
      "id": "check_C11",
      "output_file": "outputs.json",
      "kind": "numeric",
      "weight": 0.142857,
      "field": "C11_GPa",
      "target": 114.4,
      "tolerance_abs": 3.0,
      "units": "GPa",
      "description": "Elastic constant C11"
    },
    {
      "id": "check_C12",
      "output_file": "outputs.json",
      "kind": "numeric",
      "weight": 0.142857,
      "field": "C12_GPa",
      "target": 47.8,
      "tolerance_abs": 3.0,
      "units": "GPa",
      "description": "Elastic constant C12"
    },
    {
      "id": "check_C44",
      "output_file": "outputs.json",
      "kind": "numeric",
      "weight": 0.142857,
      "field": "C44_GPa",
      "target": 34.3,
      "tolerance_abs": 3.0,
      "units": "GPa",
      "description": "Elastic constant C44"
    },
    {
      "id": "check_N_EF",
      "output_file": "outputs.json",
      "kind": "numeric",
      "weight": 0.142857,
      "field": "total_DOS_at_Fermi_level_N_EF_states_per_eV",
      "target": 1.32,
      "tolerance_abs": 0.1,
      "units": "states/eV",
      "description": "Total DOS at Fermi level"
    }
  ]
}