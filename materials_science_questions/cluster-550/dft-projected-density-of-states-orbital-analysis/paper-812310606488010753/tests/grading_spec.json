{
  "scoring_tier": "result-level compare",
  "scoring_justification": "Headline quantities are the computed structural/electronic/thermal properties; the agent submits only these final values, not the underlying raw E(V) or DOS curves, so direct recompute from raw artifacts is infeasible. Scoring compares against paper-reported hidden gold with tolerances and trend checks.",
  "pass_threshold": 0.6,
  "target_policies": {
    "step_01_structural_results.json": "reference_match",
    "step_02_electronic_results.json": "reference_match",
    "step_03_thermal_results.json": "reference_match"
  },
