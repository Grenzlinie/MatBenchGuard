{
  "version": 1,
  "resources": [
    {
      "id": "gromacs",
      "name": "GROMACS (Molecular Dynamics Package)",
      "type": "package",
      "required": true,
      "access": {
        "method": "url",
        "url": "https://www.gromacs.org/",
        "notes": "Open-source MD engine; version >=5.1"
      }
    },
    {
      "id": "lj-argon-params",
      "name": "Lennard-Jones parameters for argon",
      "type": "dataset",
      "required": true,
      "access": {
        "method": "description",
        "notes": "Standard parameters: σ = 0.3409 nm, ε/k_B = 120.04 K, cutoff 9σ (as given in the paper)"
      }
    }
  ]
}