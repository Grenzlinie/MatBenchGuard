{
  "scoring_tier": "result_level_compare",
  "scoring_justification": "The scored artifact is a JSON of computed physical properties; the hidden checker compares each reported value to the paper's reference using tolerances, as recomputing these properties from the raw DFT output would require a full DFT analysis in the verifier sandbox, which is infeasible.",
  "pass_threshold": 0.7,
  "target_policies": {
    "computed_properties.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper-reported values for Eu 4f peak positions, exchange splittings, magnetic moments, and exchange constants.",
      "source_provenance": "Paper 'Electronic structure and magnetism of Eu-doped GaN: first-principles study based on LDA+U' (J. Phys. D: Appl. Phys. 41 035004), Fig. 2 (peaks), text (splittings), Table 1 (magnetic moments), text (exchange constants).",
      "generation_method": "Extracted directly from the paper and embedded as inline numeric targets in grading_spec.json.",
      "why_not_fabricated": "All quantities are explicitly reported in the paper; they are the same values the reference solve.sh writes and the checker compares against."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "computed_properties.json",
