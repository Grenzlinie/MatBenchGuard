{
  "scoring_tier": "result-level compare",
  "scoring_justification": "DFT calculations are too heavy to recompute in the checker sandbox; the checker compares the agent's reported values to paper-listed gold numbers with tolerances.",
  "pass_threshold": 0.6,
  "target_policies": {
    "relaxed_params.json": "reference_match",
    "partial_charges.json": "reference_match",
    "efg_params.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold values for structural parameters, partial charges, and EFG parameters for pure Hf2Co",
      "source_provenance": "Paper Tables 2, 3, and 5 (Hf2Co pure DFT results, WIEN97)",
      "generation_method": "Copied directly from the published tables",
      "why_not_fabricated": "These are the exact paper-reported numbers for the same quantities the agent is asked to compute"
    }
  ],
  "output_contract": {
