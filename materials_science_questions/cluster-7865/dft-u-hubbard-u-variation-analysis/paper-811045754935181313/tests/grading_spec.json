{
  "scoring_tier": "recompute",
  "scoring_justification": "Percentage reductions recomputed from reported optical gaps; electronic/magnetic properties compared to paper gold with tolerances.",
  "pass_threshold": 0.6,
  "target_policies": {
    "electronic_properties.json": "reference_match",
    "magnetic_moments.json": "reference_match",
    "optical_band_gaps.json": "metric_recompute"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Hidden gold values for electronic, magnetic, and optical properties from the paper.",
      "source_provenance": "Paper Tables 1,2,3 and derived reductions",
      "generation_method": "Extracted from paper and recomputed percentages; verified against reference solve.sh.",
      "why_not_fabricated": "Values are the exact paper-reported numbers; reductions are mathematically derived from them."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "electronic_properties.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": {
            "U": "integer (0 or 6)",
            "E_g_up": "float (eV)",
            "E_g_down": "float (eV)",
            "delta_E_c": "float (meV)",
            "delta_E_v": "float (meV)",
            "N_alpha": "float (eV)",
            "N_beta": "float (eV)"
          }
        },
        "description": "Spin‑resolved electronic band gaps, spin splittings, and s‑d/p‑d exchange parameters for U=0 and U=6 eV."
      },
      {
        "file": "magnetic_moments.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "object",
          "required": {
            "U": "integer (0 or 6)",
            "Total": "float (μB)",
            "Mg": "float (μB)",
            "Mn": "float (μB)",
            "O": "float (μB)",
            "Interstitial": "float (μB)"
          }
        },
        "description": "Total and site‑projected magnetic moments from LSDA and LSDA+U calculations."
      },
      {
        "file": "optical_band_gaps.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "threshold_or_better",
        "schema": {
          "type": "array",
          "items": {
            "U": "integer (0 or 6)",
            "ligand_field": "string (\"weak\" or \"strong\")",
            "E_g_up": "float (eV)",
            "E_g_down": "float (eV)"
          },
          "final_object": {
            "reduction_up_U0": "float (%)",
            "reduction_down_U0": "float (%)",
            "reduction_up_U6": "float (%)",
            "reduction_down_U6": "float (%)"
          }
        },
        "description": "Spin‑resolved optical band gaps from Tauc extrapolation and percentage reduction of the gap in the strong‑field case relative to weak‑field."
      }
    ],
    "notes": "All values must be in the specified units. The reductions are computed from the reported optical gaps. The verifier also checks internal consistency (optical gap ≥ electronic gap)."
  },
  "steps": [
    {
      "id": "check_electronic",
      "output_file": "electronic_properties.json",
      "weight": 0.25,
      "kind": "check",
      "description": "Compare reported electronic properties (band gaps, spin splittings, exchange parameters) to paper gold with tolerances.",
      "gold": {
        "0": {
          "E_g_up": 5.006,
          "E_g_down": 5.011,
          "delta_E_c": 6.64,
          "delta_E_v": 1.37,
          "N_alpha": 0.212,
          "N_beta": 0.043
        },
        "6": {
          "E_g_up": 4.997,
          "E_g_down": 5.0,
          "delta_E_c": 4.58,
          "delta_E_v": 2.22,
          "N_alpha": 0.146,
          "N_beta": 0.071
        }
      },
      "tolerances": {
        "E_g_up": 0.1,
        "E_g_down": 0.1,
        "delta_E_c": 1.0,
        "delta_E_v": 1.0,
        "N_alpha": 0.02,
        "N_beta": 0.02
      }
    },
    {
      "id": "check_magnetic",
      "output_file": "magnetic_moments.json",
      "weight": 0.25,
      "kind": "check",
      "description": "Compare reported magnetic moments (total and site-projected) to paper gold with tolerances.",
      "gold": {
        "0": {
          "Mg": 0.0,
          "Mn": 0.897,
          "O": 0.003,
          "Interstitial": 0.077,
          "Total": 1.0
        },
        "6": {
          "Mg": 0.0,
          "Mn": 0.951,
          "O": 0.005,
          "Interstitial": 0.013,
          "Total": 1.003
        }
      },
      "tolerances": {
        "Mg": 0.01,
        "Mn": 0.05,
        "O": 0.01,
        "Interstitial": 0.02,
        "Total": 0.05
      }
    },
    {
      "id": "check_optical",
      "output_file": "optical_band_gaps.json",
      "weight": 0.5,
      "kind": "check",
      "description": "Compare optical band gaps to paper gold with tolerances, recompute percentage reductions, and check optical >= electronic gaps.",
      "gold": {
        "cases": [
          {
            "U": 0,
            "ligand_field": "weak",
            "E_g_up": 5.219,
            "E_g_down": 5.243
          },
          {
            "U": 0,
            "ligand_field": "strong",
            "E_g_up": 4.892,
            "E_g_down": 5.01
          },
          {
            "U": 6,
            "ligand_field": "weak",
            "E_g_up": 5.255,
            "E_g_down": 5.292
          },
          {
            "U": 6,
            "ligand_field": "strong",
            "E_g_up": 5.088,
            "E_g_down": 4.99
          }
        ],
        "reductions": {
          "reduction_up_U0": 6.265,
          "reduction_down_U0": 4.444,
          "reduction_up_U6": 3.178,
          "reduction_down_U6": 5.707
        }
      },
      "tolerances": {
        "E_g_up": 0.2,
        "E_g_down": 0.2,
        "reduction": 2.0
      },
      "electronic_properties_file": "electronic_properties.json"
    }
  ]
}