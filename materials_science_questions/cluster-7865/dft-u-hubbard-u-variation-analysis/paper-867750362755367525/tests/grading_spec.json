{
  "scoring_tier": "recompute",
  "scoring_justification": "Phase diagram and ΔE_inter are recomputed directly from phase_energies.json (T1). Exchange/Tc and LC-MAE are scored via consistency and structural trend checks (T2/T3) because re-executing DFT and Monte Carlo inside the verifier is infeasible.",
  "pass_threshold": 0.6,
  "output_contract": {
    "outputs": [
      {
        "file": "phase_energies.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "strain": {
                "type": "number",
                "description": "Biaxial strain value (dimensionless, e.g. -0.05 for -5%)"
              },
              "E_upup_downdown": {
                "type": "number",
                "unit": "meV per unit cell"
              },
              "E_upup_upup": {
                "type": "number",
                "unit": "meV per unit cell"
              },
              "E_updown_updown": {
                "type": "number",
                "unit": "meV per unit cell"
              }
            },
            "required": [
              "strain",
              "E_upup_downdown",
              "E_upup_upup",
              "E_updown_updown"
            ]
          }
        },
        "description": "Total energies of the three collinear magnetic configurations of C2/m bilayer CrI3 as a function of biaxial strain, referenced to the interlayer-AF configuration at 0% strain."
      },
      {
        "file": "exchange_tc.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "strain": {
                "type": "number"
              },
              "J_intra": {
                "type": "number",
                "unit": "meV"
              },
              "J_inter_first": {
                "type": "number",
                "unit": "meV"
              },
              "J_inter_second": {
                "type": "number",
                "unit": "meV"
              },
              "Tc": {
                "type": "number",
                "unit": "K"
              }
            },
            "required": [
              "strain",
              "J_intra",
              "J_inter_first",
              "J_inter_second",
              "Tc"
            ]
          }
        },
        "description": "Exchange coupling parameters (intralayer and first/second interlayer) and Curie temperature for each strain."
      },
      {
        "file": "lc_mae.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "strain": {
                "type": "number"
              },
              "angle_deg": {
                "type": "number",
                "unit": "degrees"
              },
              "energy_meV": {
                "type": "number",
                "unit": "meV per unit cell"
              }
            },
            "required": [
              "strain",
              "angle_deg",
              "energy_meV"
            ]
          }
        },
        "description": "Layer-constrained magnetic anisotropy energy: total energy as a function of the angle between layer magnetizations for selected strains."
      }
    ],
    "notes": "The checker recomputes key quantities (phase boundaries, ∆E_inter) from the raw total energies, validates exchange-coupling signs and approximate Tc values, and performs structural cross-consistency checks on the LC-MAE data."
  },
  "hidden_assets": [],
  "steps": [
    {
      "id": "phase_energies",
      "output_file": "phase_energies.json",
      "kind": "recompute_metric",
      "weight": 0.6,
      "description": "Recompute ground-state ordering and ΔE_inter",
      "target_policy": "metric_recompute",
      "delta_E_target": 0.5,
      "delta_E_tolerance_abs": 0.1,
      "trans1_range": [
        -0.03,
        -0.005
      ],
      "trans2_range": [
        -0.065,
        -0.04
      ]
    },
    {
      "id": "exchange_tc",
      "output_file": "exchange_tc.json",
      "kind": "consistency",
      "weight": 0.3,
      "description": "Check J sign changes and Tc trends",
      "target_policy": "structural_audit",
      "Tc_at_0_target": 44.0,
      "Tc_at_0_tol_ratio": 0.2,
      "Tc_at_m3_target": 14.0,
      "Tc_at_m3_tol_ratio": 0.2,
      "J_intra_neg_strain_max": -0.04,
      "J_intra_pos_strain_min": -0.02,
      "J_inter_first_cross_range": [
        -0.015,
        -0.005
      ]
    },
    {
      "id": "lc_mae",
      "output_file": "lc_mae.json",
      "kind": "structural_audit",
      "weight": 0.1,
      "description": "Check consistency with phase energies and angular shape",
      "target_policy": "structural_audit",
      "delta_tol_meV": 0.1
    }
  ]
}