{
  "scoring_tier": "structural",
  "scoring_justification": "The DFT+U calculations cannot be rerun in the verifier, so absolute numeric agreement is not required. The checker verifies the correct pattern of insulating states (gap presence) and relative energy ground-state ordering for the band gap summary, and the signs of exchange constants for the spin exchange.",
  "pass_threshold": 0.6,
  "target_policies": {
    "band_gap_summary.csv": "structural_audit",
    "spin_exchange_constants.csv": "structural_audit"
  },
