{
  "scoring_tier": "recompute",
  "scoring_justification": "Recompute zero-crossing pressures and curve monotonicity from raw CSV data; compare against paper-reported reference ranges. T1 because raw data is submitted and checker can recompute interpolated pressures without trusting agent's self-reported values.",
  "pass_threshold": 0.6,
  "target_policies": {
    "eos_parameters.json": "reference_match",
    "volume_difference_vs_pressure.csv": "reference_match",
    "dG_vs_pressure_static.csv": "reference_match",
    "dG_vs_pressure_entropy.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference ranges for alloying pressures and volume expansion zero-pressure value.",
      "source_provenance": "Paper Table 1 (V0=10.41 Å³, K0=267 GPa, K0′=4.5 for Fe0.99K0.01) and Fig. 1b (static ΔG zero crossing at ~35 GPa, entropy-corrected ~21 GPa, zero-pressure volume expansion ~0.9%).",
      "generation_method": "Extracted directly from the paper text and figures.",
      "why_not_fabricated": "These are the exact paper-reported values; used as reasonable tolerances for a reproduction by an independent DFT implementation."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "eos_parameters.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "pure_Fe",
            "pure_K_fcc",
            "Fe_K_alloy"
          ],
          "properties": {
            "pure_Fe": {
              "V0": "number (Angstrom^3)",
              "K0": "number (GPa)",
              "K0_prime": "number"
            },
            "pure_K_fcc": {
              "V0": "number (Angstrom^3)",
              "K0": "number (GPa)",
              "K0_prime": "number"
            },
            "Fe_K_alloy": {
              "V0": "number (Angstrom^3)",
              "K0": "number (GPa)",
              "K0_prime": "number"
            }
          },
          "units": {
            "V0": "Angstrom^3",
            "K0": "GPa",
            "K0_prime": "dimensionless"
          }
        },
        "description": "Fitted third‑order Birch‑Murnaghan equation of state parameters for pure Fe, pure K (fcc), and the Fe0.99K0.01 substitutional alloy."
      },
      {
        "file": "volume_difference_vs_pressure.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "pressure_GPa",
            "volume_difference_percent"
          ],
          "units": {
            "pressure_GPa": "GPa",
            "volume_difference_percent": "%"
          }
        },
        "description": "Percent volume expansion of the alloy relative to pure ε‑Fe as a function of pressure."
      },
      {
        "file": "dG_vs_pressure_static.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "pressure_GPa",
            "Delta_G_eV_per_atom"
          ],
          "units": {
            "pressure_GPa": "GPa",
            "Delta_G_eV_per_atom": "eV per atom"
          }
        },
        "description": "Static (0 K) Gibbs free energy difference per atom for the alloying reaction."
      },
      {
        "file": "dG_vs_pressure_entropy.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "pressure_GPa",
            "Delta_G_eV_per_atom"
          ],
          "units": {
            "pressure_GPa": "GPa",
            "Delta_G_eV_per_atom": "eV per atom"
          }
        },
        "description": "Entropy‑corrected Gibbs free energy difference per atom at T=2000 K."
      }
    ],
    "notes": "The pure‑K reference phase is K II (fcc). The entropy correction uses ideal mixing entropy at 2000 K. The volume expansion and Gibbs curves must cover at least 0–50 GPa."
  },
  "steps": [
    {
      "id": "check_eos",
      "output_file": "eos_parameters.json",
      "kind": "json_field",
      "description": "Check EOS parameters for Fe_K_alloy against paper reference.",
      "weight": 0.2,
      "checks": {
        "V0": {
          "reference": 10.41,
          "tolerance_abs": 0.5
        },
        "K0": {
          "reference": 267,
          "tolerance_pct": 10
        },
        "K0_prime": {
          "reference": 4.5,
          "tolerance_pct": 10
        },
        "ordering": true
      }
    },
    {
      "id": "check_volume_diff",
      "output_file": "volume_difference_vs_pressure.csv",
      "kind": "numeric",
      "description": "Check volume difference curve: positive, decreasing, zero-pressure value ~0.9%.",
      "weight": 0.1,
      "checks": {
        "zero_pressure_value": {
          "reference": 0.9,
          "tolerance_abs": 0.3
        },
        "decreasing_trend": {
          "tolerance": 0.01
        }
      }
    },
    {
      "id": "check_dg_static",
      "output_file": "dG_vs_pressure_static.csv",
      "kind": "numeric",
      "description": "Check static ΔG curve: monotonically decreasing, zero-crossing pressure in 30-40 GPa.",
      "weight": 0.5,
      "checks": {
        "monotonic_decreasing": {
          "tolerance": 1e-06
        },
        "zero_crossing_pressure": {
          "reference_range": [
            30,
            40
          ]
        }
      }
    },
    {
      "id": "check_dg_entropy",
      "output_file": "dG_vs_pressure_entropy.csv",
      "kind": "numeric",
      "description": "Check entropy-corrected ΔG: zero-crossing pressure in 16-26 GPa.",
      "weight": 0.2,
      "checks": {
        "zero_crossing_pressure": {
          "reference_range": [
            16,
            26
          ]
        }
      }
    }
  ]
}