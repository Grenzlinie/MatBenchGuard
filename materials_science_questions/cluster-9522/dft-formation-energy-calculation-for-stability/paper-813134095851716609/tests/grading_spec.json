{
  "scoring_tier": "structural",
  "scoring_justification": "Absolute formation energies depend on DFT code/pseudopotentials; verify relative ordering and qualitative gap thresholds per paper. Migration barriers likewise structural.",
  "pass_threshold": 0.6,
  "hidden_assets": [],
  "output_contract": {
    "outputs": [
      {
        "file": "dumbbell_formation_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "table",
          "required_columns": [
            "system",
            "dumbbell_type",
            "composition",
            "formation_energy"
          ],
          "units": {
            "formation_energy": "eV per dumbbell"
          }
        },
        "description": "Formation energies of interstitial dumbbells in Ni, NiCo, and NiFe. Scoring verifies the relative ordering and energy gaps match paper-reported trends."
      },
      {
        "file": "migration_barriers.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "table",
          "required_columns": [
            "system",
            "process_description",
            "barrier_eV"
          ],
          "units": {
            "barrier_eV": "eV"
          }
        },
        "description": "Migration energy barriers for selected 1D and 3D interstitial diffusion paths. Scoring verifies that 1D barriers in Ni are very low, 1D in NiCo is higher, and 1D in NiFe is essentially suppressed, while 3D barriers show a consistent trend."
      }
    ],
    "notes": "The agent must use Quantum ESPRESSO with GGA-PBE pseudopotentials. Ordered L1₂ supercells (Ni₃Co, Ni₃Fe) are used as models for NiCo and NiFe alloys. The scoring tolerates differences due to code and pseudopotential choices but requires the correct relative ordering and approximate energy gaps."
  },
  "steps": [
    {
      "id": "formation",
      "output_file": "dumbbell_formation_energies.csv",
      "weight": 0.6,
      "kind": "structural",
      "constraints": [
        {
          "type": "ordering",
          "system": "NiFe",
          "dumbbell_type": "<100>",
          "expected_order": [
            "Ni-Ni",
            "Ni-Fe",
            "Fe-Ni",
            "Fe-Fe"
          ]
        },
        {
          "type": "ordering",
          "system": "NiFe",
          "dumbbell_type": "<110>",
          "expected_order": [
            "Ni-Ni",
            "Ni-Fe",
            "Fe-Fe"
          ]
        },
        {
          "type": "ordering",
          "system": "NiFe",
          "dumbbell_type": "<111>",
          "expected_order": [
            "Fe-Ni",
            "Fe-Fe"
          ]
        },
        {
          "type": "ordering",
          "system": "NiCo",
          "dumbbell_type": "<100>",
          "expected_order": [
            "Ni-Co",
            "Co-Co",
            "Co-Ni",
            "Ni-Ni"
          ]
        },
        {
          "type": "ordering",
          "system": "NiCo",
          "dumbbell_type": "<110>",
          "expected_order": [
            "Ni-Co",
            "Co-Co",
            "Ni-Ni"
          ]
        },
        {
          "type": "ordering",
          "system": "NiCo",
          "dumbbell_type": "<111>",
          "expected_order": [
            "Co-Co",
            "Co-Ni"
          ]
        },
        {
          "type": "gap",
          "system": "NiFe",
          "dumbbell_type": "<100>",
          "comp1": "Ni-Ni",
          "comp2": "Ni-Fe",
          "target_diff": 0.3,
          "tolerance": 0.15
        },
        {
          "type": "gap",
          "system": "NiCo",
          "dumbbell_type": "<100>",
          "comp1": "Ni-Co",
          "comp2": "Co-Co",
          "abs_less_than": 0.1
        },
        {
          "type": "minimum_type_is_100",
          "system": "Ni"
        },
        {
          "type": "minimum_type_is_100",
          "system": "NiCo"
        },
        {
          "type": "minimum_type_is_100",
          "system": "NiFe"
        }
      ]
    },
    {
      "id": "migration",
      "output_file": "migration_barriers.csv",
      "weight": 0.4,
      "kind": "structural",
      "constraints": [
        {
          "type": "barrier_threshold",
          "system": "Ni",
          "desc_contains": "1D",
          "operator": "<",
          "threshold": 0.05,
          "absent_allowed": false
        },
        {
          "type": "barrier_threshold",
          "system": "NiCo",
          "desc_contains": "1D",
          "operator": ">",
          "threshold": 0.05,
          "absent_allowed": false
        },
        {
          "type": "barrier_threshold",
          "system": "NiFe",
          "desc_contains": "1D",
          "operator": ">",
          "threshold": 0.2,
          "absent_allowed": true
        },
        {
          "type": "any_3d_exists",
          "system": "Ni"
        },
        {
          "type": "any_3d_exists",
          "system": "NiCo"
        },
        {
          "type": "any_3d_exists",
          "system": "NiFe"
        },
        {
          "type": "all_positive"
        }
      ]
    }
  ]
}