          "value": -2.7288
        },
        {
          "carbide": "Fe2C",
          "value": 0.0187
        },
        {
          "carbide": "Fe5C2",
          "value": -0.3585
        },
        {
          "carbide": "NbC",
          "value": -4.3182
        }
      ],
      "field": "formation_energy_eV_per_atom",
      "key_column": "carbide"
    },
    {
      "id": "check_formation_ordering",
