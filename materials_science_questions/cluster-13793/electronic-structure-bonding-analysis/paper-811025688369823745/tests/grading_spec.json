{
  "scoring_tier": "consistency",
  "scoring_justification": "Recomputing binding energies from raw total energies is infeasible because the contract only requests derived binding energies; we use reference_match with tolerances from the paper and an internal consistency check (mechanical+chemical = binding_energy).",
  "pass_threshold": 0.6,
  "target_policies": {
    "binding_energies.csv": "reference_match",
    "strengthening_energies.csv": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "paper-reported binding energies and strengthening energies (Tables V and VI)",
      "source_provenance": "Physical Review B 60, 7149 (1999) Tables V and VI",
      "generation_method": "transcribed directly from paper",
      "why_not_fabricated": "these are the exact paper values, used as reference for scoring"
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "binding_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "impurity",
            "surface",
            "binding_energy",
            "mechanical",
            "chemical"
          ],
          "units": {
            "binding_energy": "eV",
            "mechanical": "eV",
            "chemical": "eV"
          }
        },
        "description": "Binding energies (ΔE_s and ΔE_b) and their mechanical/chemical contributions for H, B, P on Ni(210) free surface and Ni Σ5(210) grain boundary."
      },
      {
        "file": "strengthening_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "impurity",
            "delta_EB"
          ],
          "units": {
            "delta_EB": "eV"
          }
        },
        "description": "Strengthening energy ΔE_B = ΔE_b - ΔE_s for H, B, P. Positive values indicate cohesion enhancer; negative values indicate embrittler."
      }
    ],
    "notes": ""
  },
  "checks": [
    {
      "id": "binding_energies_check",
      "output_file": "binding_energies.csv",
      "weight": 0.4,
      "kind": "reference_match",
      "description": "Compare binding energies and mechanical/chemical contributions to paper Table V within tolerance and check mechanical+chemical = binding_energy consistency.",
      "tolerances": {
        "binding_energy": 0.1,
        "mechanical": 0.15,
        "chemical": 0.15
      },
      "consistency_eps": 0.01,
      "gold": [
        {
          "impurity": "H",
          "surface": "FS",
          "binding_energy": 3.26,
          "mechanical": -0.14,
          "chemical": 3.4
        },
        {
          "impurity": "B",
          "surface": "FS",
          "binding_energy": 6.34,
          "mechanical": -0.27,
          "chemical": 6.61
        },
        {
          "impurity": "P",
          "surface": "FS",
          "binding_energy": 6.36,
          "mechanical": -0.3,
          "chemical": 6.66
        },
        {
          "impurity": "H",
          "surface": "GB",
          "binding_energy": 2.99,
          "mechanical": -0.01,
          "chemical": 3.0
        },
        {
          "impurity": "B",
          "surface": "GB",
          "binding_energy": 6.83,
          "mechanical": -0.16,
          "chemical": 6.99
        },
        {
          "impurity": "P",
          "surface": "GB",
          "binding_energy": 5.66,
          "mechanical": -0.65,
          "chemical": 6.31
        }
      ]
    },
    {
      "id": "strengthening_energies_check",
      "output_file": "strengthening_energies.csv",
      "weight": 0.6,
      "kind": "reference_match",
      "description": "Compare strengthening energies to paper Table VI within tolerance and verify sign classification (B=positive, H/P=negative).",
      "tolerance": 0.05,
      "gold": [
        {
          "impurity": "H",
          "delta_EB": -0.27,
          "expected_sign": -1
        },
        {
          "impurity": "B",
          "delta_EB": 0.49,
          "expected_sign": 1
        },
        {
          "impurity": "P",
          "delta_EB": -0.7,
          "expected_sign": -1
        }
      ]
    }
  ]
}