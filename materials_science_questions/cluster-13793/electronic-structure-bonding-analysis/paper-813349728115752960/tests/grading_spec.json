          "columns": {
            "atom": "string, e.g., O_a, O_b, Al, Y",
            "s": "float",
            "p": "float",
            "d": "float",
            "total": "float",
            "mulliken_charge": "float"
          }
        },
        "description": "Mulliken atomic charges for symmetry-inequivalent atoms in YAlO3."
