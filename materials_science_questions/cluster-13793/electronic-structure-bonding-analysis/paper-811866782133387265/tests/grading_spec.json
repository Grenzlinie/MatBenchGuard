{
  "scoring_tier": "recompute",
  "scoring_justification": "Stabilization energy recomputed from agent's equilibrium energies and hidden H2 energy; other quantities compared to paper reference with tolerances.",
  "pass_threshold": 0.5,
  "target_policies": {
    "geometry_optimization_results.csv": "reference_match",
    "eos_fit_results.csv": "reference_match_and_recompute"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Paper reference values (lattice constants, volumes, energies, bulk moduli) and H₂ molecule energy for stabilization recomputation.",
      "source_provenance": "Table 1 and Section 3.2 of the paper (H₂ energy -6.651 eV from VASP PAW-GGA calculation).",
      "generation_method": "Directly extracted from the paper's reported values.",
      "why_not_fabricated": "These are the published experimental/theoretical results that the reproduction targets."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "geometry_optimization_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "system",
            "a_lattice",
            "b_over_a",
            "c_over_a",
            "volume_per_4fu",
            "total_energy_per_4fu"
          ],
          "units": {
            "a_lattice": "Å",
            "volume_per_4fu": "Å³",
            "total_energy_per_4fu": "eV"
          },
          "row_count": 4
        },
        "description": "Relaxed lattice constants, volume, and total energy per 4 fu for ZrNi, ZrNiH, ZrNiH₂, ZrNiH₃ compared to reference values within tolerances."
      },
      {
        "file": "eos_fit_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "system",
            "equilibrium_energy_per_4fu",
            "equilibrium_volume_per_4fu",
            "bulk_modulus",
            "stabilization_energy_per_H2"
