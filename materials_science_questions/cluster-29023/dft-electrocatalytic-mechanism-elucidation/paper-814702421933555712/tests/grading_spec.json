      "weight": 0.25,
      "tolerance": 15.0,
      "targets": [
        {
          "site": "Mn(1)",
          "adsorption_energy_kJ_mol": -88.5
        },
        {
          "site": "Mn(2)",
          "adsorption_energy_kJ_mol": -53.5
        },
        {
          "site": "Nb(1)",
          "adsorption_energy_kJ_mol": -110.1
        },
        {
          "site": "Nb(2)",
          "adsorption_energy_kJ_mol": -131.4
