      "checks": [
        {
          "description": "In Nb(2)-K-OMS-2, f_minus(Nb) > f_minus(Mn(1))",
          "type": "inequality"
        },
        {
          "description": "In Nb(2)-K-OMS-2, f_minus(Nb) > f_minus(K)",
          "type": "inequality"
