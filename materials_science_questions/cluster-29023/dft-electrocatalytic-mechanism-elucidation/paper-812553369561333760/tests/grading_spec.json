{
  "scoring_tier": "result-level_compare",
  "scoring_justification": "Recomputing adsorption energies from raw DFT total energies is infeasible without re-running DFT; we compare agent's reported adsorption energies to paper gold values with tolerance. DOS check is structural.",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "gold adsorption energies for comparison",
      "source_provenance": "paper's reported values (Fig. 4 and text)",
      "generation_method": "extracted from paper's results section and cross-checked with solve.sh reference",
      "why_not_fabricated": "these are the exact values reported in the paper"
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "adsorption_energies.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "metric_recompute",
        "schema": {
          "type": "table",
          "required_columns": [
            "surface",
            "adsorbate",
            "adsorption_energy_eV"
          ],
          "units": {
            "adsorption_energy_eV": "eV"
          }
        },
        "description": "Computed adsorption energies for CO2, Na, and Na2CO3 on the three active ZnCo2O4 surfaces."
      },
      {
        "file": "dos_data.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "structural_audit",
        "schema": {
          "type": "table",
          "required_columns": [
            "surface",
            "energy_eV",
            "pdos_Co"
          ],
          "units": {
            "energy_eV": "eV",
            "pdos_Co": "arbitrary units"
          }
        },
        "description": "Projected density of states of surface Co atoms on the three surfaces, used to confirm unoccupied states at the Fermi level."
      }
    ],
    "notes": ""
  },
  "steps": [
    {
      "id": "adsorption_energies_check",
      "output_file": "adsorption_energies.csv",
      "kind": "numeric",
      "weight": 0.8,
      "reference_rows": [
        {
          "surface": "001",
          "adsorbate": "CO2",
          "adsorption_energy_eV": 1.37
        },
        {
          "surface": "111_Co",
          "adsorbate": "CO2",
          "adsorption_energy_eV": 1.32
        },
        {
          "surface": "111_CoZn",
          "adsorbate": "CO2",
          "adsorption_energy_eV": 2.19,
          "config": "a"
        },
        {
          "surface": "111_CoZn",
          "adsorbate": "CO2",
          "adsorption_energy_eV": 1.76,
          "config": "b"
        },
        {
          "surface": "001",
          "adsorbate": "Na",
          "adsorption_energy_eV": 1.32
        },
        {
          "surface": "111_Co",
          "adsorbate": "Na",
          "adsorption_energy_eV": 1.24
        },
        {
          "surface": "111_CoZn",
          "adsorbate": "Na",
          "adsorption_energy_eV": 1.23
        },
        {
          "surface": "001",
          "adsorbate": "Na2CO3",
          "adsorption_energy_eV": 2.66
        },
        {
          "surface": "111_Co",
          "adsorbate": "Na2CO3",
          "adsorption_energy_eV": 5.18
        },
        {
          "surface": "111_CoZn",
          "adsorbate": "Na2CO3",
          "adsorption_energy_eV": 5.09
        }
      ],
      "tolerance_map": {
        "CO2": 0.2,
        "Na": 0.2,
        "Na2CO3": 0.3
      },
      "scoring_rule": "each expected row must find at least one agent row with matching surface, adsorbate, and |energy - gold| <= tol; each gold row matched to distinct agent row; score = fraction of gold rows matched"
    },
    {
      "id": "dos_structure_check",
      "output_file": "dos_data.csv",
      "kind": "structural_audit",
      "weight": 0.2,
      "expected_surfaces": [
        "001",
        "111_Co",
        "111_CoZn"
      ],
      "scoring_rule": "for each surface, verify there exists at least one row with energy_eV > 0 and pdos_Co > 0; score = number of surfaces meeting condition / 3"
    }
  ]
}