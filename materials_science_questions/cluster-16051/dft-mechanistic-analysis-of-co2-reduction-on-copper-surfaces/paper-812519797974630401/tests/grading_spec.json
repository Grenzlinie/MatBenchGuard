{
  "scoring_tier": "result_level_compare",
  "scoring_justification": "Full recompute (T1) is infeasible because the verifier sandbox cannot re-run the DFT calculations. Scorers compare agent-reported CSV fields to paper-reported reference values with tolerances and trend checks (T0 acceptable fallback).",
  "pass_threshold": 0.6,
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Reference values and tolerances for all scored quantities from paper Tables 1, 2, 3 and text.",
      "source_provenance": "Paper Tables 1, 2, 3 and associated discussion.",
      "generation_method": "Extracted directly from the paper's reported numbers.",
      "why_not_fabricated": "Values are the paper's own published results; they are inline to keep the checker self-contained."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "o2_dissociation_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "Model",
            "Barrier_eV",
            "q_Pt",
            "q_Cu",
            "q_O2",
            "d_OO_angstrom"
          ],
          "units": {
            "Barrier_eV": "eV",
            "d_OO_angstrom": "angstrom",
            "q_Pt": "e",
            "q_Cu": "e",
            "q_O2": "e"
          },
          "description": "One row per surface model, values compared to paper-reported Table 1 with hidden tolerances and trend checks."
        },
        "description": "Scored artifact for O₂ dissociation barriers and TS properties."
      },
      {
        "file": "co_adsorption_results.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "Model",
            "Site",
            "DE_eV",
            "q_surface_atom",
            "q_CO",
            "nu_CO_cm1"
