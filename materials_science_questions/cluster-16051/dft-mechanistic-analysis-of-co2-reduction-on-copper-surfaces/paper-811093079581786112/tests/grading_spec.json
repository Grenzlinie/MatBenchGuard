{
  "scoring_tier": "result-level compare",
  "scoring_justification": "The headline quantities (barriers and adsorption energies) are computed by the agent's full DFT workflow; recomputing them from raw structure/log files in the checker is infeasible, so we compare the agent's reported JSON values to hidden paper gold within tolerances.",
  "pass_threshold": 0.6,
  "target_policies": {
    "results.json": "reference_match"
  },
  "output_contract": {
    "outputs": [
      {
        "file": "results.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "required": [
            "cu100",
            "cu111"
          ],
          "properties": {
            "cu100": {
              "type": "object",
              "required": [
                "adsorption_energy",
                "barriers"
              ],
              "properties": {
                "adsorption_energy": {
                  "type": "number",
                  "units": "eV"
                },
                "barriers": {
                  "type": "object",
                  "required": [
                    "H1",
                    "H2"
                  ],
                  "properties": {
                    "H1": {
                      "type": "number",
                      "units": "eV"
                    },
                    "H2": {
                      "type": "number",
                      "units": "eV"
                    },
                    "H3": {
                      "type": "number",
                      "units": "eV"
                    }
                  }
                }
              }
            },
            "cu111": {
              "type": "object",
              "required": [
                "adsorption_energy",
                "barriers"
              ],
              "properties": {
                "adsorption_energy": {
                  "type": "number",
                  "units": "eV"
                },
                "barriers": {
                  "type": "object",
                  "required": [
                    "H1",
                    "H2"
                  ],
                  "properties": {
                    "H1": {
                      "type": "number",
                      "units": "eV"
                    },
                    "H2": {
                      "type": "number",
                      "units": "eV"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "JSON file containing DFT-computed adsorption energies (eV) and activation barriers (eV) for H(1), H(2) (and optionally H(3)) on Cu(100) and Cu(111) step edges."
      }
    ],
    "notes": "All energies are in electronvolts (eV). H3 on Cu(100) is optional; if not computed, omit the field. The required keys are cu100.adsorption_energy, cu100.barriers.H1, cu100.barriers.H2, cu111.adsorption_energy, cu111.barriers.H1, cu111.barriers.H2."
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold DFT energies (adsorption energies and barriers) for Cu(100) and Cu(111)",
      "source_provenance": "Paper main text Figure 3 and Figure 4, with values stated in the accompanying discussion.",
      "generation_method": "Extracted numeric values directly from the paper text (eV units).",
      "why_not_fabricated": "These are the paper’s own DFT-computed energies; reusing them as hidden gold is faithful to the reproduction target."
    }
  ],
  "steps": [
    {
      "id": "ads_cu100",
      "output_file": "results.json",
      "weight": 0.05,
      "json_path": "cu100.adsorption_energy",
      "target_value": -1.03,
      "tolerance": 0.05
    },
    {
      "id": "ads_cu111",
      "output_file": "results.json",
      "weight": 0.05,
      "json_path": "cu111.adsorption_energy",
      "target_value": -0.92,
      "tolerance": 0.05
    },
    {
      "id": "barrier_H1_cu100",
      "output_file": "results.json",
      "weight": 0.2,
      "json_path": "cu100.barriers.H1",
      "target_value": 1.05,
      "tolerance": 0.1
    },
    {
      "id": "barrier_H2_cu100",
      "output_file": "results.json",
      "weight": 0.2,
      "json_path": "cu100.barriers.H2",
      "target_value": 4.28,
      "tolerance": 0.1
    },
    {
      "id": "barrier_H1_cu111",
      "output_file": "results.json",
      "weight": 0.15,
      "json_path": "cu111.barriers.H1",
      "target_value": 1.17,
      "tolerance": 0.1
    },
    {
      "id": "barrier_H2_cu111",
      "output_file": "results.json",
      "weight": 0.15,
      "json_path": "cu111.barriers.H2",
      "target_value": 1.98,
      "tolerance": 0.1
    },
    {
      "id": "barrier_H3_cu100",
      "output_file": "results.json",
      "weight": 0.05,
      "json_path": "cu100.barriers.H3",
      "target_value": 1.16,
      "tolerance": 0.1,
      "optional": true
    },
    {
      "id": "ordering",
      "output_file": "results.json",
      "weight": 0.15,
      "conditions": [
        {
          "left_path": "cu100.barriers.H1",
          "right_path": "cu111.barriers.H1",
          "op": "lt"
        },
        {
          "left_path": "cu100.barriers.H1",
          "right_path": "cu100.barriers.H2",
          "op": "lt"
        }
      ]
    }
  ]
}