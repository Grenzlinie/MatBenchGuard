{
  "scoring_tier": "result-level compare",
  "scoring_justification": "The headline quantities require a full DFT simulation whose energy curves are not available. The verifier cannot recompute the moduli/strain derivatives, so it compares the agent's reported values to the paper's published gold within tolerances. This is a legitimate T0 fallback.",
  "pass_threshold": 0.6,
  "target_policies": {
    "structural_params.json": "exact_match",
    "youngs_moduli.json": "reference_match",
    "bulk_moduli.json": "reference_match",
    "critical_strains.json": "reference_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold values for structural parameters, Young's moduli, bulk moduli, and critical strains for all structures and loading conditions.",
      "source_provenance": "Extracted verbatim from Tables 1–10 of the paper (doi:10.1007/s00894-020-04604-0). All values are traceable to specific rows and columns in those tables.",
      "generation_method": "Copied directly from the paper's tables during authoring.",
      "why_not_fabricated": "These are the paper's own reported numbers; they are not invented. The reference oracle writes exactly these numbers, and a correct DFT reproduction should be able to match them within the stated tolerances."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "structural_params.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "description": "Keys '2x2' and '3x3', each mapping structure name to {a, d_range, d_prime, h}. All lengths in Å."
        },
        "description": "Relaxed lattice constants, Sb–Sb bond length ranges, TM–Sb bond lengths, and dopant heights."
      },
      {
        "file": "youngs_moduli.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "description": "Keys '2x2' and '3x3', each mapping structure name to {longitudinal_Y, transverse_Y, long_reduction_percent, trans_reduction_percent}. Units N/m and %."
        },
        "description": "In-plane Young's moduli and reduction percentages."
      },
      {
        "file": "bulk_moduli.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "description": "Keys '2x2' and '3x3', each mapping structure name to {B, reduction_percent}. Units N/m and %."
        },
        "description": "Bulk moduli and reduction percentages."
      },
      {
        "file": "critical_strains.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "reference_match",
        "schema": {
          "type": "object",
          "description": "Keys '2x2' and '3x3', each with sub-keys 'uniaxial' and 'biaxial' mapping structure name to {eps_c1, eps_c2}."
        },
        "description": "First and second critical strains (dimensionless)."
      }
    ],
    "notes": "Only the eight transition metals (Sc, Ti, V, Cr, Fe, Ni, Cu, Zn) are required. Co and Mn dopants mentioned in the conclusion are not needed. No plastic deformation visualizations are required."
  },
