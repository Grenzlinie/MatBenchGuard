      "description": "Check lattice constants a, b, c for all four systems with 1% relative tolerance and verify a=b=30Å for isolated and a=b≈14.738Å for bundle."
    },
    {
      "id": "bulk_moduli",
      "output_file": "reproduced_properties.json",
      "kind": "numeric_multi_field",
      "weight": 0.15,
      "description": "Check bulk moduli (c for all, a/b for BSW_NT only) with 5% relative tolerance."
    },
    {
      "id": "electronic",
      "output_file": "reproduced_properties.json",
      "kind": "numeric_multi_field",
      "weight": 0.25,
      "description": "Check band gap values (5% rel tol), band gap type (indirect), transition strings (contains expected k-point fractions), effective mass and carrier velocity (10% rel tol), ef_minus_evbm and ecbm_minus_ef (10% rel tol). Metallic Si-vacancy must have null or very small gap."
    },
    {
      "id": "structural_other",
      "output_file": "reproduced_properties.json",
      "kind": "numeric_multi_field",
      "weight": 0.15,
      "description": "Check tubular diameter (2% rel tol), radial buckling (abs tol 0.005), symmetry (=2) and num_atoms (exact)."
    },
    {
      "id": "charges",
      "output_file": "reproduced_properties.json",
      "kind": "numeric_multi_field",
      "weight": 0.15,
      "description": "Check average s/p charges and total charge with 1% relative tolerance."
    },
    {
      "id": "trends",
      "output_file": "reproduced_properties.json",
      "kind": "structural_trend",
      "weight": 0.1,
      "description": "Verify ordering of c lattice constants (ISW > C-vac > Si-vac), tubular diameters (ISW > C-vac > Si-vac), radial buckling (ISW < BSW < C-vac < Si-vac), and band gap hierarchy (ISW > BSW > C-vac, Si-vac metallic)."
