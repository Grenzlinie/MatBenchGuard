      "source_provenance": "Paper Table 1, Table 3, Fig. 5 and associated text",
      "generation_method": "Direct extraction of reported numbers from the paper",
      "why_not_fabricated": "Values are the actual numerical results published in the paper; they are used as authoritative reference targets."
    }
  ],
  "output_contract": {
    "outputs": [
