{
  "scoring_tier": "structural",
  "scoring_justification": "Recompute from raw stress-strain curves is infeasible because the agent only submits extracted scalar properties, not the raw curves. Therefore we compare reported numbers to paper-reported hidden gold with relative tolerances and add structural trend checks (monotonicity).",
  "pass_threshold": 0.6,
  "target_policies": {
    "pristine_mechanical_properties.csv": "reference_match",
    "gb_mechanical_properties.csv": "reference_match",
    "strain_rate_results.csv": "reference_match",
    "temperature_results.csv": "reference_match"
  },
