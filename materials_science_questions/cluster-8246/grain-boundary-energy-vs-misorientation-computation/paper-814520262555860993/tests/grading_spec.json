      "description": "Check that the file exists, required keys present, stress-strain arrays are non-empty and of equal length, at least 20 points, strain starts near 0, and the maximum stress is not at the final point."
    },
    {
      "id": "step_clean_sigma_max",
      "output_file": "results.json",
      "weight": 0.25,
      "kind": "numeric",
      "target_policy": "reference_match",
      "description": "For clean GBs in Ni and Co under both RGS and OUL, recompute sigma_max as max of stress array; compare to paper-reported values with generous tolerances (RGS: 25% relative error full credit, 50% zero; OUL: 30% full credit, 60% zero)."
    },
    {
      "id": "step_ratio_clean",
      "output_file": "results.json",
      "weight": 0.25,
      "kind": "ratio",
      "target_policy": "reference_match",
      "description": "Compute RGS/OUL sigma_max ratio for Ni and Co clean GBs; score based on proximity to 2.0, with full credit if in [1.8, 2.2] and linear decay to zero at 1.5 and 2.5."
    },
    {
      "id": "step_ordering_oul",
      "output_file": "results.json",
      "weight": 0.2,
      "kind": "ordering",
      "target_policy": "structural_audit",
      "description": "Check that OUL sigma_max for Ni+Si and Ni+Te is greater than Ni clean OUL sigma_max (strengthening). Score linearly decaying if difference is negative."
    },
    {
      "id": "step_ordering_rgs",
      "output_file": "results.json",
      "weight": 0.2,
      "kind": "ordering",
      "target_policy": "structural_audit",
      "description": "Check that RGS sigma_max for Ni+Si is greater than Ni clean RGS (strengthening) and for Ni+Te is less than Ni clean RGS (weakening). Score linearly decaying if violated."
