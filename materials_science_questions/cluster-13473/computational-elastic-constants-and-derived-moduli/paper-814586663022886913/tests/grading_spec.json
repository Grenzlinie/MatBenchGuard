{
  "scoring_tier": "result_level_compare",
  "scoring_justification": "Raw stress-strain data not submitted; only final computed mechanical properties are available, making a full recompute infeasible. Result-level comparison against the paper's Table 1 values with tolerances is the appropriate fallback.",
  "pass_threshold": 0.7,
  "target_policies": {
    "mechanical_properties.json": "exact_match"
  },
  "hidden_assets": [
    {
      "path": "grading_spec_json.inline",
      "purpose": "Gold mechanical properties from paper Table 1",
      "source_provenance": "Paper J. Phys. Chem. C 119, 25499 (2015), Table 1. DOI: 10.1021/acs.jpcc.5b08657",
      "generation_method": "Copied directly from the published table; values are fixed simulation results.",
      "why_not_fabricated": "These are the reported results of the original study and serve as the reproduction target."
    }
  ],
  "output_contract": {
    "outputs": [
      {
        "file": "mechanical_properties.json",
        "format": "json",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "system",
              "strength_GPa",
              "youngs_modulus_GPa"
            ],
            "properties": {
              "system": {
                "type": "string"
              },
              "strength_GPa": {
                "type": "number"
              },
              "strain_at_failure_percent": {
                "type": "number",
                "nullable": true
              },
              "youngs_modulus_GPa": {
                "type": "number"
              }
            }
          }
        },
        "description": "JSON array containing the extracted mechanical properties for each of the seven simulated glass systems. The checker verifies that all required systems are present and compares the values to the hidden gold (paper Table 1) within per-property tolerances."
      }
    ],
    "notes": "Strain at failure for notched models may be omitted (null) as the paper does not report it. All other systems must provide all three properties."
  },
