{
  "scoring_tier": "structural",
  "scoring_justification": "T1 recompute infeasible because output is the final scalar; T2 consistency not applicable without richer raw artifact. We verify numeric values against expected gold computed from the same analytical formula (with tolerance) and test monotonic physical trends.",
  "pass_threshold": 0.6,
  "output_contract": {
    "outputs": [
      {
        "file": "step_01_youngs_modulus.csv",
        "format": "csv",
        "purpose": "scored",
        "target_policy": "exact_match",
        "schema": {
          "type": "table",
          "required_columns": [
            "N",
            "alpha",
            "T",
            "E"
          ],
          "units": {
            "E": "GPa"
          }
        },
        "description": "Computed Young's modulus for all specified (N, alpha, T) combinations."
      }
    ],
    "notes": "The quasiharmonic lattice parameter a(T) is provided as a bundled input table; the solving agent is not required to perform the quasiharmonic phonon calculation."
  },
  "steps": [
    {
      "id": "check_csv_schema",
      "output_file": "step_01_youngs_modulus.csv",
      "kind": "schema_validity",
      "weight": 0.05,
      "target_policy": "structural_audit"
    },
    {
      "id": "check_numeric_accuracy",
      "output_file": "step_01_youngs_modulus.csv",
      "kind": "numeric",
      "weight": 0.35,
      "target_policy": "threshold_or_better",
      "params": {
        "tolerance_rel": 0.05,
        "sample_points": [
          {
            "N": 1,
            "alpha": 0.0,
            "T": 0
          },
          {
            "N": 5,
            "alpha": 0.0,
            "T": 0
          },
          {
            "N": 10,
            "alpha": 0.0,
            "T": 0
          },
          {
            "N": 100,
            "alpha": 0.0,
            "T": 0
          },
          {
            "N": 1,
            "alpha": 0.1,
            "T": 0
          },
          {
            "N": 5,
            "alpha": 0.1,
            "T": 0
          },
          {
            "N": 10,
            "alpha": 1.0,
            "T": 0
          },
          {
            "N": 10,
            "alpha": 0.1,
            "T": 500
          },
          {
            "N": 10,
            "alpha": 0.1,
            "T": 1000
          },
          {
            "N": 20,
            "alpha": 0.1,
            "T": 0
          },
          {
            "N": 50,
            "alpha": 0.0,
            "T": 0
          },
          {
            "N": 100,
            "alpha": 0.1,
            "T": 0
          }
        ]
      }
    },
    {
      "id": "check_size_monotonic",
      "output_file": "step_01_youngs_modulus.csv",
      "kind": "monotonic",
      "weight": 0.35,
      "target_policy": "structural_audit",
      "params": {
        "direction": "increasing",
        "variable": "N",
        "conditions": [
          {
            "alpha": 0.1,
            "T": 0
          },
          {
            "alpha": 1.0,
            "T": 0
          },
          {
            "alpha": 0.1,
            "T": 500
          }
        ],
        "N_values": [
          1,
          2,
          3,
          5,
          10,
          20,
          50,
          100
        ]
      }
    },
    {
      "id": "check_temp_monotonic",
      "output_file": "step_01_youngs_modulus.csv",
      "kind": "monotonic",
      "weight": 0.25,
      "target_policy": "structural_audit",
      "params": {
        "direction": "decreasing",
        "variable": "T",
        "conditions": [
